  procedure Text_Button (Label : String; X, Line, Size : Real; Pressed : out Boolean; Right_Aligned : Boolean := False);

  procedure Button_Row (Labels : Phrase_List; Left, Line, Size : Real; Picked : out Natural; From_Right : Boolean := False);

  procedure Choice_Row (Label, Shown : String; Area : Rect; Index : in out Natural; Count : Positive; Enabled : Boolean := True);

  procedure Slider_Row (Label, Shown : String; Area : Rect; Value : in out Real; Low, High, Step : Real);

  procedure Action_Row (Label, Shown : String; Area : Rect; Pressed : out Boolean; Warn : Boolean := False);

  type Buy_Group      is (Pistols, Shotguns, Submachine_Guns, Rifles, Equipment);
  type Grenade_Counts is array (Grenade) of Natural;

  ---------------
  -- Arms_View --
  ---------------

  type Arms_View is record
      Title     : Bounded_Name;
      Picture   : Bounded_Name;
      Magazine  : Integer        := -1;
      Reserve   : Integer        := -1;
      Low       : Boolean        := False;
      Reloading : Boolean        := False;
      Burst     : Boolean        := False;
      Silenced  : Boolean        := False;
      Grenades  : Grenade_Counts := (others => 0);
      Helmet    : Boolean        := False;
      Zoom      : Natural        := 0;
      Field     : Real           := 0.0;
      Blind     : Real           := 0.0;
      Spread    : Real           := 0.0;
      Rearm     : Real           := 0.0;
      Money     : Integer        := -1;
      Buy_Zone  : Boolean        := False;
      Buy_Time  : Real           := 0.0;
    end record;

  Previewing : Boolean := False;
  Preview    : Arms_View;
  Spectating : Boolean := False;

  function Arms_Of    (Item : Player) return Arms_View;
  function Picture_Of (Arm : Weapon)  return String;
  function Group_Of   (Arm : Weapon)  return Buy_Group;

  type Arc_Mark  is record Source : Vector := Origin; Seen_At : Real := -9.0; end record;
  type Arc_Marks is array (1..6) of Arc_Mark;
  type Tally     is array (Player_Index) of Natural;

  --------------
  -- Feedback --
  --------------

  type Feedback is record
      Primed      : Boolean       := False;
      Scanned     : Natural       := 0;
      Viewer      : Player_Number := 0;
      Hit_At      : Real          := -9.0;
      Hit_Head    : Boolean       := False;
      Hit_Kill    : Boolean       := False;
      Arcs        : Arc_Marks;
      Next_Arc    : Positive      := 1;
      Hurt_At     : Real          := -9.0;
      Killed_At   : Real          := -9.0;
      Killed_Name : Bounded_Name;
      Killed_Head : Boolean       := False;
      Death_Tick  : Natural       := 0;
      Killer      : Natural       := 0;
      Killer_Seen : Vector        := Origin;
      Cause       : Cause_Kind    := No_Cause;
      Killer_Head : Boolean       := False;
      Headshots   : Tally         := (others => 0);
      Takedowns   : Tally         := (others => 0);
      News        : Bounded_Name;
      News_Tint   : Colour        := (0.925, 0.918, 0.894, 1.0);
      News_At     : Real          := -9.0;
      Step_At     : Real          := -9.0;
      Step_Up     : Boolean       := True;
      Gain        : Natural       := 0;
      Gain_At     : Real          := -9.0;
      Gain_Head   : Boolean       := False;
    end record;

