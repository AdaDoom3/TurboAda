  function Near_Each_Other  (Undead, Other : Zombie)                                                        return Boolean;
  function Has_Grenade      (Me : Player; Kind : Grenade)                                                   return Boolean;
  function Crowd_Point      (War : World; Wits : Mind; From : Natural := 1)                                 return Vector;
  function Smoke_Point      (Wits : Mind; Threat : Vector; K : Natural)                                     return Vector;
  function Utility_Used     (War : World; Wits : Mind)                                                      return Mind;
  function Dodged           (War : World; Wits : Mind)                                                      return Mind;
  function Decided          (War : World; Idea : Thought)                                                   return Thought;
  function Crosshair_Placed (War : World; Wits : Mind; Order : Command)                                     return Command;
  function Flicked          (Wits : Mind; Want_Yaw, Want_Pitch, Width : Real; First : Boolean)              return Mind;
  function Glided           (Wits : Mind; Order : Command)                                                  return Command;
  function Aimed            (War : World; Idea : Thought)                                                   return Thought;
  function Zoomed           (War : World; Idea : Thought)                                                   return Thought;
  function Has_Footing      (Wits : Mind; Direction : Vector)                                               return Boolean;
  function Footed           (War : World; Idea : Thought)                                                   return Thought;
  function Fired            (War : World; Idea : Thought)                                                   return Thought;
  function Prefired         (War : World; Idea : Thought)                                                   return Thought;
  function Throw_Worked     (War : World; Idea : Thought)                                                   return Thought;
  function Risen            (War : World; Wits : Mind)                                                      return Mind;
  function Pressed_On       (War : World; Wits : Mind)                                                      return Mind;
