  -------------

  Resting : constant Spring := (0.0, 0.0);

  Death_Poses : constant array (Death_Kind) of Part_Turns :=
    (Slump        =>
       (Origin,              (0.00, 0.50, 0.00),   (0.00, 0.40, 0.00),   (0.10, -0.20, 0.00),
        (0.00, -0.40, 0.00), (-0.10, -0.20, 0.00), (0.00, -0.40, 0.00),  (0.05, -1.20, 0.00),
        (0.00, 1.60, 0.00),  (-0.05, -1.20, 0.00), (0.00, 1.60, 0.00)),
     Fall_Back    =>
       (Origin,              (0.00, -0.20, 0.00),  (0.00, -0.30, 0.40),  (1.40, -0.30, 0.00),
        (0.00, -0.60, 0.00), (-1.20, -0.50, 0.00), (0.00, -0.30, 0.00),  (0.20, -0.20, 0.20),
        (0.00, 0.30, 0.00),  (-0.15, -0.60, -0.20), (0.00, 1.00, 0.00)),
     Fall_Forward =>
       (Origin,              (0.00, 0.15, 0.00),   (0.00, -0.60, -0.90), (0.40, -2.40, 0.00),
        (0.00, -1.20, 0.00), (-0.30, 0.40, 0.00),  (0.00, -0.20, 0.00),  (0.15, -0.30, 0.00),
        (0.00, 0.80, 0.00),  (-0.10, 0.05, 0.00),  (0.00, 0.10, 0.00)),
     Twist_Left   =>
       (Origin,              (0.20, 0.30, 0.60),   (0.00, 0.30, 0.70),   (0.50, -1.00, 0.00),
        (0.00, -0.90, 0.00), (-0.20, -1.40, 0.00), (0.00, -0.90, 0.00),  (0.00, -0.90, 0.30),
        (0.00, 1.20, 0.00),  (0.00, 0.10, 0.00),   (0.00, 0.40, 0.00)),
