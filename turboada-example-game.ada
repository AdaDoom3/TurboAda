        (0.00, -0.90, 0.00), (-0.50, -1.00, 0.00), (0.00, -0.90, 0.00),  (0.00, 0.10, 0.00),
        (0.00, 0.40, 0.00),  (0.00, -0.90, -0.30), (0.00, 1.20, 0.00)),
