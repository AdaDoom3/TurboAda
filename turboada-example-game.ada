  function Ring_Point    (Kind : Shell_Kind; Corner : Natural; Along : Real) return Vector;
  function Case_Mesh     (Kind : Shell_Kind; K : Natural := 0)               return Reals;
  function Lump_Vertices (Mesh : Lump_Corners; K : Positive := 1)            return Reals;

  function Big_Endian (Value : Long)                return Bytes;
  function PNG_Chunk  (Kind : String; Data : Bytes) return Bytes;

  --------------
  -- Settings --
  --------------

  type Volume_Table is array (Sound_Channel) of Real;
  type Window_Kind  is (Windowed, Borderless, Fullscreen);
  type Voice_Kind   is (Voice_Off, Push_To_Talk, Open_Microphone);
  type Palette_Kind is (Ember_And_Ice, Colour_Blind_Safe);
  type Reticle_Kind is (Classic, Tee, Ring, Dot_Only);
  type Team_Choice  is (Auto_Team, Red_Team, Blue_Team);

  -------------
  -- Reticle --
  -------------

  type Reticle is record
      Shape     : Reticle_Kind := Classic;
      Size      : Real         := 10.0;
      Gap       : Real         := 4.0;
      Thickness : Real         := 2.0;
      Tint      : Reticle_Tint := Green_Tint;
      Opacity   : Real         := 0.9;
      Outline   : Boolean      := True;
      Dot       : Boolean      := False;
      Dynamic   : Boolean      := True;
    end record;

  ------------------
  -- Address_List --
  ------------------

  type Address_List is record
      Count : Natural := 0;
      Items : Name_Array (1..12);
    end record;

  -------------
  -- Profile --
  -------------

  type Profile is record
      Player_Name      : Bounded_Name  := (7, "unnamed" & (8..Name_Length => ' '));
      Sensitivity      : Real          := 2.5;
      Invert_Mouse     : Boolean       := False;
      Field_Of_View    : Real          := 90.0;
      Gun_Field        : Real          := 68.0;
      Left_Handed      : Boolean       := False;
      Headphones       : Boolean       := False;
      Bindings         : Binding_Table := Default_Bindings;
      Volumes          : Volume_Table  := (Interface_Sound => 0.8, others => 1.0);
      Captions         : Boolean       := True;
      Menu_Tunes       : Boolean       := True;
      Fancy_Music      : Boolean       := True;
      Voice            : Voice_Kind    := Push_To_Talk;
      Wide             : Positive      := 1280;
      High             : Positive      := 720;
      Window_Mode      : Window_Kind   := Windowed;
      Vertical_Sync    : Boolean       := True;
      Frame_Cap        : Natural       := 0;
      Brightness       : Real          := 1.0;
      HUD_Scale        : Real          := 1.0;
      Palette          : Palette_Kind  := Ember_And_Ice;
      Hit_Markers      : Boolean       := True;
      Compass          : Boolean       := True;
      Blood            : Boolean       := True;
      Crosshair        : Reticle;
      Remember_Guns    : Boolean       := False;
      Guns             : Loadout;
      Controls_Seen    : Boolean       := False;
      Last_Mode        : Game_Mode     := Zombie_Survival;
      Last_Map         : Bounded_Name  := (8, "nocturne" & (9..Name_Length => ' '));
      Last_Bots        : Natural       := 0;
      Last_Difficulty  : Difficulty    := Hardened;
      Last_Score_Limit : Natural       := 0;
      Last_Time_Limit  : Natural       := 0;
      Last_Team        : Team_Choice   := Auto_Team;
      Last_Unlimited   : Boolean       := True;
      Host_Name        : Bounded_Name  := (19, "Turbo Engine server" & (20..Name_Length => ' '));
      Host_Port        : Natural       := 27_500;
      Host_Limit       : Natural       := 8;
      Recent           : Address_List;
      Favourites       : Address_List;
    end record;

  Sealed : Boolean := False;

  function  Settings_Folder                                                return String;
  function  Settings_Path                                                  return String;
  procedure Load_Settings   ;
  procedure Save_Settings   ;
  procedure Seal_Settings   (Fixed : Profile);
  function  Profile_Text    (Wishes : Profile; Line : Positive := 1)       return String;
  function  Input_Name      (Code : Input_Code)                            return String;
  function  Input_Of        (Text : String; Code : Input_Code := 1)        return Input_Code;
  function  Remembered      (List : Address_List; Address : String)        return Address_List;
  function  Forgotten       (List : Address_List; Address : String)        return Address_List;
  function  Keyed_Arm       (Text : String; From : Weapon := Weapon'First) return Weapon;
  function  Number_Or       (Text : String; Otherwise : Integer)           return Integer;
  function  Real_Or         (Text : String; Otherwise : Real)              return Real;

  use type Interfaces.C.Strings.chars_ptr, Sockets.Platform_Kind;

  type Setting_Key is
    (Name, Sensitivity, Invert_Mouse, Field_Of_View, Viewmodel_Fov, Left_Handed, Headphones,
     Captions, Menu_Music_Set, Fancy_Music_Set, Voice_Chat, Resolution, Window, Vsync, Frame_Cap, Brightness, Hud_Scale,
     Team_Colours, Hit_Markers, Compass, Blood, Crosshair_Style, Crosshair_Size, Crosshair_Gap,
     Crosshair_Thickness, Crosshair_Colour, Crosshair_Opacity, Crosshair_Outline, Crosshair_Dot,
     Crosshair_Dynamic, Remember_Guns, Primary, Pistol, Controls_Seen, Last_Mode, Last_Map,
     Last_Bots, Last_Difficulty, Last_Score_Limit, Last_Time_Limit, Last_Team, Last_Unlimited,
     Host_Name, Host_Port, Host_Limit, Recent, Favourite);

  package Setting_Words is new Words (Setting_Key);
  package Voice_Words   is new Words (Voice_Kind);
  package Window_Words  is new Words (Window_Kind);
  package Palette_Words is new Words (Palette_Kind);
  package Reticle_Words is new Words (Reticle_Kind);
  package Tint_Words    is new Words (Reticle_Tint);
  package Team_Words    is new Words (Team_Choice);

  Preferences : Profile;
  Factory     : constant Profile := (others => <>);

  function Bounded (Value, Low, High, Otherwise : Integer)                           return Integer;
  function Ranged  (Text : String; Otherwise, Low, High : Real; Scale : Real := 1.0) return Real;

  function Clipped      (Text : String; Most : Positive)      return String;
  function Channel_Word (Channel : Sound_Channel)             return String;
  function Yes_Or_No    (Flag : Boolean)                      return String;
  function Setting_Line (Wishes : Profile; Key : Setting_Key) return String;

  function Line_Taken (Wishes : Profile; Raw : String) return Profile;

  function Loaded is new Over_Lines (Profile, Line_Taken);

