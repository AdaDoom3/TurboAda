  type Shot_Times is array (1..4) of Real;

  type Kick_Spring is record Angle, Rate : Real := 0.0; end record;

  type Hand_State is record
      Shots          : Shot_Times := (others => -100.0);
      Last_Clock     : Real       := -100.0;
      Last_Fired     : Real       := 9.0;
      Last_Gun       : Weapon     := Knife;
      Drawn_At       : Real       := -100.0;
      Sway_Yaw       : Spring;
      Sway_Pitch     : Spring;
      Dip            : Spring;
      Was_Grounded   : Boolean    := True;
      Falling        : Real       := 0.0;
      Last_Duck      : Real       := 0.0;
      Crouch_Shift   : Real       := 0.0;
      Lean           : Real       := 0.0;
      Lowering       : Real       := 0.0;
      Kick_Up        : Kick_Spring;
      Kick_Side      : Kick_Spring;
      Reload_From    : Real       := -100.0;
      Reload_Done_At : Real       := -100.0;
      Was_Reloading  : Boolean    := False;
      Burst_From     : Real       := -100.0;
      Inspect_From   : Real       := -100.0;
      Inspect_Asked  : Boolean    := False;
      Fired          : Boolean    := False;
    end record;

  Shown_Hand : Hand_State;

  function Recoiled (K : Kick_Spring; Kind : Weapon; Most, Seconds : Real) return Kick_Spring;
  function Eased    (Value, Most : Real)                                   return Real;
  function Swing    (Since, Frequency : Real)                              return Real;
  function Handled  (Was           : Hand_State;
                     Through       : Camera;
                     Motion        : Mover;
                     Kind          : Weapon;
                     Reloading_Now : Boolean;
                     Lowers        : Boolean;
                     Since_Fire    : Real;
                     Clock         : Real;
                     Seconds       : Real;
                     Right         : Vector) return Hand_State;

  type View_Clip is (Draw, Fire, Fire_Loop, Fire_End, Reload, Reload_Empty, Reload_Start, Reload_Loop, Reload_End);

  type View_Clip_Set is array (View_Clip) of Animation_Access;

  function Length_Of (Clip : Animation_Access)                                          return Real;
  function Played    (Clip : Animation_Access; Time : Real; Looping : Boolean := False) return Pose;

  function View_Pose (Gun : Model; Idle, Shoot : Animation_Access; Clips : View_Clip_Set; Kind : Weapon; Since_Fire, Clock : Real)
     return Pose;
  function Grip_At (Gun : Model; J : Natural := 0; Best : Vector := (0.3, -0.1, -0.12)) return Vector;

  Curve_Texture     : GLuint                := 0;
  Band_Texture      : GLuint                := 0;
  Uploaded_Revision : Integer               := -1;
  Quads             : constant Reals_Access := new Reals (0..6 * Slug_Stride * 4096 - 1);
  Quad_Used         : Natural               := 0;
  World_Quads       : constant Reals_Access := new Reals (0..6 * Slug_Stride * 1024 - 1);
  World_Used        : Natural               := 0;
  Slug_Array        : GLuint                := 0;
  Slug_Buffer       : GLuint                := 0;
  Grade_Square      : Outline;

  procedure Put_Quad (Into : Reals_Access; Used : in out Natural; Shape : Outline; Corner, Across, Upward : Vector; Tint : Colour);

  procedure Send_Outline      (Table : Texel_Access; Id : in out GLuint);
  procedure Draw_Quads        (Data : Reals_Access; Used : in out Natural; Projection : Matrix);
  function  Screen_Projection return Matrix;

