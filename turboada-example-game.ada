  procedure Menu_List     (Labels : Phrase_List; Left, Top, Size : Real; Picked : out Natural);
  procedure Tab_Strip     (Labels : Phrase_List; Open : in out Positive; X, Y, Size : Real);
  procedure Toggle_Row    (Label : String; Area : Rect; Value : in out Boolean);
  procedure Text_Row      (Label : String; Area : Rect; Value : in out Bounded_Name; Limit : Positive := 24);
