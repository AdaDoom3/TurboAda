                            Arm       : String := "");

  type Doll_Fall is record
      Seen    : Boolean := False;
      Age     : Real    := 0.0;
      Clock   : Real    := 0.0;
      Offsets : Inertia;
    end record;

  Dolls_Falling : array (1..Maximum_Ragdolls) of Doll_Fall :=
    (others => (Seen => False, Age => 0.0, Clock => 0.0, Offsets => Calm));

  package Bone_Words is new Words (Bone_Name);

  function  Part_Of      (Item : Model; J : Joint_Index)                return Positive;
  function  Moving_Place (Last : Animator; Hips : Vector; Clock : Real) return Real;
  procedure Draw_Ragdoll (Current : World; Doll : Ragdoll; Item : Drawable; Ambient : Vector; Slot : Positive; Clock : Real);
  function  Lens         (Horizontal_At_Four_Thirds, Aspect : Real)     return Real;

  type Lamp is record
      Place : Vector := Origin;
      Reach : Real   := 0.0;
      Tint  : Vector := Origin;
      Aim   : Vector := Origin;
      Cone  : Real   := -2.0;
    end record;

  Lamps        : array (1..4) of Lamp;
  Lamp_Count   : Natural := 0;
  Flash_Lamps  : Natural := 0;
  Viewer_Flash : Boolean := False;
  Other_Flash  : Natural := 0;
  Other_Place  : Vector  := Origin;
  Other_Aim    : Vector  := (1.0, 0.0, 0.0);

  type Shell is record
      Kind     : Shell_Kind := No_Shell;
      Place    : Vector     := Origin;
      Velocity : Vector     := Origin;
      Turn     : Quaternion := Identity;
      Spin     : Vector     := Origin;
      Born     : Real       := 0.0;
      Resting  : Boolean    := False;
    end record;

  Shells      : array (1..32) of Shell;
  Next_Shell  : Positive := 1;
  Shell_Parts : constant array (Shell_Kind) of Part_Range :=
    (for K in Shell_Kind => (First => 72 * Shell_Kind'Pos (K), Count => 72, Look => <>));

  Seen       : Player;
  Seen_Valid : Boolean      := False;
  Seen_Level : Arena_Number := 1;
  Seen_Base  : Camera;
  Seen_View  : Camera;
  Last_Frame : Real         := -1.0;
  Seen_Roll  : Real         := 0.0;
  No_Motion  : Mover;

  function Rolled       (Angle : Real)  return Matrix;
  function Shown_Camera (View : Camera) return Camera;

  Frame_Log   : Text_IO.File_Type;
  Frame_State : Integer := -1;

  procedure Log_Frame   (View : Camera; Roll, Clock : Real);
  function  Muzzle_Of   (Item : Player)                                                                    return Vector;
  function  Blast_Age   (Current : World; E : Event)                                                       return Real;
  function  Flashing    (Current : World; Viewer : Player_Number; P : Player_Index; Within : Real := 0.06) return Boolean;
  procedure Light_Frame (Current : World; Viewer : Player_Number; Eye : Vector; Clock : Real);

  type Eye_State is record
      Punch    : Aim_Punch;
      Step     : Real    := 0.0;
      Feet     : Vector  := Origin;
      Grounded : Boolean := False;
      Across   : Real    := 0.0;
      Upward   : Real    := 0.0;
      Sprint   : Real    := 0.0;
    end record;

  type Bob_Amplitude is record Across, Upward : Real; end record;

  Camera_Clock : Real     := -100.0;
  Seen_Eye     : Eye_State;

  function Bob_Phase  (Stride, Speed : Real)                                                                      return Real;
  function Bob_Upward (Phase, Reach : Real)                                                                       return Real;
  function Toward     (Value, Target, Seconds, Lag : Real)                                                        return Real;
  function Followed (Was : Eye_State; Motion : Mover; Punch : Aim_Punch; Raised, Seconds : Real; Fresh : Boolean) return Eye_State;
  function Blast_Shake (Current : World; Eye : Vector; K : Natural := 0; Sum : Real := 0.0)                       return Real;
  procedure View_Through (Current : World; View : Camera; Viewer : Player_Number; Clock : Real; Shown : in out Camera);
  procedure Draw_Glow (Centre : Vector; Size, Seed : Real; Tint : Vector; Look_From : Camera; Opacity : Real := 1.0);
  function  Shell_Moved (S : Shell; Level : Map; Clock, Seconds : Real)                                           return Shell;
  procedure Throw_Shell (Kind : Shell_Kind; Place, Velocity : Vector; Born : Real);
  procedure Draw_Flashes (Current : World; Viewer : Player_Number; Look_From : Camera; Clock : Real);

  type Puff is record
      Centre   : Vector := Origin;
      Size     : Real   := 0.0;
      Opacity  : Real   := 0.0;
      Shade    : Real   := 1.0;
      Seed     : Real   := 0.0;
      Distance : Real   := 0.0;
    end record;

  type Puff_List is array (Positive range <>) of Puff;

  No_Puffs : constant Puff_List (1..0) := (others => <>);

  function Cloud_Puffs   (Current : World; Level : Map; Look_From : Camera; Clock : Real; C : Positive) return Puff_List;
  function Farther_First (Left, Right : Puff)                                                           return Boolean;

  function Sorted_Puffs is new Sorted (Puff, Puff_List, Farther_First);

  function  Fog_Of      (Current : World; Eye : Vector; C : Positive; Fog : Real := 0.0) return Real;
  procedure Draw_Smokes (Current : World; Look_From : Camera; Clock : Real);

  type Target is record
      Frame  : GLuint  := 0;
      Colour : GLuint  := 0;
      Depth  : GLuint  := 0;
      Wide   : Natural := 0;
      High   : Natural := 0;
    end record;

  type Depth_Kind is (No_Depth, With_Depth, Shadow_Depth);

  Scene_Target  : Target;
  Resolved      : Target;
  Occlusion     : Target;
  Graded        : Target;
  Moon_Static   : Target;
  Moon_Moving   : Target;
  Torch_Target  : Target;
  Flash_Target  : Target;
  Blooms        : array (1..5) of Target;
  Screen_Array  : aliased GLuint := 0;
  Finishing     : Boolean        := True;
  Scene_Pending : Boolean        := False;
  Direct        : Boolean        := True;
  Frame_Target  : GLuint         := 0;
  Frame_Clock   : Real           := 0.0;

  procedure Make_Target  (Into : in out Target; Wide, High : Natural; Format : Texel_Format; Depth : Depth_Kind := No_Depth);
  procedure Drop_Target  (Item : in out Target; Buffers : Boolean := False);
  procedure Make_Targets (Wide, High : Positive);

