  type Mote is record
      Shape    : Mote_Shape := Billow;
      Place    : Vector     := Origin;
      Velocity : Vector     := Origin;
      Born     : Real       := 0.0;
      At_Time  : Real       := 0.0;
      Life     : Real       := 0.0;
      Size     : Real       := 1.0;
      Grow     : Real       := 1.0;
      Fall     : Real       := 0.0;
      Drag     : Real       := 0.0;
      Stretch  : Real       := 0.0;
      Albedo   : Vector     := Origin;
      Baked    : Vector     := Origin;
      Glow     : Real       := 0.0;
      Opacity  : Real       := 0.0;
      Seed     : Real       := 0.0;
      Bleeds   : Boolean    := False;
      Resting  : Boolean    := False;
    end record;

  type Chunk is record
      Part     : Natural    := 0;
      Place    : Vector     := Origin;
      Velocity : Vector     := Origin;
      Turn     : Quaternion := Identity;
      Spin     : Vector     := Origin;
      Size     : Real       := 1.0;
      Born     : Real       := 0.0;
      At_Time  : Real       := 0.0;
      Dripped  : Real       := 0.0;
      Resting  : Boolean    := False;
      Marked   : Boolean    := False;
      Tint     : Colour     := (1.0, 1.0, 1.0, 1.0);
      Blood    : Vector     := Origin;
    end record;

  type Held_Prop is record
      Prop      : Natural    := 0;
      Place     : Vector     := Origin;
      Turn      : Quaternion := Identity;
      Catalogue : Natural    := 0;
      Extent    : Vector     := Origin;
    end record;

  type Tracer is record
      From : Vector  := Origin;
      To   : Vector  := Origin;
      Born : Real    := 0.0;
      Skip : Real    := 0.0;
      Live : Boolean := False;
    end record;

  type Mark_Look is record
      Kind    : Scar    := No_Scar;
      Variant : Natural := 0;
      Tint    : Vector  := Origin;
      Seed    : Real    := 0.0;
      Born    : Real    := 0.0;
      Grow    : Real    := 0.0;
      Leaving : Boolean := False;
      Light   : Real    := 0.0;
    end record;

  type Laid is record
      Kind    : Scar    := No_Scar;
      Variant : Natural := 0;
      Centre  : Vector  := Origin;
      Radius  : Real    := 0.0;
    end record;

  type Flat_Vector is array (Positive range <>) of Flat_Point;

  No_Points      : constant Flat_Vector (1..0) := (others => <>);

  No_Holding     : constant Held_Prop            := (others => <>);

  type Prop_Mark is record
      Look      : Mark_Look;
      Number    : Long                            := 0;
      Prop      : Natural                         := 0;
      Catalogue : Natural                         := 0;
      Pieces    : Flat_Polygon;
      Locals    : Vector_Table (1..Slot_Vertices) := (others => Origin);
    end record;

  type Wound is record Bleeds_To, Next : Real := 0.0; Zone : Hit_Zone := Whole; end record;

  Motes        : array (1..1024) of Mote;
  Chunks       : array (1..48) of Chunk;
  Tracers      : array (1..48) of Tracer;
  Prop_Marks   : array (1..Prop_Cap) of Prop_Mark;
  Recent_Marks : array (1..48) of Laid;
  Wounds       : array (Zombie_Index) of Wound;
  Chunk_Parts  : constant array (1..4) of Part_Range :=
    (for L in 1..4 => (First => 5 * 72 + 960 * (L - 1), Count => 960, Look => <>));
  Shots_Seen   : array (Player_Index) of Natural := (others => 0);
  Last_Shot    : array (Player_Index) of Real    := (others => -100.0);
  Next_Mote    : Positive                        := 1;
  Next_Chunk   : Positive                        := 1;
  Next_Tracer  : Positive                        := 1;
  Next_Recent  : Positive                        := 1;
  World_Number : Long                            := 0;
  Prop_Number  : Long                            := 0;
  Mark_Count   : Long                            := 0;
  Marked_To    : Natural                         := 0;
  Marked_Level : Natural                         := 0;
  Mote_Data    : constant Reals_Access           :=
    new Reals (0..Mote_Stride * (1024 + 48) - 1);
  Prop_Data    : constant Reals_Access           :=
    new Reals (0..Scar_Stride * Slot_Vertices * Prop_Cap - 1);
  Mote_Array   : GLuint                          := 0;
  Mote_Buffer  : GLuint                          := 0;
  Scar_Array   : GLuint                          := 0;
  Scar_Buffer  : GLuint                          := 0;
  Prop_Array   : GLuint                          := 0;
  Prop_Buffer  : GLuint                          := 0;

