  ------------

  No_Turns : constant Turn_Array := (others => Identity);

  Reverse_Of : constant array (Clip_Kind) of Clip_Kind :=
    (for Kind in Clip_Kind =>
       (case Kind is when Run_Back => Run, when Walk_Back => Walk, when Crouch_Back => Crouch_Walk, when others => Kind));

