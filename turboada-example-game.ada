  Match_Roles : constant array (Clip_Kind) of Match_Role :=
    (Idle                              => Standing_Role,
     Walk | Run | Run_Back | Walk_Back => Striding,
     Strafe_Left | Strafe_Right        => Striding,
     Stroll | Jog                      => Striding,
     Dash | Shamble                    => Hurrying,
     Crouch_Idle                       => Crouching_Role,
     Crouch_Walk | Crouch_Back         => Creeping,
     Jump | Land | Aim | Shoot | Die   => Unmatched,
     Attack | Hit                      => Unmatched);

