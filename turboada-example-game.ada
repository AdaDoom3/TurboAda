  -----------------
  -- Frame_Input --
  -----------------

  type Frame_Input is record
      Move          : Navigation := No_Move;
      Pointer_X     : Real       := -1.0;
      Pointer_Y     : Real       := -1.0;
      Pointer_Moved : Boolean    := False;
      Clicked       : Boolean    := False;
      Double        : Boolean    := False;
      Held          : Boolean    := False;
      Wheel         : Integer    := 0;
      Typed         : Bounded_Name;
      Code          : Input_Code := Unbound;
    end record;

