with Command_Line;
with Interfaces.C;
with Interfaces.C.Strings;
with OpenAL;
with OpenGL;
with Opus;
with SDL;
with Sockets;
with Stream_IO;
with System;
with Text_IO;
with Unchecked_Conversion;
with Unchecked_Deallocation;
with Zlib;

------------------
-- Turbo_Engine --
------------------

procedure Turbo_Engine is

  ------------------
  -- Descriptions --
  ------------------

  type Phrase      is access constant String;
  type Phrase_List is array (Positive range <>) of Phrase;

  Brand_Wordmark : constant String := "TURBO ENGINE";

  Crouch_Help          : constant String := "Crouch; crouch as you jump to climb higher";
  Sprint_Help          : constant String := "Sprint; the gun comes up a moment after";
  Fire_Help            : constant String := "Fire; hold a grenade's pin, let go to throw";
  Night_Alternate_Help : constant String := "Lob a grenade underhand, or the knife's stab";
  Alternate_Help       : constant String := "The scope, or the knife's stab; lob a grenade";
  Use_Help             : constant String := "Use, carry and throw things";
  Torch_Help           : constant String := "Torch: by night, on, off";
  Inspect_Help         : constant String := "Look the gun over";
  Night_Weapons_Help   : constant String := "Gun, pistol, knife, grenades";
  Weapons_Help         : constant String := "Primary, pistol, knife, grenades, charge";
  Pause_Help           : constant String := "Pause, restart and menu";
  Continue_Prompt      : constant String := "PRESS ANY KEY TO CONTINUE";

  Searching_Network    : constant String := "Looking for games on the local network...";
  No_Network_Games     : constant String :=
    "No games found on the local network. Refresh, or add a server by its address.";
  No_Servers_Played    : constant String := "No servers played yet.";
  No_Favourites        : constant String := "No favourites yet. Add one by its address.";
  No_Replays           : constant String :=
    "No replays yet. Every match you play here is recorded.";
  Match_Plays_On       : constant String := "Menu  --  the match plays on";
  Tab_Reset_Notice     : constant String := "This tab is back to its defaults";

  Not_In_Buy_Zone  : constant String := "You are not in a buy zone";
  Buy_Time_Over    : constant String := "The buy time is over";
  Spawn_Kit_Notice : constant String := "Every life starts with grenades, kevlar and a helmet";
  Night_Keeps_Guns : constant String := "the night shift keeps its guns: nothing to drop";

  Fell_To_Death      : constant String := "You fell to your death";
  Burned_In_Metal    : constant String := "Burned in the molten metal";
  Caught_In_Blast    : constant String := "Caught in the blast";
  Killed_By_Zombie   : constant String := "Killed by a zombie";
  Revive_Hint        : constant String := "  --  a teammate can revive you";
  Return_After_Wave  : constant String := "You return when the wave is cleared";
  Lost_The_Lead_Call : constant String := "YOU HAVE LOST THE LEAD";
  Took_The_Lead_Call : constant String := "YOU HAVE TAKEN THE LEAD";
  Team_Wiped_Out     : constant String := "The team was wiped out";
  Clearance_Label    : constant Phrase := new String'("Clearance");
  Precision_Label    : constant Phrase := new String'("Precision");
  Full_Bonus_Line    : constant String := "FULL BONUS";

  No_Closets_Warning  : constant String :=
    "Night Shift: the level has no info_wave_spawn closets; the dead come from";
  No_Closets_Tail     : constant String := " navigation nodes out of sight";
  Event_Ring_Full     : constant String := "entities: the event ring overflowed";
  Contact_Buffer_Full : constant String := "entities: the contact buffer is full";

  ----------------
  -- Foundation --
  ----------------

  type Real         is new Float;
  type Long         is range -2**63..2**63 - 1;

  type Byte         is mod 2**8;
  type Axis         is (X, Y, Z);
  type Vector       is array (Axis) of Real;
  type Bytes        is array (Natural range <>) of Byte;

  type Reals        is array (Natural range <>) of Real;
  type Matrix       is array (1..4, 1..4) of Real;

  type Quaternion is record Vector_Part : Vector; Scalar_Part : Real; end record;

  type Transform is record Rotation : Quaternion; Translation : Vector; end record;

  type Spring is record Value : Real := 0.0; Rate : Real := 0.0; end record;

  Origin             : constant Vector         := (0.0, 0.0, 0.0);

  function Square_Root (Value : Real) return Real
    with Import, Convention => C, External_Name => "sqrtf";
  function Sine (Value : Real) return Real
    with Import, Convention => C, External_Name => "sinf";
  function Cosine (Value : Real) return Real
    with Import, Convention => C, External_Name => "cosf";
  function Arc_Tangent (Rise, Run : Real) return Real
    with Import, Convention => C, External_Name => "atan2f";
  function Arc_Cosine (Value : Real) return Real
    with Import, Convention => C, External_Name => "acosf";
  function Floor (Value : Real) return Real
    with Import, Convention => C, External_Name => "floorf";
  function Power (Base, Exponent : Real) return Real
    with Import, Convention => C, External_Name => "powf";

  type Knob is (Gravity, Friction, Edge_Friction, Stop_Speed, Accelerate, Air_Accelerate, Air_Wish,
                 Jump_Impulse, Jump_Penalty, Penalty_Scale, Bunny_Limit, Bunny_Keep, Frame_Rate,
                 Walk_Scale, Crouch_Scale, Duck_Speed, Duck_Penalty, Duck_Floor, Duck_Recovery,
                 Duck_Lift, Step_Height, Slope_Limit, Non_Jump_Velocity, Safe_Fall, Fatal_Fall,
                 Ladder_Speed, Ladder_Leap, Flinch_Light, Flinch_Heavy, Flinch_Recovery, Steady,
                 Speed_Cap, Respawn_Delay, Carry_Limit, Flag_Return, Frag_Limit_Duel,
                 Frag_Limit_Deathmatch, Capture_Limit, Wave_Limit, Time_Limit_Duel,
                 Time_Limit_Deathmatch, Time_Limit_Ctf, Time_Limit_Zombie, Equip_Window,
                 Spawn_Armour, Spawn_Frags, Spawn_Flashes, Spawn_Smokes, Zombie_Speed,
                 Zombie_Health, Zombie_Damage, Ragdoll_Rest, Ragdoll_Motor, Ragdoll_Motor_Fade,
                 Chain_Window, Chain_Double, Chain_Multi, Chain_Mega, Chain_Ultra, Chain_Monster,
                 Chain_Ludicrous, Chain_Holy_Shit, Spree_Killing, Spree_Rampage, Spree_Dominating,
                 Spree_Unstoppable, Spree_Godlike, Spree_Wicked_Sick, Pace, Arsenal, Survival_Pace,
                 Survival_Arsenal, Survival_Frags, Pickup_Respawn, Wave_Interval, Wave_Breather,
                 Horde_Alive, Spawn_Gap, Spawn_Clearance, Wave_Toughening, Wave_Walkers_1,
                 Wave_Walkers_2, Wave_Walkers_3, Wave_Walkers_4, Wave_Walkers_5, Wave_Walkers_6,
                 Wave_Walkers_7, Wave_Walkers_8, Wave_Walkers_9, Wave_Walkers_10, Wave_Runners_1,
                 Wave_Runners_2, Wave_Runners_3, Wave_Runners_4, Wave_Runners_5, Wave_Runners_6,
                 Wave_Runners_7, Wave_Runners_8, Wave_Runners_9, Wave_Runners_10, Wave_Brutes_1,
                 Wave_Brutes_2, Wave_Brutes_3, Wave_Brutes_4, Wave_Brutes_5, Wave_Brutes_6,
                 Wave_Brutes_7, Wave_Brutes_8, Wave_Brutes_9, Wave_Brutes_10, Wave_Chargers_1,
                 Wave_Chargers_2, Wave_Chargers_3, Wave_Chargers_4, Wave_Chargers_5,
                 Wave_Chargers_6, Wave_Chargers_7, Wave_Chargers_8, Wave_Chargers_9,
                 Wave_Chargers_10, Score_Walker, Score_Runner, Score_Brute, Score_Charger,
                 Score_Head, Score_Gib, Multiplier_Step, Multiplier_Cap, Multiplier_Decay,
                 Multiplier_Patience, Bonus_Every_Kill, Bonus_Every_Head, Bonus_Untouched,
                 Bonus_Per_Second, Bonus_Accuracy, Grade_Floor_S, Grade_Floor_A, Grade_Floor_B,
                 Grade_Floor_C, Swing_Windup, Swing_Reach, Lunge_Range, Lunge_Speed, Lunge_Time,
                 Charge_Range, Charge_Time, Stagger_Time, Lurch_Speed, Lurch_Time, Shamble_Depth,
                 Claw_Barricade, Crush_Floor, Crush_Cap, Crush_Guard, Charger_Fuse,
                 Charger_Blast_Cap, Unlimited_Ammo, Carry_Props);

  type Knob_Table is array (Knob) of Real;

  type Best is record
      Score : Real    := Real'First;
      Found : Integer := 0;
      Point : Vector  := Origin;
    end record;

  ------------
  -- Glyphs --
  ------------

  type Texel        is array (1..4) of Real;

  type Curve_Indices is array (Positive range <>) of Positive;
  type Point_Flags is array (Positive range <>) of Natural;

  ------------
  -- Models --
  ------------

  Maximum_Joints : constant := 40;

  type Joint_Index  is range 0..Maximum_Joints - 1;

  type Turn_Array   is array (Joint_Index) of Quaternion;

  type Clip_Kind is
    (Idle,
     Walk,
     Run,
     Run_Back,
     Walk_Back,
     Strafe_Left,
     Strafe_Right,
     Crouch_Idle,
     Crouch_Walk,
     Crouch_Back,
     Jump,
     Land,
     Aim,
     Shoot,
     Die,
     Attack,
     Hit,
     Stroll,
     Jog,
     Dash,
     Shamble);

  ----------------
  -- Kinematics --
  ----------------

  type Joint_Weights is array (Joint_Index) of Real;

  --------------------
  -- Match_Features --
  --------------------

  type Match_Features is array (1..20) of Real;

  type Doll_Part   is range 1..11;

  -------------------
  -- Weapon_Stance --
  -------------------

  type Weapon_Stance is (Shouldered, Held_Out, Bladed, Thrown);

  type Follow_Up is (Ready, Pump_Action, Bolt_Action, Reload_Action);

  type Gaze_Link is (Spine_Link, Chest_Link, Neck_Link, Head_Link, Eye_Link);

  type Recoil_Link is (Hand_Link, Forearm_Link, Upper_Arm_Link, Shoulder_Link, Torso_Link);

  type Flinch_Link is (Hips_Flinch, Spine_Flinch, Chest_Flinch, Neck_Flinch, Head_Flinch);

  ----------------
  -- Death_Kind --
  ----------------

  type Death_Kind is (Slump, Fall_Back, Fall_Forward, Twist_Left, Twist_Right, Buckle);

  type Part_Turns  is array (Doll_Part) of Vector;

  No_Part_Turns : constant Part_Turns := (others => Origin);

  type Live_Pose is record
      Turns : Part_Turns := No_Part_Turns;
      Shift : Vector     := Origin;
    end record;

  type Joint_Turn is record
      Joint : Integer;
      Turn  : Quaternion;
    end record;

  type Joint_Turns is array (Positive range <>) of Joint_Turn;

  type Turn_Range is record
      Low  : Vector;
      High : Vector;
    end record;

  type Limited_Bone is (Spine, Chest, Neck, Head, Shoulder, Upper_Arm, Lower_Arm, Hand, Upper_Leg, Lower_Leg, Foot, Toes);

  type Match_Role is (Unmatched, Standing_Role, Striding, Hurrying, Crouching_Role, Creeping);

  type Feature_Group is record
      First  : Positive;
      Last   : Positive;
      Least  : Real;
      Living : Real;
      Dead   : Real;
    end record;

  type Key_Point is record
      At_Time : Real;
      Point   : Vector;
    end record;

  type Key_Points is array (Positive range <>) of Key_Point;

  type Recoil_Row is record
      Pull    : Real;
      Pace    : Real;
      Damping : Real;
    end record;

  type Gaze_Row is record
      Halflife : Real;
      Yaw      : Real;
      Lift     : Real;
    end record;

  type Layer is (Cycle_Layer, Carry_Layer, Ladder_Layer, Flight_Layer, Landing_Layer, Strike_Layer, Hit_Layer, Death_Layer);

  type Mask_Kind is (Whole_Body, Carrying_Arms, Lower_Half, Upper_Half);

  type Layer_Row is record
      Mask : Mask_Kind;
      Clip : Clip_Kind;
    end record;

  type Layer_Table is array (Layer) of Layer_Row;

  ----------
  -- Maps --
  ----------

  type Hull_Number is range 0..3;
  type Hull_Box    is array (Hull_Number) of Vector;

  type Vector_Table     is array (Natural range <>) of Vector;

  type Lump_Name is
    (Entity_Lump,
     Plane_Lump,
     Texture_Lump,
     Vertex_Lump,
     Visibility_Lump,
     Node_Lump,
     Info_Lump,
     Face_Lump,
     Lighting_Lump,
     Clip_Lump,
     Leaf_Lump,
     Mark_Lump,
     Edge_Lump,
     Surface_Lump,
     Model_Lump);

  type Bsp_Format is (BSP29, BSP2, BSP2_RMQ);

  type Bsp_Layout is record
      Node_Size  : Natural;
      Leaf_Size  : Natural;
      Leaf_Marks : Natural;
      Node_Faces : Natural;
    end record;

  type Room_Role is (Floor, Ceiling, Wall, Wall_Alt, Metal, Hazard);
  type Room_Quad is array (1..4) of Natural;

  type Room_Face is record Corners : Room_Quad; Plane : Natural; Role : Room_Role; end record;

  type Room_Model is record
      Low    : Vector;
      High   : Vector;
      Leaves : Integer;
      Faces  : Integer;
    end record;

  -------------
  -- Physics --
  -------------

  Maximum_Bodies      : constant := 320;

  type Shape_Kind is (Box, Sphere, Cylinder, Capsule, Hull);

  type Material_Kind is (Wood, Metal, Sheet_Metal, Glass, Plastic, Concrete, Cardboard, Rubber, Ceramic, Cloth, Paper, Flesh);

  type Motion_Kind is (Unused, Fixed, Animated, Simulated);

  type Material_Row is record
      Density  : Real;
      Friction : Real;
      Bounce   : Real;
      Rolling  : Real;
    end record;

  type Joint_Kind is (Unused, Ball, Hinge, Rope);

  type Contact_Side       is (First_Side, Second_Side);

  type Axis_Frame           is array (Axis) of Vector;

  type Natural_List    is array (Positive range <>) of Natural;

  ----------------
  -- Face_Plane --
  ----------------

  type Face_Plane is record
      Normal : Vector  := Origin;
      Offset : Real    := 0.0;
      First  : Natural := 0;
      Count  : Natural := 0;
    end record;

  type Face_List        is array (Positive range <>) of Face_Plane;

  type Matrix_3    is array (Axis, Axis) of Real;

  --------------
  -- Movement --
  --------------

  type Plane_List is array (1..8) of Vector;

  ------------
  -- Recoil --
  ------------

  type Kick_Reference is
    (Unkicked, CoD4_M1911, CoD4_M9, CoD4_Deagle, CoD4_W1200, CoD4_M4, CoD4_M40A3, CoD4_R700, WaW_MP40, WaW_STG44);

  type View_Kick is record
      Up     : Real;
      Down   : Real;
      Left   : Real;
      Right  : Real;
      Centre : Real;
    end record;

  type Gun_Kick is record
      Pitch_Low  : Real;
      Pitch_High : Real;
      Yaw_Low    : Real;
      Yaw_High   : Real;
      Accel      : Real;
      Fastest    : Real;
      Decay      : Real;
      Static     : Real;
    end record;

  ----------------
  -- Navigation --
  ----------------

  type Link_Kind is (Walk, Jump, Pad);

  ----------
  -- Game --
  ----------

  type Game_Mode is (Duel, Deathmatch, Capture_The_Flag, Zombie_Survival);

  type Mode_Word is (Duel_Word, Deathmatch_Word, Dm_Word, Ctf_Word, Zombie_Word, Zombies_Word, Survival_Word, Nightshift_Word);

  Maximum_Players     : constant := 12;

  Maximum_Items   : constant := 64;
  Maximum_Zombies : constant := 256;

  Maximum_Ragdolls    : constant := 12;

  --------------
  -- Armament --
  --------------

  type Armament is
    (Knife,         USP,           Glock,         Deagle,        MP5,           M3,
     AK47,          M4A1,          Scout,         AWP,           HE_Grenade,    Flashbang,
     Smoke_Grenade, C4,            Luger,         MP40,          Gatling,       Kar98k,
     Stick_Grenade);

  subtype Weapon   is Armament range Knife..C4;
  subtype Sidearm  is Weapon range USP..Deagle;
  subtype Long_Arm is Weapon range MP5..AWP;
  subtype Grenade  is Weapon range HE_Grenade..Smoke_Grenade;

  type Calibre is
    (No_Rounds,    ACP_45,       Parabellum,   AE_50,        Buckshot,     NATO_762,
     NATO_556,     Magnum_338,   Frag_Charge,  Flash_Charge, Smoke_Charge, Demolition);

  type Hit_Zone    is (Whole, Head, Chest, Stomach, Arm, Leg);
  type Item_Kind   is (Health, Mega_Health, Green_Armour, Red_Armour, Supply_Cache, Heavy_Gun);

  type Zombie_Kind is (Walker, Runner, Brute, Charger);

  type Ending      is
    (Playing, Frags_Reached, Captures_Reached, Time_Up, Waves_Reached, Team_Wiped);

  type Cue_Kind is
    (Cue_Entry, Cue_Wave_1, Cue_Halfway, Cue_Multiplier_Broken, Cue_Wave_10, Cue_Zero);

  ----------------
  -- Event_Kind --
  ----------------

  type Event_Kind is
    (Silence,            Gunshot,            Knife_Swing,        Grenade_Throw,
     Grenade_Bounce,     Explosion,          Flash_Burst,        Smoke_Burst,
     Jump,               Pickup,             Pain,               Death,
     Respawn,            Flag_Taken,         Flag_Captured,      Flag_Returned,
     Flag_Dropped,       Zombie_Growl,       Zombie_Scream,      Zombie_Hit,
     Zombie_Death,       Wave_Start,         Wave_Cleared,       Revive,
     Impact_Soft,        Impact_Hard,        Bullet_Hit,         Break,
     Scrape,             Kill,               Land,               Ladder,
     Zombie_Spawn,       Announce,           Voice_Cue,          PA_Wave,
     Headshot_Reaction,  Gib,                Zombie_Swing,       Zombie_Lunge,
     Multiplier_Change,  Run_Over,           Zombie_Fuse);

  ----------------
  -- Cause_Kind --
  ----------------

  type Cause_Kind is
    (No_Cause,       Knife_Cut,      USP_Shot,       Glock_Shot,     Deagle_Shot,
     MP5_Shot,       M3_Shot,        AK47_Shot,      M4A1_Shot,      Scout_Shot,
     AWP_Shot,       Grenade_Blast,  Blast,          Fall,           Claw,
     Crush,          Scald);

  ------------------
  -- Announcement --
  ------------------

  type Announcement is
    (Silent,              Lost_The_Lead,       Tied_For_The_Lead,   Taken_The_Lead,
     Play,                Headshot,            Bottom_Feeder,       Humiliating_Defeat,
     First_Blood,         Double_Kill,         Killing_Spree,       Multi_Kill,
     Rampage,             Mega_Kill,           Dominating,          Ultra_Kill,
     Unstoppable,         Monster_Kill,        Godlike,             Ludicrous_Kill,
     Wicked_Sick,         Holy_Shit);

  type Calibre_Row is record
      Most   : Natural;
      Power  : Natural;
      Pierce : Real;
    end record;

  type Accuracy_Kind is (Steady, Cubic, Square, Recovering);

  type Aim_Row is record
      Kind                   : Accuracy_Kind;
      Initial, Base, Divisor : Real;
      Least, Most            : Real;
      Window, Rate           : Real;
    end record;

  type Spread_Row is record
      Air, Air_Gain               : Real;
      Fast_Above, Fast, Fast_Gain : Real;
      Slow_Above, Slow, Slow_Gain : Real;
      Duck, Duck_Gain             : Real;
      Still, Still_Gain           : Real;
      Inverse                     : Boolean;
      Unscoped                    : Real;
    end record;

  type Cone_Kind is
    (No_Cone,          Colt_Cone,        Luger_Cone,       Python_Cone,      MP40_Cone,
     Buckshot_Cone,    StG_Cone,         Carbine_Cone,     Kar98k_Cone,      Springfield_Cone,
     Gatling_Cone);

  type Kick_Row is record
      Up, Side, Up_Step, Side_Step, Up_Most, Side_Most : Real;
      Turn_Odds                                        : Natural;
    end record;

  type Kick_Set is record
      Air_First                : Boolean;
      Air, Moving, Duck, Still : Kick_Row;
      Extra                    : Real;
      Shells                   : Boolean;
    end record;

  type Shell_Kind is (No_Shell, Pistol_Brass, Rifle_Brass, Magnum_Brass, Shotgun_Hull);

  type Gun_View is record
      Scale                              : Real;
      Shell                              : Shell_Kind;
      Cycle, Back, Settle, Flash, Length : Real;
      Offset, Port                       : Vector;
    end record;

  type Arm_Text  is access constant String;

  -------------
  -- Arm_Row --
  -------------

  type Arm_Row is record
      Slot                                      : Positive;
      Rounds                                    : Calibre;
      Magazine, Price                           : Natural;
      Damage                                    : Real;
      Pellets                                   : Positive;
      Range_Kept                                : Real;
      Penetration                               : Natural;
      Reach, Armour_Ratio                       : Real;
      Cycle, Reload, Reload_First, Reload_Empty : Real;
      Deploy, Speed, Scoped_Speed               : Real;
      Zoom_One, Zoom_Two                        : Real;
      Semi, Heavy                               : Boolean;
      Spin_Up                                   : Real;
      Aim                                       : Aim_Row;
      Kick                                      : Kick_Set;
      Modern                                    : Kick_Reference;
      Spread                                    : Cone_Kind;
      Hold                                      : Weapon_Stance;
      After_Shot                                : Follow_Up;
      Support                                   : Vector;
      Hand_Kick                                 : Real;
      View                                      : Gun_View;
      Names                                     : Arm_Text;
    end record;

  type Variant_Row is record
      Toggle     : Real;
      Damage     : Real;
      Range_Kept : Real;
      Cycle      : Real;
      Quiet      : Boolean;
      Spread     : Spread_Row;
    end record;

  type Grenade_Row is record
      Fuse, Gravity, Bounce, Damage, Radius, Lasting : Real;
    end record;

  --------------------
  -- Surface_Family --
  --------------------

  type Surface_Family is
    (Liquid,      Pane,        Electronics, Grating,     Ducting,     Sheet,       Parquet,
     Timber,      Girder,      Fabric,      Marble,      Tiling,      Plaster,     Soil,
     Masonry,     Bare);

  type Loadout is record
      Primary : Long_Arm := M4A1;
      Pistol  : Sidearm  := USP;
    end record;

  type Shot_Kind is (No_Shot, Round, Burst_Round, Cut, Thrust, Throw);

  type Spot_Kind is (Deathmatch_Spawn, Red_Spawn, Blue_Spawn, Cooperative_Spawn, Zombie_Gate, Supply, Light_Source, Wave_Closet);

  -----------
  -- Breed --
  -----------

  type Breed is record
      Speed, Health, Damage, Cooldown, Reach : Real;
      Stature, Gait, Breadth                 : Real;
      Hull                                   : Hull_Number;
      Score, First_Wave                      : Knob;
    end record;

  type Run_Grade   is (Grade_D, Grade_C, Grade_B, Grade_A, Grade_S);

  type Level_Entity_Class is
    (Info_Player_Deathmatch, Info_Player_Team1,      Info_Player_Team2,
     Info_Player_Coop,       Info_Zombie_Spawn,      Info_Supply,
     Info_Wave_Spawn,        Item_Health,            Item_Health_Mega,
     Item_Armor_Green,       Item_Armor_Red,         Weapon_Nailgun,
     Item_Ammo,              Item_Flag_Team1,        Item_Flag_Team2,
     Trigger_Push,           Func_Ladder,            Prop_Ragdoll,
     Prop_Detail);

  subtype Spot_Class   is Level_Entity_Class range Info_Player_Deathmatch..Info_Wave_Spawn;

  subtype Item_Class   is Level_Entity_Class range Item_Health..Item_Ammo;

  type Melee_Row is record
      Reach, Damage, Hit_Cycle, Miss_Cycle, Behind : Real;
    end record;

  type Pierce_Row is record
      Power, Damage : Real;
    end record;

  type Target_Kind    is (Missed, Wall, Person, Shambler, Prop);

  type Bone_Plan is record
      From, To     : Vector;
      Radius, Mass : Real;
      Parent       : Natural;
      Kind         : Joint_Kind;
      Low, High    : Real;
    end record;

  type Rung is record
      Line  : Announcement;
      Kills : Knob;
    end record;

  type Rungs is array (Positive range <>) of Rung;

  type Limit_Row is record
      Score, Clock : Knob;
      Reached      : Ending;
    end record;

  ----------
  -- Bots --
  ----------

  type Persona is (Regular, Explorer, Fuzzer, Camper, Rusher, Fragger, Lurker, Anchor, Awper, Controller, Human, Sarge);
  type Bot_Level    is (Recruit, Regular, Hardened, Veteran, Yardstick);
  subtype Difficulty is Bot_Level range Recruit..Veteran;
  type Role         is (Entering, Lurking, Anchoring, Holding, Controlling);

  type Throw_Step   is (Idle, Pulling_Pin, Holding_Pin, Letting_Go);

  type Fuzz_Key is (Key_Forward, Key_Back, Key_Left, Key_Right, Key_Jump, Key_Crouch, Key_Walk, Key_Fire, Key_Use);
  type Trait        is (Reaction, Reaction_Spread, Flick_Start, Flick_Slope, Overshoot,
                        Aim_Error, Aim_Floor, Tracking, Anticipation, Tremor, Spray,
                        Discipline, Head_Height, Counter_Strafe, Recall, Hearing, Patience,
                        Lapse, Whiff, Panic, Prefire, Utility, Refill, Grace, Stagger, Ease);

  type Weapon_Class is (Blade, Handgun, Automatic, Scatter, Rifle, Scoped, Thrown);

  type Class_Pair is array (1..2) of Weapon_Class;

  type Arm_Handling is record
      Best    : Real;
      Longest : Real;
      Closest : Real;
      Near    : Real;
      Far     : Real;
      Burst   : Natural;
      Pause   : Real;
      Width   : Real;
      Steady  : Boolean;
    end record;

  -------------
  -- Network --
  -------------

  type Number_List is array (Positive range <>) of Long;

  ------------------
  -- Entity_Class --
  ------------------

  type Entity_Class is
    (Player_Entity, Zombie_Entity, Body_Entity, Item_Entity, Flag_Entity, Doll_Entity);

  First_Horde  : constant := Maximum_Players;
  First_Body   : constant := First_Horde + Maximum_Zombies;
  First_Item   : constant := First_Body + Maximum_Bodies;
  First_Flag   : constant := First_Item + Maximum_Items;
  First_Doll   : constant := First_Flag + 2;
  Entity_Total : constant := First_Doll + Maximum_Ragdolls;

  subtype Entity_Id is Natural range 0..Entity_Total - 1;

  type Part_Values  is array (1..14) of Integer;

  type Part is record
      Field : Natural := 0;
      Width : Natural := 0;
    end record;

  type Part_Layout is array (Part_Values'Range) of Part;

