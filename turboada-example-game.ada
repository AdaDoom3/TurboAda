  function Fidgeted     (Idea : Thought)                              return Thought;
  function Toured       (War : World; Opening : Command; Wits : Mind) return Thought;
  function Explored     (War : World; Wits : Mind)                    return Thought;

  -------------
  -- Network --
  -------------

  use Sockets, Opus, Zlib;

  type Quad        is mod 2**32;
  type Voice_Frame is array (0..Voice_Samples - 1) of aliased opus_int16;

  type Bit_Coding is (Plain_Bits, Counted_Bits, Signed_Bits);

  type Bit_Stream is record
      Data : Bytes (0..2_047) := (others => 0);
      Last : Natural          := 0;
    end record;

  type Bit_Code is record
      Value : Long    := 0;
      Next  : Natural := 0;
    end record;

  type Voice_Packet is record
      Length : Natural        := 0;
      Data   : Bytes (0..399) := (others => 0);
    end record;

  type Voice_Slot is record
      Present  : Boolean := False;
      Sequence : Natural := 0;
      Voice    : Voice_Packet;
    end record;

  type Voice_Slots is array (0..Voice_Window - 1) of Voice_Slot;

  type Jitter_Buffer is record
      Slots     : Voice_Slots;
      Next_Play : Natural := 0;
      Primed    : Boolean := False;
      Waiting   : Natural := 0;
    end record;

  type Heard_Voice is record
      Decoder : OpusDecoder := System.Null_Address;
      Buffer  : Jitter_Buffer;
    end record;

  type Heard_Voices is array (Player_Index) of Heard_Voice;

  type Field_Values is array (1..8) of Integer;

  type Entity_State is record
      Present : Boolean      := False;
      Values  : Field_Values := (others => 0);
    end record;

  type Entity_Rows is array (Entity_Id) of Entity_State;

  Own_Quads : constant Positive := (Player'Size + 31) / 32;

  type Own_Values is array (1..Own_Quads) of Quad;

  type Snapshot is record
      Tick     : Natural    := 0;
      Own      : Own_Values := (others => 0);
      Entities : Entity_Rows;
    end record;

  type Snapshot_Access is access Snapshot;
  type Snapshot_Ring   is array (0..31) of Snapshot_Access;
  type Tick_Ring       is array (Snapshot_Ring'Range) of Integer;

  type Frame_History is record
      Frames : Snapshot_Ring := (others => null);
      Ticks  : Tick_Ring     := (others => -1);
      Next   : Natural       := 0;
    end record;

  ---------------
  -- Wire_Kind --
  ---------------

  type Wire_Kind is (Over_UDP, Over_Memory);

  type Link_Model is record
      Latency : Real := 0.0;
      Jitter  : Real := 0.0;
      Loss    : Real := 0.0;
    end record;

  procedure Reset_Wire   (Model : Link_Model; Seed : Word);
  procedure Advance_Wire (Seconds : Real);

  type Stream_Access is access z_stream;
  subtype Stream_Ring is Bytes (0..65_535);
  type Ring_Access   is access Stream_Ring;

  type Sent_Note is record
      Sequence      : Natural := 0;
      Sent_At       : Natural := 0;
      Acked         : Boolean := False;
      Reliable_From : Natural := 0;
      Reliable_To   : Natural := 0;
    end record;

  type Sent_Notes is array (0..255) of Sent_Note;

  type Wire_Link is record
      Next_Sequence : Natural := 1;
      Heard_Newest  : Natural := 0;
      Heard_Bits    : Long    := 0;
      Notes         : Sent_Notes;
      Clock         : Natural := 0;
      Round_Trip    : Real    := 4.0;
      Plain         : Bytes_Access;
      Plain_Length  : Natural := 0;
      Outgoing      : Ring_Access;
      Out_Acked     : Natural := 0;
      Out_Sent      : Natural := 0;
      Out_End       : Natural := 0;
      Resent_At     : Natural := 0;
      Squeezer      : Stream_Access;
      In_End        : Natural := 0;
      Opener        : Stream_Access;
      Inbox         : Bytes_Access;
      Inbox_Read    : Natural := 0;
      Inbox_Length  : Natural := 0;
      Sent_Bytes    : Long    := 0;
      Heard_Bytes   : Long    := 0;
      Broken        : Boolean := False;
    end record;

  ------------------
  -- Command_Ring --
  ------------------

  type Command_Ring is array (0..31) of Command;
  type Sight_Access is access Leaf_Set;

  type Connection is record
      Active       : Boolean      := False;
      Wire         : Wire_Kind    := Over_UDP;
      Address      : sockaddr_in;
      Slot         : Player_Index := 1;
      Queue        : Command_Ring;
      Head         : Natural      := 0;
      Count        : Natural      := 0;
      Newest       : Natural      := 0;
      Last_Order   : Command;
      Decoded      : Natural      := 0;
      Heard        : Natural      := 0;
      Line         : Wire_Link;
      History      : Frame_History;
      Viewer_Leaf  : Integer      := -1;
      Sees         : Sight_Access := null;
      Content      : Bytes_Access := null;
      Content_Size : Natural      := 0;
      Content_Sent : Natural      := 0;
      Squeeze_Wait : Natural      := 0;
    end record;

  type Connection_Array is array (1..Maximum_Players) of Connection;
  type Slot_Flags       is array (Player_Index) of Boolean;

  type Score_Line is record
      State  : Life    := Absent;
      Side   : Team    := Red;
      Bot    : Boolean := False;
      Figure : Natural := 0;
      Frags  : Integer := 0;
      Deaths : Integer := 0;
      Kills  : Integer := 0;
    end record;

  type Score_Table is array (Player_Index) of Score_Line;

  type Match_State is record
      Outcome  : Ending      := Playing;
      Captures : Team_Scores := (0, 0);
      Run      : Survival;
    end record;

  type Server is record
      Socket        : SOCKET_T   := INVALID_SOCKET;
      Port          : Natural    := 0;
      Memory_Port   : Natural    := 0;
      Current       : World;
      Clients       : Connection_Array;
      Minds         : Mind_Array;
      Bots          : Slot_Flags := (others => False);
      Robots_Seated : Boolean    := False;
      Scripted      : Slot_Flags := (others => False);
      Script_Orders : Command_Array;
      Applied       : Command_Array;
      Allow_Anchors : Boolean    := False;
      Map_Name      : Bounded_Name;
      Map_Path      : Bounded_Name;
      Seed          : Word       := 0;
      Relayed       : Natural    := 0;
      Spawn         : Snapshot_Access;
      Shown         : Snapshot_Access;
      Scratch       : Snapshot_Access;
      Shown_Tick    : Integer    := -1;
      Told_Missiles : Projectile_Array;
      Told_Scores   : Score_Table;
      Told_State    : Match_State;
      Packer        : Stream_Access;
      Title         : Bounded_Name :=
        (Game_Name'Length, Game_Name & (Game_Name'Length + 1..Name_Length => ' '));
      Limit         : Natural    := Maximum_Players;
    end record;

  type Server_Access is access Server;

  function Open_Server (Port      : Natural;
                        Level     : Arena_Number;
                        Mode      : Game_Mode;
                        Seed      : Word;
                        Bots      : Natural;
                        Map_Name  : String;
                        On_UDP    : Boolean;
                        On_Memory : Boolean;
                        Map_Path  : String := "") return Server_Access;

  procedure Serve       (Host : in out Server);
  procedure Warm_Up     (Host : in out Server);
  procedure Start_Match (Host : in out Server);
  procedure Close       (Host : in out Server);
  function  Down_Bytes  (Host : Server; Slot : Player_Index) return Long;
  function  Up_Bytes    (Host : Server; Slot : Player_Index) return Long;

  -----------
  -- Guess --
  -----------

  type Guess is record
      Sequence : Natural := 0;
      Position : Vector  := Origin;
      Velocity : Vector  := Origin;
    end record;

  type Guess_Ring is array (0..63) of Guess;

  type Glimpse is record
      Tick    : Natural         := 0;
      Arrived : Natural         := 0;
      Seen    : Slot_Flags      := (others => False);
      Places  : Frame_Positions := (others => Origin);
      Yaws    : Frame_Reals     := (others => 0.0);
    end record;

  type Glimpse_Ring is array (0..15) of Glimpse;

  type Client is record
      Wire          : Wire_Kind      := Over_UDP;
      Socket        : SOCKET_T       := INVALID_SOCKET;
      Memory_Port   : Natural        := 0;
      Server_At     : sockaddr_in;
      Wanted_Side   : Natural        := 0;
      Anchored      : Boolean        := False;
      Anchor_Once   : Boolean        := False;
      Anchor        : Vector         := Origin;
      Anchor_Yaw    : Real           := 0.0;
      Slot          : Player_Number  := 0;
      Level         : Arena_Number   := 1;
      Mode          : Game_Mode      := Deathmatch;
      Seed          : Word           := 0;
      Map_Name      : Bounded_Name;
      Needs_Map     : Boolean        := False;
      Ready         : Boolean        := False;
      Latest        : World;
      Previous      : World;
      Keep_Previous : Boolean        := True;
      Scores        : Score_Table;
      Received      : Natural        := 0;
      Line          : Wire_Link;
      History       : Frame_History;
      Spawn         : Snapshot_Access;
      Scratch       : Snapshot_Access;
      Shown         : Snapshot_Access;
      Unpacker      : Stream_Access;
      Authority     : Player;
      Pending       : Command_Ring;
      Next_Sequence : Natural        := 0;
      Predicted     : Player;
      Guesses       : Guess_Ring;
      Boxes         : Blocker_Access := new Blocker_List (1..0);
      Glimpses      : Glimpse_Ring;
      Glimpsed      : Natural        := 0;
      Delay_Ticks   : Real           := 4.0;
      Jitter        : Real           := 0.0;
      Talker        : OpusEncoder    := System.Null_Address;
      Spoken        : Natural        := 0;
      Voices        : Heard_Voices;
      Asked         : Natural        := 0;
      Download      : Bytes_Access   := null;
      Download_Size : Natural        := 0;
      Downloaded    : Natural        := 0;
    end record;

  type Client_Access is access Client;

  function Open_Client (Host          : String;
                        Port          : Natural;
                        Wire          : Wire_Kind;
                        Side          : Natural := 0;
                        Anchored      : Boolean := False;
                        Anchor        : Vector  := Origin;
                        Anchor_Yaw    : Real    := 0.0;
                        Anchor_Once   : Boolean := False;
                        Keep_Previous : Boolean := True) return Client_Access;

  procedure Poll         (Guest : in out Client);
  procedure Send_Command (Guest : in out Client; Order : Command);
  function  Interpolated (Guest : Client; Fraction : Real) return World;
  procedure Talk         (Guest : in out Client; Samples : Voice_Frame; Drop : Boolean := False);
  procedure Say_Goodbye  (Guest : in out Client);
  procedure Close        (Guest : in out Client_Access);

  procedure Listen (Guest : in out Client; From : Player_Index; Result : out Voice_Frame; Played, Concealed : out Boolean);

  -------------------
  -- Server_Notice --
  -------------------

  type Server_Notice is record
      Address  : sockaddr_in;
      Title    : Bounded_Name;
      Map_Name : Bounded_Name;
      Mode     : Game_Mode := Deathmatch;
      Players  : Natural   := 0;
      Bots     : Natural   := 0;
      Limit    : Natural   := 0;
      Token    : Quad      := 0;
    end record;

  function  Open_Finder                                                  return SOCKET_T;
  procedure Ask_Servers (Finder : SOCKET_T; To : sockaddr_in; Token : Quad);
  procedure Hear_Server (Finder : SOCKET_T; Heard : out Server_Notice; Found : out Boolean);
  function  Map_Path    (Bounded_Name : String; Attempt : Positive := 1) return String;

  use Interfaces.C;
  use type System.Address;

  type Packet_Kind is
    (Hello_Packet, Welcome_Packet, Refused_Packet, Goodbye_Packet, Traffic_Packet, Query_Packet, Answer_Packet, Stray_Packet);

  type News_Kind is
    (Event_News, Missile_News, Scores_News, State_News, Content_News, Fetch_News);

  type Lane is (Snapshot_Lane, Squeezed_Lane, Order_Lane, Stream_Lane, Voice_Lane);

  type Field_Rule is record
      Width  : Natural    := 0;
      Coding : Bit_Coding := Plain_Bits;
    end record;

  type Entity_Parts is record
      Present : Boolean     := False;
      Place   : Vector      := Origin;
      Parts   : Part_Values := (others => 0);
    end record;

  type Entity_Code is record
      State : Entity_State;
      Next  : Natural := 0;
    end record;

  type Four_Parts is array (0..3) of Real;
  type Stir_Flags is array (1..Maximum_Ragdolls) of Boolean;

  type Voice_Setting is record
      Request : int;
      Value   : opus_int32;
    end record;

  Voice_Tuning : constant array (1..4) of Voice_Setting :=
    ((OPUS_SET_BITRATE_REQUEST,          24_000),
     (OPUS_SET_INBAND_FEC_REQUEST,       1),
     (OPUS_SET_PACKET_LOSS_PERC_REQUEST, 10),
     (OPUS_SET_DTX_REQUEST,              1));

  type Parcel is record
      Due   : Long    := 0;
      Order : Long    := 0;
      To    : Natural := 0;
      From  : Natural := 0;
      Data  : Bytes_Access;
    end record;

  type Parcel_Table is array (1..8_192) of Parcel;
  type Parcel_Heap  is access Parcel_Table;

  Parcels       : constant Parcel_Heap := new Parcel_Table;
  Held          : Natural              := 0;
  Wire_Clock    : Long                 := 0;
  Wire_Count    : Long                 := 0;
  Wire_Model    : Link_Model;
  Wire_Seed     : Word                 := 0;
  Next_Port     : Natural              := 40_000;
  Failed_Calls  : Natural              := 0;
  Snapshot_Room : Bit_Stream;
  Mail_Room     : Bit_Stream;
  Packet_Room   : Bit_Stream;
  Heard_Room    : Bit_Stream;
  Packed_Room   : Bytes (0..2_047);

  Salt_Sum : constant uLong  := crc32 (0, Salt (Salt'First)'Address, uInt (Salt'Length));

  procedure Free_Boxes    is new Unchecked_Deallocation (Blocker_List, Blocker_Access);
  procedure Free_Snapshot is new Unchecked_Deallocation (Snapshot, Snapshot_Access);
  procedure Free_Stream   is new Unchecked_Deallocation (z_stream, Stream_Access);
  procedure Free_Ring     is new Unchecked_Deallocation (Stream_Ring, Ring_Access);
  procedure Free_Sight    is new Unchecked_Deallocation (Leaf_Set, Sight_Access);
  procedure Free_Client   is new Unchecked_Deallocation (Client, Client_Access);

  function To_Quad   is new Unchecked_Conversion (Real, Quad);
  function From_Quad   is new Unchecked_Conversion (Quad, Real);
  function Own_Of    is new Unchecked_Conversion (Player, Own_Values);
  function Player_Of is new Unchecked_Conversion (Own_Values, Player);

  package Raw_Events   is new Raw_Numbers (Event, Quad, Number_List);
  package Raw_Missiles is new Raw_Numbers (Projectile, Quad, Number_List);
  package Raw_Scores   is new Raw_Numbers (Score_Table, Quad, Number_List);
  package Raw_Matches  is new Raw_Numbers (Match_State, Quad, Number_List);

  News_Size : constant array (News_Kind) of Natural :=
    (Event_News   => Raw_Events.Quads'Length,
     Missile_News => 2 + Raw_Missiles.Quads'Length,
     Scores_News  => Raw_Scores.Quads'Length,
     State_News   => Raw_Matches.Quads'Length,
     Content_News => 3,
     Fetch_News   => 0);

  function  Bits_At           (Data : Bytes; From, Width : Natural; Sum : Long := 0)                   return Long;
  function  Ones_At           (Data : Bytes; From : Natural; Count : Natural := 0)                     return Natural;
  function  Top_Bit           (Value : Long; Bit : Natural := 0)                                       return Natural;
  function  Code_At           (Data : Bytes; From, Width : Natural; Coding : Bit_Coding := Plain_Bits) return Bit_Code;
  function  Numbers_At        (Data : Bytes; From, Count : Natural; Order : Natural := 3)              return Number_List;
  procedure Put_Bits          (Into : in out Bit_Stream; Value : Long; Width : Natural; Coding : Bit_Coding := Plain_Bits);
  procedure Put_Bytes         (Into : in out Bit_Stream; Data : Bytes);
  function  Written           (Item : Bit_Stream)                                                      return Bytes;
  function  Datagram_Checksum (Data : Bytes)                                                           return Long;
  procedure Seal_Datagram     (Into : in out Bit_Stream);
  procedure Compose           (Into : in out Bit_Stream; Kind : Natural; Values : Number_List; Blob : Bytes := No_Bytes);
  function  Message_Blob      (Data : Bytes)                                                           return Bytes;
  function  Message_Text      (Data : Bytes)                                                           return String;
  function  Message_Numbers   (Data : Bytes; Count : Natural)                                          return Number_List;
  function  Packet_Kind_Of    (Item : Bit_Stream)                                                      return Packet_Kind;
  function  Bounded           (Value : Long; Low, High : Integer)                                      return Integer;
  function  Field_Place       (Values : Field_Values)                                                  return Vector;
  function  Angle_Bits        (Angle : Real; Width : Natural)                                          return Integer;
  function  Angle_Of          (Bits : Integer; Width : Natural)                                        return Real;
  function  Largest_Part      (Parts : Four_Parts; From : Natural := 1; Best : Natural := 0)           return Natural;
  function  Ninth             (Parts : Four_Parts; Largest, Rank : Natural)                            return Integer;
  function  Turn_Bits         (Turn : Quaternion)                                                      return Integer;
  function  Turn_From_Bits    (Bits : Integer)                                                         return Quaternion;
  function  Field_Width       (Class : Entity_Class; Field : Positive; P : Positive := 1)              return Natural;
  function  Rule_Of           (Class : Entity_Class; Field : Positive)                                 return Field_Rule;
  function  Shift_Of          (Class : Entity_Class; P : Positive)                                     return Natural;
  function Field_Sum (Class : Entity_Class; Field : Positive; Parts : Part_Values; P : Positive := 1; Sum : Long := 0)
     return Integer;
  function Parts_Of        (Class : Entity_Class; Values : Field_Values) return Part_Values;
  function Entity_Class_Of (Id : Entity_Id)                              return Entity_Class;
  function Bone_Of (Current : World; Item : Body_Slot; Doll : Natural := Maximum_Ragdolls; Part : Natural := Ragdoll_Parts'Last)
     return Natural;
  function Entity_Row_At (Current : World; Id : Entity_Id) return Entity_State;
  function Snapshot_Of   (Current : World)                 return Snapshot;
  function Same_State    (Left, Right : Entity_State)      return Boolean;
  function Entity_Decoded (Data : Bytes; From : Natural; Class : Entity_Class; Known : Entity_State; Field : Natural := 0)
     return Entity_Code;
  function  Frame_In   (History : Frame_History; Tick : Integer; K : Integer := Snapshot_Ring'Last) return Snapshot_Access;
  procedure Keep_Frame (History : in out Frame_History; Scratch : in out Snapshot_Access);

  function  Memory_Address   (Port : Natural)                                         return sockaddr_in;
  function  Next_Parcel      (Port : Natural; P : Positive := 1; Best : Natural := 0) return Natural;
  procedure Send_Datagram    (Over : Wire_Kind; Socket : SOCKET_T; Port : Natural; Item : Bit_Stream; To : sockaddr_in);
  procedure Receive_Datagram (Socket : SOCKET_T;
                              Port : Natural;
                              Item : in out Bit_Stream;
                              From : out sockaddr_in;
                              Over : out Wire_Kind;
                              Got  : out Boolean);
  function  Opened_Link                                                               return Wire_Link;
  procedure Close_Link       (Line : in out Wire_Link);
  procedure Queue_News       (Line : in out Wire_Link; Kind : News_Kind; Values : Number_List; Blob : Bytes := No_Bytes);
  procedure Flush_Plain      (Line : in out Wire_Link);
  function  Ring_Bytes       (Ring : Stream_Ring; From, To : Natural)                 return Bytes;
  function  Resend_Due       (Line : Wire_Link)                                       return Boolean;
  function  Reliable_Due     (Line : Wire_Link)                                       return Boolean;
  procedure Begin_Traffic    (Line : in out Wire_Link; Packet : in out Bit_Stream);
  procedure Put_Lane         (Packet : in out Bit_Stream; Kind : Lane; Number : Long; Data : Bytes);
  procedure Add_Segment      (Line : in out Wire_Link; Packet : in out Bit_Stream);
  procedure Finish_Traffic   (Line : in out Wire_Link; Packet : in out Bit_Stream);
  function  Unwrap           (Newest, Low : Natural)                                  return Natural;
  procedure Take_Segment     (Line : in out Wire_Link; From : Natural; Data : Bytes);

  generic
    with procedure Handle (Kind : Lane; Number : Long; Data : Bytes);
    with procedure Read   (Message : Bytes);
  procedure Walk_Lanes (Item : Bit_Stream; Line : in out Wire_Link);

  procedure Seat_Robots     (Host : in out Server);
  procedure Drop_Connection (C : in out Connection);

  function Connection_Of (Host : Server; Slot : Player_Index; C : Positive := 1) return Natural;
  function Connection_At (Host : Server; Address : sockaddr_in; Over : Wire_Kind; Vacant : Boolean := False; C : Positive := 1)
     return Natural;

  function  Scores_Of      (Current : World)                                                 return Score_Table;
  function  Match_Of       (Current : World)                                                 return Match_State;
  procedure Broadcast      (Host : in out Server; Kind : News_Kind; Values : Number_List);
  procedure Tell_News      (Host : in out Server);
  procedure Relay_Voice    (Host : in out Server; Speaker : Player_Index; Number : Long; Data : Bytes);
  function  Joining_Slot   (Host : Server; Robots_Too : Boolean := False; P : Positive := 1) return Natural;
  function  Count_In       (Host : Server; Robots : Boolean; P : Positive := 1)              return Natural;
  procedure Greet          (Host : in out Server; Item : Bit_Stream; From : sockaddr_in; Over : Wire_Kind; Known : Natural);
  function  Order_Numbers  (Order : Command)                                                 return Number_List;
  function  Command_Of     (Values : Number_List; Before : Command)                          return Command;
  procedure Take_Orders    (Now : Natural; C : in out Connection; Data : Bytes);
  procedure Take_Request   (Path : String; C : in out Connection);
  procedure Answer_Query   (Host : Server; Item : Bit_Stream; From : sockaddr_in; Over : Wire_Kind);
  procedure Hear_Client    (Host : in out Server; C : in out Connection; Item : Bit_Stream);
  procedure Hear           (Host : in out Server);
  procedure Write_Snapshot (Host : in out Server; C : in out Connection; Packet : in out Bit_Stream);
  procedure Send_Traffic   (Host : in out Server; C : in out Connection; With_Snapshot : Boolean);

  procedure Get_Ready (Guest : in out Client);
  function Prey_Of (Players : Player_Array; Place : Vector; P : Positive := 1; Best : Natural := 0) return Natural;
  function Body_At_Bone (Current : World; Shown : Snapshot; Doll, Bone : Positive; B : Natural := Maximum_Bodies) return Natural;
  function Ragdoll_Part_At (Current : World; Shown : Snapshot; Doll, Bone : Positive; Facing : Real) return Ragdoll_Part;
  procedure Unpack  (Guest : in out Client; Id : Entity_Id; Stirred : in out Stir_Flags);
  procedure Predict (Guest : in out Client; Sequence : Natural);
  procedure Take_Snapshot (Guest : in out Client; Bits : Natural; Data : Bytes; Squeezed : Boolean);
  procedure Take_Message (Guest : in out Client; Message : Bytes);

  function Flown_Missile (Missile : Projectile) return Projectile;

  function Glimpse_Near        (Ring   : Glimpse_Ring;
                                Slot   : Player_Index;
                                Wanted : Real;
                                Later  : Boolean;
                                K      : Natural := 0;
                                Best   : Integer := -1) return Integer;
  function Interpolated_Player (Item : Player; Ring : Glimpse_Ring; Slot : Player_Index; Wanted : Real) return Player;
  function Eased               (Was, Now : Zombie; Along : Real)                                        return Zombie;
  function Eased               (Was, Now : Rigid_Body; Along : Real)                                    return Rigid_Body;
  function Own_Eased           (Guest : Client; Item : Player; Fraction : Real)                         return Player;

  --------------
  -- Sessions --
  --------------

  type Seat_Kind is (Vacant, Person, Robot, Scripted);

  type Script_Key is
    (Key_Forward,
     Key_Back,
     Key_Left,
     Key_Right,
     Key_Jump,
     Key_Crouch,
     Key_Walk,
     Key_Fire,
     Key_Use,
     Key_Fire2,
     Key_Reload,
     Key_Sprint);

  type Key_Set is array (Script_Key) of Boolean;

  type Script_Row is record
      Tick  : Natural    := 0;
      Keys  : Key_Set    := (others => False);
      Arms  : Weapon_Set := (others => False);
      Yaw   : Real       := 0.0;
      Pitch : Real       := 0.0;
    end record;

  type Script_Rows   is array (Positive range <>) of Script_Row;
  type Script_Access is access Script_Rows;

  No_Rows : constant Script_Rows (1..0) := (others => <>);

  type Seat is record
      Kind     : Seat_Kind := Vacant;
      Guest    : Client_Access;
      Thinking : Mind;
      Script   : Script_Access;
      Cursor   : Positive  := 1;
      Sent     : Natural   := 0;
      Alive_At : Integer   := -1;
      Order    : Command;
    end record;

  subtype Seat_Slot  is Integer range 1..Maximum_Players;
  type    Seat_Array is array (Seat_Slot) of Seat;

  type Session is record
      Host  : Server_Access;
      Seats : Seat_Array;
      Count : Natural := 0;
    end record;

  function  Read_Script (Path : String) return Script_Access;
  function  Arena_For   (Path : String) return Natural;
  procedure Assemble    (Play : in out Session; Patience : Natural := 1_280);
  procedure Close       (Play : in out Session);

  procedure Add_Seat (Play     : in out Session;
                      Kind     : Seat_Kind;
                      Guest    : Client_Access;
                      Thinking : Mind          := New_Mind;
                      Script   : Script_Access := null);

  procedure Advance (Play : in out Session; Person_Order : Command := (others => <>));

  package Key_Words is new Words (Script_Key);

  Known       : array (Arena_Number) of Bounded_Name;
  Known_Count : Natural := 0;

  function Script_Keys (Text : String; Row : Script_Row := (others => <>)) return Script_Row;
  function Degrees     (Text : String)                                     return Real;
  function Rows_From   (Text : String)                                     return Script_Rows;

  function  Held_Arm  (Arms : Weapon_Set; First, Last, Otherwise : Weapon) return Weapon;
  function  Order_Of  (Row : Script_Row; Current : Command)                return Command;
  procedure Load_Into (Path : String; Number : Arena_Number);
