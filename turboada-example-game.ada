  -- Display --
  -------------

  type Camera is record
      Eye   : Vector := Origin;
      Yaw   : Real   := 0.0;
      Pitch : Real   := 0.0;
      Field : Real   := 74.0;
    end record;

  Width  : Positive := 1280;
  Height : Positive := 720;

  procedure Open          (Wide, High : Positive);
  procedure Prepare_Level (Number : Arena_Number);
  procedure Warm_Level    (Current : World);
  procedure Clear         (Tint : Colour);
  procedure Draw_World    (Current : World; View : Camera; Viewer : Player_Number; Clock : Real);
  procedure Draw_Weapon   (View : Camera; Holding : Weapon; Since_Fire, Clock : Real);
  procedure Flush_Overlay (View : Camera);
  procedure Capture       (Path : String);
  procedure Glyph         (Shape : Outline; X, Y, Scale_X, Scale_Y : Real; Tint : Colour);

  procedure Glyph_At (Shape : Outline; View : Camera; Place, Across, Upward : Vector; Size : Real; Tint : Colour);

  type Torch_Rule is (By_Night, Always_Lit, Never_Lit);

  Torch            : Torch_Rule := By_Night;
  Blood_Shown      : Boolean    := True;
  Gun_Field        : Real       := 68.0;
  Left_Handed_View : Boolean    := False;

  function Facts_Of (Item : Player)   return Facts;
  function Facts_Of (Undead : Zombie) return Facts;

  procedure Grade (Brightness : Real);

  procedure Inspect;

  use OpenGL;
  use type Interfaces.C.int, Interfaces.C.unsigned_long, Interfaces.Unsigned_32,
    Interfaces.Unsigned_8, Interfaces.Integer_32, Interfaces.C.C_float;

  package C_Strings renames Interfaces.C.Strings;

  type Float_Buffer is array (Natural range <>) of aliased GLfloat;
  type Float_Access is access Float_Buffer;
  type Reals_Access is access Reals;
  type Index_Buffer is array (Natural range <>) of Interfaces.Unsigned_32;
  type Index_Buffer_Access is access Index_Buffer;
  type Index_List   is array (Natural range <>) of Natural;

  procedure Free is new Unchecked_Deallocation (Reals, Reals_Access);
  procedure Free is new Unchecked_Deallocation (Float_Buffer, Float_Access);
  procedure Free is new Unchecked_Deallocation (Index_Buffer, Index_Buffer_Access);

  function To_Address is new Unchecked_Conversion (Word, System.Address);

  Embedded   : Boolean         := False;

  type Program_Kind is
    (Level_Shader,
     Model_Shader,
     Caster_Shader,
     Level_Caster_Shader,
     Slug_Shader,
     Glow_Shader,
     Shadow_Shader,
     Mote_Shader,
     Scar_Shader,
     Occlusion_Shader,
     Apply_Shader,
     Down_Shader,
     Up_Shader,
     Composite_Shader,
     Final_Shader,
     Reflect_Shader);

  subtype Screen_Shader is Program_Kind range Occlusion_Shader..Reflect_Shader;

  type Locations is array (Uniform) of GLint;

  type Program is record Id : GLuint := 0; Uniforms : Locations := (others => -1); end record;

  Programs : array (Program_Kind) of Program;

  function  Source_Of   (Kind : Program_Kind; Fragment : Boolean) return String;
  procedure Compile     (Kind : Program_Kind);
  procedure Set_Integer (Into : Program_Kind; Bounded_Name : Uniform; Value : Integer);
  procedure Set_Real    (Into : Program_Kind; Bounded_Name : Uniform; Value : Real);
  procedure Set         (Into : Program_Kind; Bounded_Name : Uniform; Values : Reals);
  procedure Set_Array   (Into : Program_Kind; Bounded_Name : Uniform; Width : Positive; Values : Reals);
  procedure Set_Matrix  (Into : Program_Kind; Bounded_Name : Uniform; Item : Matrix);
  function  Triple      (Item : Vector)                           return Reals;
  procedure Use_Program (Kind : Program_Kind; Projection : Matrix);

  type Blend_Mode is (Opaque, Over, Added, Shaded_Over, Darkened);

  type Blend_Row is record Source, Target : GLenum; Writes_Depth : Boolean; end record;

  Blend_Rows : constant array (Blend_Mode) of Blend_Row :=
    (Opaque      => (GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, True),
     Over        => (GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, False),
     Added       => (GL_ONE,       GL_ONE,                 False),
     Shaded_Over => (GL_ONE,       GL_ONE_MINUS_SRC_ALPHA, False),
     Darkened    => (GL_DST_COLOR, GL_ZERO,                False));

  procedure Blend (Mode : Blend_Mode);

  function  Offset_Of (Counts : Attribute_Counts; K : Natural) return Natural;
  procedure Lay_Out   (Format : Vertex_Format; Vertex_Array, Buffer : in out GLuint);
  procedure Send (Data : System.Address; Floats : Natural; Usage : GLenum := GL_STATIC_DRAW; Target : GLenum := GL_ARRAY_BUFFER);

  Anisotropy   : GLfloat := 1.0;
  Sample_Count : Natural := 4;

  type Texel_Format is (Rgb_Bytes, Srgb_Bytes, Rg_Bytes, Red_Bytes, Rgba_Bytes, Half_Floats, Floats_Halved, Floats, Depths);

  type Texel_Row is record
      Internal : GLint;
      Format   : GLenum;
      Kind     : GLenum;
    end record;

  Texel_Rows : constant array (Texel_Format) of Texel_Row :=
    (Rgb_Bytes     => (GLint (GL_RGB8),              GL_RGB,             GL_UNSIGNED_BYTE),
     Srgb_Bytes    => (GLint (GL_SRGB8),             GL_RGB,             GL_UNSIGNED_BYTE),
     Rg_Bytes      => (GLint (GL_RG8),               GL_RG,              GL_UNSIGNED_BYTE),
     Red_Bytes     => (GLint (GL_R8),                GL_RED,             GL_UNSIGNED_BYTE),
     Rgba_Bytes    => (GLint (GL_RGBA8),             GL_RGBA,            GL_UNSIGNED_BYTE),
     Half_Floats   => (GLint (GL_RGBA16F),           GL_RGBA,            GL_HALF_FLOAT),
     Floats_Halved => (GLint (GL_RGBA16F),           GL_RGBA,            GL_FLOAT),
     Floats        => (GLint (GL_RGBA32F),           GL_RGBA,            GL_FLOAT),
     Depths        => (GLint (GL_DEPTH_COMPONENT24), GL_DEPTH_COMPONENT, GL_UNSIGNED_INT));

  type Texture_Sampling is (Mipmapped, Smooth_Clamped, Sharp, Sharp_Clamped);

  type Sampling_Row is record
      Shrink : GLint;
      Filter : GLint;
      Wrap   : GLint;
    end record;

  Samplings : constant array (Texture_Sampling) of Sampling_Row :=
    (Mipmapped      => (GLint (GL_LINEAR_MIPMAP_LINEAR), GLint (GL_LINEAR),  GLint (GL_REPEAT)),
     Smooth_Clamped =>
       (GLint (GL_LINEAR),               GLint (GL_LINEAR),  GLint (GL_CLAMP_TO_EDGE)),
     Sharp          => (GLint (GL_NEAREST),              GLint (GL_NEAREST), GLint (GL_REPEAT)),
     Sharp_Clamped  =>
       (GLint (GL_NEAREST),              GLint (GL_NEAREST), GLint (GL_CLAMP_TO_EDGE)));

  procedure Filter_Bound (Mode : Texture_Sampling);
  procedure Upload       (Id     : in out GLuint;
                          Pixels : System.Address;
                          Wide   : Natural;
                          High   : Natural;
                          Format : Texel_Format;
                          Mode   : Texture_Sampling := Mipmapped);
  procedure Drop_Texture (Texture : in out GLuint);
  procedure Bind_Unit    (Unit : Natural; Texture : GLuint);

  subtype Block_Values is Bytes (0..15);

  function  Extreme         (Values : Block_Values; Highest : Boolean; K : Natural := 0)                       return Natural;
  function  Encoded_Block   (Values : Block_Values; Low, High : Natural; K : Natural := 0; Bits : Word := 0)   return Bytes;
  procedure Compress        (Planes : Bytes; Wide : Natural; Packed : Bytes_Access);
  function  Halved_Normal   (Planes : Bytes; Wide, Corner : Natural; K : Natural := 0; Sum : Vector := Origin) return Vector;
  procedure Normal_Texture  (Item : in out Picture_Access; Id : in out GLuint);
  procedure Picture_Texture (Item : in out Picture_Access; Id : in out GLuint; Linear : Boolean := False);

