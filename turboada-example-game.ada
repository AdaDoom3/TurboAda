  -----------

  Volumes     : Volume_Table := (others => 1.0);
  Input_Level : Real         := 0.0;

  procedure Open_Audio;

  procedure Close_Audio;

  procedure Hear_World (Current : World; Heard_To : in out Natural; Ear : Vector; Yaw, Pitch : Real; Me : Player_Number := 0);

  procedure Play_Signal   (Item : Signal_Kind);
  procedure Converse      (Guest : in out Client; Talking : Boolean);
  procedure Measure_Input (Listening : Boolean);

  use OpenAL;
  use type System.Address, Interfaces.C.int, Interfaces.C.unsigned;

  procedure Free_Samples is new Unchecked_Deallocation (Sound_Samples, Samples_Access);

  function Log_10 (Value : Real)
     return Real with Import, Convention => C, External_Name => "log10f";

  type Way_Shares is array (1..5) of Real;

  type Take_Ids is array (1..6) of aliased ALuint;

  type Family is record
      Name  : Bounded_Name;
      Count : Natural  := 0;
      Ids   : Take_Ids := (others => 0);
      Last  : Natural  := 0;
    end record;

  type Family_Table  is array (1..224) of Family;
  type Families_Heap is access Family_Table;

  Families     : constant Families_Heap := new Family_Table;
  Family_Count : Natural                := 0;

  type Sounding is record
      Source   : aliased ALuint := 0;
      Filter   : aliased ALuint := 0;
      Busy     : Boolean        := False;
      Kind     : Sound_Cue      := Ambient;
      Where    : Vector         := Origin;
      At_Ear   : Boolean        := False;
      Looping  : Boolean        := False;
      Loudness : Real           := 1.0;
      Reach    : Real           := 0.0;
      Started  : Real           := 0.0;
      Clear    : Real           := 1.0;
      Open     : Real           := 1.0;
      Checked  : Real           := -9.0;
    end record;

  type Mixer_Voices is array (1..40) of Sounding;

  type Voice_Search is record
      Same     : Natural := 0;
      Oldest   : Natural := 0;
      Free     : Natural := 0;
      Weakest  : Natural := 0;
      Weakness : Real    := Real'Last;
    end record;

  type Delayed is record
      Due      : Real      := -1.0;
      Kind     : Sound_Cue := Casing;
      Name     : Bounded_Name;
      Where    : Vector    := Origin;
      At_Ear   : Boolean   := False;
      Loudness : Real      := 1.0;
    end record;

  type Delayed_List is array (1..48) of Delayed;

  type Role_Ground is record
      Role   : Bounded_Name;
      Family : Surface_Family := Bare;
    end record;

  type Role_Grounds is array (1..128) of Role_Ground;

  type Ground_Table is record
      Rows  : Role_Grounds;
      Count : Natural := 0;
    end record;

  type Walker_Sound is record
      Alive   : Boolean := False;
      Timer   : Real    := 0.0;
      Left    : Boolean := False;
      Speed   : Real    := 0.0;
      Heading : Real    := 0.0;
      Scuffed : Real    := -9.0;
      Cried   : Real    := -99.0;
      Hit_At  : Real    := -9.0;
      Damage  : Real    := 0.0;
      Head    : Boolean := False;
      Knifed  : Boolean := False;
      Holding : Weapon  := Knife;
      Rounds  : Natural := 0;
      Reloads : Real    := 0.0;
      Waiting : Real    := 0.0;
      Pinned  : Boolean := False;
      Fitted  : Boolean := False;
      Clicked : Real    := -9.0;
    end record;

  type Shambler_Sound is record
      Breathe : Real := 0.0;
      Shuffle : Real := 0.0;
      Growled : Real := -99.0;
      Hit_At  : Real := -9.0;
    end record;

  type Hum is record
      Place  : Vector  := Origin;
      Name   : Bounded_Name;
      Volume : Real    := 1.0;
      Reach  : Real    := 10.0;
      Voice  : Natural := 0;
    end record;

  type Bed_Pair  is array (1..2) of aliased ALuint;
  type Bed_Gains is array (1..2) of Real;
  type Bed_Slots is array (1..2) of Natural;

  type Bed is record
      Sources  : Bed_Pair  := (others => 0);
      Gains    : Bed_Gains := (others => 0.0);
      Families : Bed_Slots := (others => 0);
      Front    : Positive  := 1;
      Target   : Real      := 0.0;
    end record;

  type Scraper is record
      Item  : Body_Index := 0;
      Voice : Natural    := 0;
    end record;

  type Speech_Queue is array (1..8) of aliased ALuint;

  type Speaker is record
      Source : aliased ALuint := 0;
      Free   : Speech_Queue   := (others => 0);
      Spare  : Natural        := 0;
    end record;

  type Attribute_List is array (1..7) of aliased ALCint;

  type Heard_State is record
      Said    : Announcement := Silent;
      Said_At : Natural      := 0;
      Newest  : Natural      := 0;
    end record;

  Device             : System.Address                 := System.Null_Address;
  Sound_Context      : System.Address                 := System.Null_Address;
  Capture_Device     : System.Address                 := System.Null_Address;
  Enabled            : Boolean                        := False;
  Filtering          : Boolean                        := False;
  Throws             : Long                           := 0;
  Mixer              : Mixer_Voices;
  Audio_Clock        : Real                           := 0.0;
  Last_Now           : Real                           := -1.0;
  Listener           : Player_Number                  := 0;
  Ear_Place          : Vector                         := Origin;
  Level_Heard        : Arena_Number                   := 1;
  Gun_Duck           : Real                           := 1.0;
  Deafened           : Real                           := 0.0;
  Was_Blind          : Real                           := 0.0;
  Room_Effect        : aliased ALuint                 := 0;
  Room_Slot          : aliased ALuint                 := 0;
  Room_Decay         : Real                           := 1.0;
  Room_Wet           : Real                           := 0.2;
  Room_Checked       : Real                           := -9.0;
  Queue              : Delayed_List;
  Grounds            : Ground_Table;
  Grounds_Level      : Natural                        := 0;
  Walkers            : array (Player_Index) of Walker_Sound;
  Shamblers          : array (Zombie_Index) of Shambler_Sound;
  Last_Growl         : Real                           := -99.0;
  Last_Dying         : Real                           := -99.0;
  Knocked            : array (Body_Slot) of Real      := (others => -99.0);
  Hums               : array (1..24) of Hum;
  Hum_Count          : Natural                        := 0;
  Hums_Level         : Natural                        := 0;
  Beds               : array (Bed_Kind) of Bed;
  Last_Outcome       : Ending                         := Playing;
  Scrapers           : array (1..3) of Scraper;
  Speakers           : array (Player_Index) of Speaker;
  Context_Attributes : aliased Attribute_List :=
    (ALC_OUTPUT_LIMITER_SOFT, ALC_TRUE, ALC_FREQUENCY, 48_000, ALC_HRTF_SOFT, ALC_FALSE, 0);

  type Music_Choice is (No_Music, Menu_Music, Night_Music);
  Music_Source       : aliased ALuint   := 0;
  Menu_Tune          : ALuint           := 0;
  Night_Tune         : ALuint           := 0;
  Menu_Length        : Real             := 0.0;
  Night_Length       : Real             := 0.0;
  Music_Now          : Music_Choice     := No_Music;
  Music_Gain         : Real             := 0.0;
  Music_Target       : Real             := 0.0;
  Menu_Resume        : Real             := 0.0;
  Menu_Spent         : Boolean          := False;
  Night_Armed        : Boolean          := False;
  Night_Was          : Boolean          := False;
  Match_Begin        : Real             := 0.0;
  Menu_Since         : Real             := 0.0;
  Menu_Music_Delay   : constant Real    := 1.0;

  procedure Load_Music;
  procedure Set_Music   (Want : Music_Choice);
  procedure Update_Music (Dt : Real);
  function  Buffer_Seconds (Buffer : ALuint) return Real;
  Menu_Soft          : constant Real    := 0.33;
  Night_Level        : constant Real    := 0.62;
  Music_Fade_In      : constant Real    := 0.40;
  Music_Fade_Out     : constant Real    := 1.1;

  function Sound_Of        (Names : access constant String; N : Positive)                                return String;
  function Casing_Of       (Item : Casing_Sound)                                                         return String;
  function Material_Word   (Item : Material_Kind)                                                        return String;
  function Names_Material  (Detail : Natural)                                                            return Boolean;
  function Voice_Of        (Arm : Weapon)                                                                return Weapon;
  function Named           (German, Otherwise : String)                                                  return String;
  function Roll            (Salt : Long)                                                                 return Real;
  function Decibels        (Level : Real)                                                                return Real;
  function Metres_Off      (Where : Vector)                                                              return Real;
  function Mine            (Who : Natural)                                                               return Boolean;
  function Falloff         (Kind : Sound_Cue; Metres, Reach : Real)                                      return Real;
  function Gain_Of         (Item : Sounding)                                                             return Real;
  function Score_Of        (Kind : Sound_Cue; Weight : Real)                                             return Real;
  function Seen_From_Ear   (Where : Vector)                                                              return Real;
  function Searched_Voices (Kind : Sound_Cue; V : Positive := 1; Found : Voice_Search := (others => <>)) return Voice_Search;
  function Family_Slot     (Called : String; F : Positive := 1)                                          return Natural;
  function Sounded_As      (Called : String)                                                             return Natural;
  function Pick_Take       (Kin : Family; Parity : Natural; Attempt : Positive := 1)                     return Positive;
  function Free_Slot       (K : Positive := Delayed_List'First)                                          return Natural;
  function Closures        (From : Vector; Reach : Real)                                                 return Way_Shares;
  function Way_Total       (Shares : Way_Shares; K : Positive := 1)                                      return Real;
  function Ground_Over     (Line : String; W, Count : Natural; So_Far : Surface_Family)                  return Surface_Family;
  function Ground_Line     (So_Far : Ground_Table; Raw : String)                                         return Ground_Table;

  function Grounds_Read is new Over_Lines (Ground_Table, Ground_Line);

  function  Ground_For  (Role : String; G : Positive := 1)                        return Natural;
  function  Surface_At  (Feet : Vector)                                           return Surface_Family;
  function  Near_Dead   (Current : World; Z : Zombie_Index := Zombie_Index'First) return Natural;
  function  Is_Hushed   (Sound : String)                                          return Boolean;
  function  Sliding     (Item : Rigid_Body)                                       return Boolean;
  function  Strength    (Item : Rigid_Body)                                       return Real;
  function  Slider      (Current : World; K : Body_Slot := Body_Slot'First)       return Body_Index;
  function  Voice_At    (Kind : Sound_Cue; Where : Vector; V : Positive := 1)     return Natural;
  function  Peak_Of     (Spoken : Voice_Frame; K : Integer; Peak : Real := 0.0)   return Real;
  function  Buffered    (Path : String)                                           return ALuint;
  procedure Load_Family (Called : String);
  procedure Apply_Gain  (Item : Sounding);
  procedure Play_Cue (Kind     : Sound_Cue;
                      Called   : String;
                      Where    : Vector;
                      At_Ear   : Boolean := False;
                      Loudness : Real    := 1.0;
                      Pitch    : Real    := 1.0;
                      Parity   : Natural := 0;
                      Looping  : Boolean := False;
                      Reach    : Real    := 0.0);
  procedure Later (After : Real; Kind : Sound_Cue; Called : String; Where : Vector; At_Ear : Boolean; Loudness : Real := 1.0);
  procedure Footfall (Item : Player; Who : Player_Index; Kind : Sound_Cue; Loudness : Real; Left : Boolean);
  procedure Hear_Gunshot   (Current : World; E : Event);
  procedure Strike         (Current : World; E : Event);
  procedure Follow_Players (Current : World; Seconds : Real);
  procedure Collide        (E : Event);
  procedure Haunt          (Current : World);
  procedure Silence        (Voice : Natural);
  procedure Ambience       ;
  procedure Set_Beds       (Current : World; Seconds : Real);
  procedure Scrape_Props   (Current : World);
  procedure At_The_Ear     (Source : not null access ALuint);

  procedure Hear_Event  (Current : World; E : Event; Ear : Vector);
  procedure Tend_Voices ;

  procedure Open_Capture;

  generic
    with procedure Heard (Spoken : Voice_Frame);
  procedure Read_Capture;

  ------------
  -- Window --
  ------------

  type Scene_Kind is
    (Splash_Scene, Menu_Scene, Setup_Scene, Host_Scene, Browser_Scene, Address_Scene,
     Replays_Scene, Options_Scene, Quit_Scene, Loading_Scene,
     Team_Scene, Play_Scene, Pause_Scene, Leave_Scene, Controls_Scene, End_Scene);

  -------------------
  -- Start_Options --
  -------------------

  type Start_Options is record
      Map_Name  : Bounded_Name;
      Mode_Text : Bounded_Name;
      Level     : Bounded_Name;
      Bots      : Integer    := -1;
      Wide      : Natural    := 0;
      High      : Natural    := 0;
      Connect   : Bounded_Name;
      Shot      : Bounded_Name;
      Walk      : Bounded_Name;
      Replay    : Bounded_Name;
      Scene     : Scene_Kind := Splash_Scene;
      Ticks     : Natural    := 640;
      Viewing   : Boolean    := False;
      View      : Camera;
      Host      : Boolean    := False;
      Port      : Natural    := 0;
      Seed      : Natural    := 0;
      Resident  : Boolean    := False;
      Waves     : Natural    := 0;
    end record;

  function  Scene_Named (Text : String; From : Scene_Kind := Scene_Kind'First) return Scene_Kind;
  procedure Run_Game    (Choice : Start_Options);
  function  Next_Frame                                                         return Interfaces.C.int;

  pragma Export (C, Next_Frame, "turbo_frame");

  use type Interfaces.C.C_bool, Interfaces.C.int, Interfaces.C.C_float,
    Interfaces.C.Strings.chars_ptr, System.Address, SDL.Uint32;

  type Key_States is array (0..511) of Interfaces.C.C_bool;
  type Key_Access is access all Key_States;

  function To_Keys is new Unchecked_Conversion (System.Address, Key_Access);

  type Match_Kind     is (No_Match, Offline_Match, Hosted_Match, Joined_Match, Replay_Match);
  type Options_Tab    is (Gameplay_Tab, Controls_Tab, Video_Tab, Audio_Tab, HUD_Tab);
  type Browser_Tab    is (LAN_Tab, History_Tab, Favourites_Tab);
  type Sort_Key       is (By_Name, By_Players, By_Map, By_Mode, By_Latency);
  type Gun_Menu_State is (Closed, Choosing_Primary, Choosing_Pistol, Buying_Group, Buying_Item);

  type Choice_Flags     is array (1..5) of Boolean;
  type Virtual_Keys   is array (Player_Action) of Natural;
  type Script_Lines   is array (1..1024) of Bounded_Name;

  type Request_Kind is
    (No_Request, Start_Match_Request, Join_Request, Replay_Request, Leave_Request, Restart_Request, Quit_Request);

  -----------
  -- Setup --
  -----------

  type Setup is record
      Map_Name : Bounded_Name := (8, "crucible" & (9..Name_Length => ' '));
      Mode     : Game_Mode    := Deathmatch;
      Bots     : Natural      := 3;
      Level    : Difficulty   := Regular;
      Score    : Natural      := 0;
      Minutes  : Natural      := 0;
      Team     : Team_Choice  := Auto_Team;
      Hosting  : Boolean      := False;
      Port     : Natural      := Default_Port;
      Limit    : Natural      := 8;
      Title    : Bounded_Name := (19, "Turbo Engine server" & (20..Name_Length => ' '));
      Address  : Bounded_Name;
      Endless  : Boolean      := True;
    end record;

  ---------------
  -- Map_Entry --
  ---------------

  type Map_Entry is record
      Map_Name : Bounded_Name;
      Number   : Natural := 0;
    end record;

  type Map_List is array (Positive range <>) of Map_Entry;

  ----------------
  -- Server_Row --
  ----------------

  type Server_Row is record
      Address  : Bounded_Name;
      Title    : Bounded_Name;
      Map_Name : Bounded_Name;
      Mode     : Game_Mode := Deathmatch;
      Players  : Natural   := 0;
      Bots     : Natural   := 0;
      Limit    : Natural   := 0;
      Ping     : Natural   := 0;
      Answered : Boolean   := False;
    end record;

  type Server_List is array (Positive range <>) of Server_Row;

  ----------------
  -- Replay_Row --
  ----------------

  type Replay_Row is record
      Path     : Phrase;
      Map_Name : Bounded_Name;
      Mode     : Bounded_Name;
      Date     : Bounded_Name;
      Ticks    : Natural := 0;
    end record;

  type Replay_List  is array (Positive range <>) of Replay_Row;
  type Replays_Heap is access Replay_List;

  type Script_Heap is access Script_Lines;
  type Play_Heap   is access Session;
  type World_Heap  is access World;

  --------------
  -- Buy_Item --
  --------------

  type Buy_Item is record
      Arm  : Weapon    := Knife;
      Gear : Gear_Kind := No_Gear;
    end record;

  type Buy_List is array (Positive range <>) of Buy_Item;

  ---------------
  -- Card_Line --
  ---------------

  type Card_Line  is record Keys, Does : Bounded_Name; end record;
  type Card_Lines is array (Positive range <>) of Card_Line;

  Studio_Profile : constant Profile :=
    (Factory with delta
       Wide          => 960,
       High          => 540,
       Window_Mode   => Windowed,
       Vertical_Sync => False,
       Frame_Cap     => 0,
       Controls_Seen => True);

  Window_Handle    : SDL.SDL_Window;
  Context          : SDL.SDL_GLContext;
  Gamepad          : SDL.SDL_Gamepad          := System.Null_Address;
  Relative         : Boolean                  := False;
  Typing_On        : Boolean                  := False;
  Running          : Boolean                  := True;
  Walking          : Boolean                  := False;
  Clock            : Real                     := 0.0;
  Owed             : Real                     := 0.0;
  Scene            : Scene_Kind               := Splash_Scene;
  Back_To          : Scene_Kind               := Menu_Scene;
  Splash_Fill      : Real                     := 0.0;
  Splash_Tick      : Real                     := 0.0;
  Splash_Pumping   : Boolean                  := False;
  Splash_Prepared  : Boolean                  := False;
  Splash_Overlay   : Boolean                  := False;

  protected Splash_Ready is
    procedure Reset;
    procedure Mark;
    function  Done return Boolean;
  private
    Flag : Boolean := False;
  end Splash_Ready;

  task Map_Loader is
    entry Start;
  end Map_Loader;
  Request          : Request_Kind             := No_Request;
  Match            : Match_Kind               := No_Match;
  Current_Session  : constant Play_Heap       := new Session;
  Me               : Natural                  := 1;
  Tape             : Replay_Access            := null;
  Tape_Ticks       : Natural                  := 0;
  Tape_Path        : Phrase                   := new String'("");
  Followed_Player  : Player_Index             := 1;
  Watching         : Boolean                  := True;
  Wanted           : Setup;
  Last_Setup       : Setup;
  Memory           : Feedback;
  Local_Order      : Command;
  Wanted_Kit       : Loadout;
  Equipping        : Boolean                  := False;
  Switch_To        : Weapon                   := Knife;
  Switching        : Boolean                  := False;
  Held_Now         : Weapon                   := Knife;
  Held_Before      : Weapon                   := Knife;
  Slot_Held        : Choice_Flags             := (others => False);
  Frozen           : Boolean                  := False;
  Ended_At         : Real                     := -1.0;
  Was_Alive        : Boolean                  := False;
  Died_At          : Real                     := -9.0;
  Last_View        : Camera;
  Talking          : Boolean                  := False;
  Spoken           : Real                     := 0.0;
  Heard_To         : Natural                  := 0;
  Last_Cued        : Real                     := -9.0;
  Autopilot        : Boolean                  := False;
  Background       : constant World_Heap      := new World;
  Back_Number      : Natural                  := 0;
  Preview_Due      : Boolean                  := False;
  Preview_Wanted   : Boolean                  := False;
  Preview_Area     : Rect;
  Message          : Bounded_Name;
  Message_At       : Real                     := -99.0;
  Shot_Path        : Bounded_Name;
  Choice_Kept      : Start_Options;
  Run_Start        : Real                     := 0.0;
  Run_Last         : Real                     := 0.0;
  Run_Due          : Real                     := 0.0;
  Run_Ended        : Boolean                  := False;
  Load_Step        : Natural                  := 0;
  Load_Status      : Bounded_Name;
  Load_Progress    : Real                     := 0.0;
  Load_Started     : Real                     := 0.0;
  Tab_Open         : Options_Tab              := Gameplay_Tab;
  Kept_Profile     : Profile;
  Capturing        : Boolean                  := False;
  Capture_For      : Player_Action            := Move_Forward;
  Pad_Turn         : Real                     := 0.0;
  Pad_Lift         : Real                     := 0.0;
  Pad_Scores       : Boolean                  := False;
  Mouse_Buttons    : SDL.SDL_MouseButtonFlags := 0;
  Scores_Held      : Boolean                  := False;
  Virtual          : Virtual_Keys             := (others => 0);
  Maps_Found       : Map_List (1..16);
  Map_Count        : Natural                  := 0;
  Recorder         : Tape_Recorder;
  Recording        : Boolean                  := False;
  Record_Name      : Bounded_Name;
  Finder           : Sockets.SOCKET_T         := Sockets.INVALID_SOCKET;
  Servers          : Server_List (1..48);
  Server_Count     : Natural                  := 0;
  Browsing         : Browser_Tab              := LAN_Tab;
  Sorting          : Sort_Key                 := By_Latency;
  Descending       : Boolean                  := False;
  Hide_Full        : Boolean                  := False;
  Hide_Empty       : Boolean                  := False;
  Mode_Filter      : Natural                  := 0;
  Asked_At         : Real                     := -99.0;
  Address_Text     : Bounded_Name;
  Server_First     : Natural                  := 0;
  Replays          : constant Replays_Heap    := new Replay_List (1..64);
  Replay_Count     : Natural                  := 0;
  Replay_First     : Natural                  := 0;
  Replay_Picked    : Natural                  := 1;
  Console_Open     : Boolean                  := False;
  Console_Lines    : Name_Array (1..40);
  Console_Count    : Natural                  := 0;
  Console_Entry    : Bounded_Name;
  Console_Recall   : Bounded_Name;
  Gun_Menu         : Gun_Menu_State           := Closed;
  Group_Shown      : Buy_Group                := Pistols;
  Picked_Kit       : Loadout;
  Resolutions      : Natural_List (1..24)     := (others => 0);
  Resolution_Count : Natural                  := 0;
  Script           : constant Script_Heap     := new Script_Lines;
  Script_Count     : Natural                  := 0;
  Script_Next      : Natural                  := 1;
  Script_Wait      : Natural                  := 0;
  Failures         : Natural                  := 0;
  Checks           : Natural                  := 0;
  Until_Text       : Bounded_Name;
  Until_Left       : Natural                  := 0;
  Skip_Drawing     : Boolean                  := False;
  Pending_Click    : Natural                  := 0;
  Frame_Pace       : Natural                  := 0;

