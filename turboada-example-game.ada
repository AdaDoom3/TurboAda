  -- Widget_Note --
  -----------------

  type Widget_Note is record
      Label : Bounded_Name;
      Area  : Rect;
      Id    : Natural := 0;
    end record;

  type Widget_Notes is array (1..256) of Widget_Note;
  type Notes_Heap   is access Widget_Notes;

  Input      : Frame_Input;
  Cue_Wanted : Menu_Cue            := No_Cue;
  Focus      : Natural             := 1;
  Now        : Real                := 0.0;
  Notes      : constant Notes_Heap := new Widget_Notes;
  Noted      : Natural             := 0;

  function  Note_Named    (Label : String; From : Positive := 1) return Natural;
  procedure Begin_Widgets ;
  procedure End_Widgets   ;
  procedure Consume       ;
  procedure Reset_Focus   (To : Natural := 1);
