  -------------
  -- Display --
  -------------

  LF         : constant String := (1 => ASCII.LF);
  View_Slice : constant        := 0.0625;
  Far_Clip   : constant        := 16_384.0;

  Film_Source : constant String :=
    "vec3 film(vec3 x) { vec3 t = max(x - 0.6, 0.0) / 0.4; return min(x, 0.6) + 0.4 * t / (1.0 " &
    "+ t); } vec3 encode(vec3 c) { c = clamp(c, 0.0, 1.0); return mix(c * 12.92, 1.055 * " &
    "pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); } ";

  Jitter_Source : constant String :=
    "float jitter() { return fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, " &
    "0.00583715)))); } ";

  Depth_Source : constant String :=
    "uniform sampler2D u_depth; uniform vec4 u_clip; float distance_of(float d) { float z = (d " &
    "- u_clip.z) / (1.0 - u_clip.z) * 2.0 - 1.0; return 2.0 * u_clip.x * u_clip.y / (u_clip.y " &
    "+ u_clip.x - z * (u_clip.y - u_clip.x)); } " & Jitter_Source;

  Colour_Science : constant String :=
    "uniform int u_direct; uniform vec3 u_eye; uniform vec4 u_fog; " & Film_Source & "vec3 " &
    "decode_light(vec3 c) { return pow(max(c, vec3(0.0)), vec3(2.2)); } vec3 fogged(vec3 c, " &
    "vec3 p) { return mix(c, u_fog.rgb, clamp(length(p - u_eye) / 9000.0, 0.0, u_fog.a)); } " &
    "vec4 finish(vec3 c, float a) { return u_direct == 1 ? vec4(encode(film(c)), a) : vec4(c, " &
    "a); } " & Jitter_Source;

  Level_Vertex : constant String :=
    "layout(location=0) in vec3 a_pos; layout(location=1) in vec2 a_uv; layout(location=2) in " &
    "vec2 a_lm; layout(location=3) in vec3 a_normal; uniform mat4 u_mvp; out vec2 v_uv; out " &
    "vec2 v_lm; out vec3 v_pos; out vec3 v_normal; void main() { v_uv = a_uv; v_lm = a_lm; " &
    "v_pos = a_pos; v_normal = a_normal; gl_Position = u_mvp * vec4(a_pos, 1.0); } ";

  Light_Shader_Source : constant String :=
    "uniform sampler2DShadow u_moon_static; uniform sampler2DShadow u_moon_moving; uniform " &
    "sampler2DShadow u_torch_map; uniform mat4 u_moon_static_matrix; uniform mat4 " &
    "u_moon_moving_matrix; uniform mat4 u_torch_matrix; uniform vec4 u_moon_dir; uniform vec3 " &
    "u_moon_colour; uniform vec4 u_shadow_texel; uniform vec4 u_torch_place; uniform vec4 " &
    "u_torch_dir; uniform vec3 u_torch_colour; uniform vec4 u_lamp[4]; uniform vec3 " &
    "u_lamp_colour[4]; uniform vec4 u_lamp_aim[4]; uniform int u_flash_shadow; uniform " &
    "sampler2DShadow u_flash_map; uniform mat4 u_flash_matrix; uniform int u_flash_lamp; float " &
    "filtered(sampler2DShadow map, mat4 m, vec3 p, float radius) { vec4 s = m * vec4(p, 1.0); " &
    "if (s.w <= 0.0) return 1.0; vec3 q = s.xyz / s.w; if (q.x <= 0.0 || q.y <= 0.0 || q.x >= " &
    "1.0 || q.y >= 1.0 || q.z >= 1.0) return 1.0; float a = jitter() * 6.2831853; vec2 r = " &
    "radius * vec2(cos(a), sin(a)); vec2 t = vec2(-r.y, r.x); return 0.25 * (texture(map, " &
    "vec3(q.xy + r, q.z)) + texture(map, vec3(q.xy - r, q.z)) + texture(map, vec3(q.xy + t, " &
    "q.z)) + texture(map, vec3(q.xy - t, q.z))); } float moon_static(vec3 p) { return " &
    "filtered(u_moon_static, u_moon_static_matrix, p, u_shadow_texel.x); } float " &
    "moon_moving(vec3 p) { return filtered(u_moon_moving, u_moon_moving_matrix, p, " &
    "u_shadow_texel.y); } float flash_seen(vec3 p, vec3 n) { return filtered(u_flash_map, " &
    "u_flash_matrix, p + n * 0.8, u_shadow_texel.w); } float torch_seen(vec3 p, vec3 n) { if " &
    "(u_torch_place.w <= 0.0 && u_flash_shadow == 0) return 1.0; float r = " &
    "length(u_torch_place.xyz - p); return filtered(u_torch_map, u_torch_matrix, p + n * (0.6 " &
    "+ 0.004 * r), u_shadow_texel.z); } vec3 torch_radiance(vec3 p, out vec3 l) { vec3 d = " &
    "u_torch_place.xyz - p; float r = max(length(d), 1.0e-3); l = d / r; if (u_torch_place.w " &
    "<= 0.0) return vec3(0.0); float cone = dot(-l, u_torch_dir.xyz); if (cone <= 0.6) return " &
    "vec3(0.0); vec3 side = normalize(cross(u_torch_dir.xyz, abs(u_torch_dir.z) > 0.95 ? " &
    "vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0))); vec3 off = -l - u_torch_dir.xyz * cone; " &
    "float rho = length(off) / (cone * 0.577); float turn = atan(dot(off, cross(side, " &
    "u_torch_dir.xyz)), dot(off, side)); float lens = 1.0 + 0.09 * sin(rho * 23.0) * " &
    "smoothstep(0.15, 0.55, rho) + 0.07 * sin(turn * 3.0 + rho * 5.0) * sin(turn * 5.0 - 1.7) " &
    "* rho; float spot = pow(smoothstep(u_torch_dir.w, 1.0, cone), 1.5) * lens; float spill = " &
    "0.13 * smoothstep(0.6, u_torch_dir.w + 0.03, cone) * (1.0 + 0.25 * sin(turn * 2.0 + " &
    "0.6)); float hot = 1.0 + 0.8 * smoothstep(0.975, 0.997, cone); float ring = 1.0 - 0.2 * " &
    "smoothstep(0.93, 0.95, cone) * (1.0 - smoothstep(0.955, 0.975, cone)); float m = r / " &
    "39.37; float w = clamp(1.0 - r / u_torch_place.w, 0.0, 1.0); vec3 glow = u_torch_colour * " &
    "(spot * hot * ring + spill) * w * w / (1.0 + m * m); float peak = max(glow.r, max(glow.g, " &
    "glow.b)); return glow / (1.0 + peak / 2.0); } vec3 lamp_radiance(int i, vec3 p, out vec3 " &
    "l) { vec3 d = u_lamp[i].xyz - p; float r = max(length(d), 1.0e-3); l = d / r; float f = " &
    "clamp(1.0 - r / max(u_lamp[i].w, 1.0e-3), 0.0, 1.0); float a = u_lamp_aim[i].w; float " &
    "cone = a < -1.5 ? 1.0 : smoothstep(a, mix(a, 1.0, 0.5), dot(-l, u_lamp_aim[i].xyz)); " &
    "return decode_light(u_lamp_colour[i] * f * f) * cone; } ";

  Surface_Source : constant String :=
    "vec3 shade(vec3 n, vec3 v, vec3 l, vec3 radiance, vec3 albedo, vec3 f0, float a2, float " &
    "k, float nv) { float nl = max(dot(n, l), 0.0); if (nl <= 0.0) return vec3(0.0); vec3 h = " &
    "normalize(l + v); float nh = max(dot(n, h), 0.0); float vh = clamp(dot(v, h), 0.0, 1.0); " &
    "float q = nh * nh * (a2 - 1.0) + 1.0; float d = a2 / (3.14159265 * q * q); float vis = " &
    "0.25 / ((nl * (1.0 - k) + k) * (nv * (1.0 - k) + k)); vec3 f = f0 + (1.0 - f0) * pow(1.0 " &
    "- vh, 5.0); return ((1.0 - f) * albedo + 3.14159265 * d * vis * f) * radiance * nl; } " &
    "vec3 dynamic_light(vec3 p, vec3 n, vec3 face, vec3 v, vec3 albedo, vec3 f0, float a2, " &
    "float k, float nv) { float seen = torch_seen(p, face); vec3 l; vec3 c = vec3(0.0); vec3 r " &
    "= torch_radiance(p, l); c += shade(n, v, l, r * seen, albedo, f0, a2, k, nv); for (int i " &
    "= 0; i < 4; i++) { r = lamp_radiance(i, p, l); if (r.r + r.g + r.b > 0.0) c += shade(n, " &
    "v, l, r * ((i == 0 && u_flash_shadow == 1) ? seen : (i + 1 == u_flash_lamp ? " &
    "flash_seen(p, face) : 1.0)), albedo, f0, a2, k, nv); } if (u_torch_place.w > 0.0) { float " &
    "near = clamp(1.0 - length(u_eye - p) / 140.0, 0.0, 1.0); c += albedo * u_torch_colour * " &
    "(0.03 * near * near * nv); } return c; } ";

  Stone_Source : constant String :=
    "uniform sampler2D u_wear; uniform vec4 u_wear_box; vec2 hash2(vec2 p) { vec3 q = " &
    "fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973)); q += dot(q, q.yzx + 33.33); return " &
    "fract((q.xx + q.yz) * q.zy); } float hash3(vec3 p) { p = fract(p * 0.3183099 + 0.1); p *= " &
    "17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); } float noise3(vec3 x) { vec3 i " &
    "= floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f); return mix(mix(mix(hash3(i), " &
    "hash3(i + vec3(1.0, 0.0, 0.0)), f.x), mix(hash3(i + vec3(0.0, 1.0, 0.0)), hash3(i + " &
    "vec3(1.0, 1.0, 0.0)), f.x), f.y), mix(mix(hash3(i + vec3(0.0, 0.0, 1.0)), hash3(i + " &
    "vec3(1.0, 0.0, 1.0)), f.x), mix(hash3(i + vec3(0.0, 1.0, 1.0)), hash3(i + vec3(1.0, 1.0, " &
    "1.0)), f.x), f.y), f.z); } vec3 hex_tap(vec2 st, vec2 dx, vec2 dy, vec2 vertex) { vec2 h " &
    "= hash2(vertex); if (u_gloss.w > 2.5) { vec2 count = max(floor(u_grain.xy + 0.5), " &
    "vec2(1.0)); return textureGrad(u_tex, st + floor(h * count) / count, dx, dy).rgb; } float " &
    "a = h.x * 6.2831853; mat2 r = mat2(cos(a), sin(a), -sin(a), cos(a)); vec2 centre = " &
    "vec2(vertex.x + 0.5 * vertex.y, 0.8660254 * vertex.y) / (3.4641016 * u_grain.w); return " &
    "textureGrad(u_tex, r * (st - centre) + centre + h, r * dx, r * dy).rgb; } vec3 " &
    "hex_tiled(vec2 st) { vec2 dx = dFdx(st); vec2 dy = dFdy(st); vec2 g = st * (3.4641016 * " &
    "u_grain.w); vec2 skew = vec2(g.x - 0.57735027 * g.y, 1.15470054 * g.y); vec2 base = " &
    "floor(skew); vec3 t = vec3(fract(skew), 0.0); t.z = 1.0 - t.x - t.y; float s = step(0.0, " &
    "-t.z); float s2 = 2.0 * s - 1.0; vec3 w = vec3(-t.z * s2, s - t.y * s2, s - t.x * s2); " &
    "vec3 c1 = hex_tap(st, dx, dy, base + vec2(s, s)); vec3 c2 = hex_tap(st, dx, dy, base + " &
    "vec2(s, 1.0 - s)); vec3 c3 = hex_tap(st, dx, dy, base + vec2(1.0 - s, s)); vec3 luma = " &
    "vec3(dot(c1, vec3(0.299, 0.587, 0.114)), dot(c2, vec3(0.299, 0.587, 0.114)), dot(c3, " &
    "vec3(0.299, 0.587, 0.114))); vec3 weight = mix(vec3(1.0), luma, 0.6) * pow(max(w, " &
    "vec3(0.0)), vec3(7.0)); weight /= max(weight.x + weight.y + weight.z, 1.0e-5); return " &
    "weight.x * c1 + weight.y * c2 + weight.z * c3; } float fbm3(vec3 p) { return 0.5 * " &
    "noise3(p) + 0.25 * noise3(p * 2.03 + 7.1) + 0.125 * noise3(p * 4.01 + 3.3); } vec3 " &
    "surface_tilt = vec3(0.0); vec3 parquet(vec3 p, vec3 n, inout float rough, inout float " &
    "sheen) { vec3 a = abs(n); bool level = a.z >= max(a.x, a.y); float wide = u_grain.x / " &
    "2.54; float k = floor(u_grain.y / u_grain.x + 0.5); float s = wide / 39.37; vec2 w = " &
    "(level ? p.xy : (a.x >= a.y ? p.yz : p.xz)) / wide; vec2 q = vec2(w.x + w.y, w.y - w.x) * " &
    "0.70710678; vec2 qx = dFdx(q); vec2 qy = dFdy(q); float j = floor(q.y); float run = q.x - " &
    "j; float mh = floor(run / (2.0 * k)); run -= mh * 2.0 * k; float i = floor(q.x); float " &
    "rise = q.y - i - 1.0; float mv = floor(rise / (2.0 * k)); rise -= mv * 2.0 * k; bool " &
    "lying = run < k; vec2 b = lying ? vec2(run, q.y - j) : vec2(rise, q.x - i); vec2 id = " &
    "lying ? vec2(j, mh) : vec2(i + 0.5, mv + 517.0); vec2 bx = lying ? qx : qx.yx; vec2 by = " &
    "lying ? qy : qy.yx; vec2 h = hash2(id * 1.37 + 0.11); vec2 g = hash2(id.yx * 2.71 + 5.3); " &
    "float along = g.y > 0.5 ? s : -s; vec3 c = textureGrad(u_tex, vec2(b.y * s, b.x * along) " &
    "+ h, vec2(bx.y * s, bx.x * along), vec2(by.y * s, by.x * along)).rgb; float strip = " &
    "dot(textureLod(u_tex, vec2(0.5 * s, 0.5 * k * along) + h, 7.5).rgb, vec3(0.299, 0.587, " &
    "0.114)); float whole = dot(textureLod(u_tex, h, 12.0).rgb, vec3(0.299, 0.587, 0.114)); c " &
    "*= mix(1.0, clamp(whole / max(strip, 0.02), 0.7, 1.4), 0.8); c *= (0.96 + 0.07 * g.x) * " &
    "mix(vec3(1.015, 0.995, 0.98), vec3(0.985, 0.995, 1.015), hash2(id + 9.1).x); vec2 edge = " &
    "min(b, vec2(k, 1.0) - b) * wide; vec2 fw = max(vec2(length(vec2(bx.x, by.x)), " &
    "length(vec2(bx.y, by.y))) * wide, vec2(1.0e-4)); vec2 line = (1.0 - smoothstep(vec2(0.0), " &
    "fw, edge - 0.025)) * min(vec2(1.0), 0.05 / fw); float joint = max(line.x, line.y); c *= " &
    "1.0 - 0.55 * joint; vec4 lane = texture(u_wear, (p.xy - u_wear_box.xy) * u_wear_box.zw); " &
    "float trod = lane.r * (1.0 - smoothstep(36.0, 72.0, abs(p.z - lane.g))); float worn = " &
    "smoothstep(0.18, 0.7, trod * (0.7 + 0.6 * noise3(p / 23.0)) + 0.12 * noise3(p / 60.0) - " &
    "0.04); c = mix(c, c * vec3(1.10, 1.08, 1.04) + 0.015, worn * 0.6); rough += 0.22 * worn + " &
    "0.1 * (g.x - 0.5); sheen *= (1.0 - 0.7 * worn) * (0.55 + 0.45 * h.x) * (1.0 - joint); " &
    "surface_tilt = level ? vec3(hash2(id + 3.3) - 0.5, 0.0) * 0.035 : vec3(0.0); return c; } " &
    "vec3 marble(vec3 grain, vec2 st, vec3 p, inout float rough) { vec3 mean = " &
    "textureLod(u_tex, st, 12.0).rgb; float y = dot(mean, vec3(0.299, 0.587, 0.114)); float " &
    "red = smoothstep(0.08, 0.2, max(mean.r, max(mean.g, mean.b)) - min(mean.r, min(mean.g, " &
    "mean.b))); vec3 hue = mix(vec3(y), mean, 0.8); vec3 q = p * 2.54; vec3 w = q / 28.0; w += " &
    "1.6 * vec3(noise3(w * 0.7), noise3(w * 0.7 + 5.2), noise3(w * 0.7 + 9.7)); float fine = " &
    "fbm3(q / 2.2 + 4.0); float cloud = smoothstep(0.28, 0.62, 0.7 * fbm3(w * 1.3) + 0.3 * " &
    "fbm3(w * 5.0 + 2.0) + 0.12 * (fine - 0.44)); float amp = mix(0.62, 0.22, smoothstep(0.35, " &
    "0.7, y)); vec3 m = hue * (1.0 - 0.65 * amp + amp * cloud); bool dark = y < 0.45; vec3 " &
    "pale = dark ? min(mix(vec3(y * 2.3), hue * 1.6, 0.35), vec3(0.82)) : hue * 0.62; float " &
    "flame = smoothstep(0.55, 0.70, fbm3(w * 2.1 + 17.0) + 0.1 * (fine - 0.44)); float vn = " &
    "fbm3(w * 0.5 + 3.0 + 0.06 * fine) * 13.0; float d = abs(fract(vn) - 0.5) * 2.0; float fw " &
    "= fwidth(vn) * 2.0; float width = 0.015 + 0.10 * smoothstep(0.35, 0.8, noise3(q / 11.0 + " &
    "2.0)) * smoothstep(0.2, 0.6, noise3(q / 3.0 + 5.0)); float keep = smoothstep(0.25, 0.6, " &
    "noise3(q / 13.0 + 8.0)) * (1.0 - smoothstep(0.3, 0.7, fw)) * step(0.6, " &
    "fract(sin(floor(vn) * 12.9898) * 43758.5453)); float band = (1.0 - smoothstep(width * " &
    "0.4, width + fw, d)) * keep * width / (width + fw); float halo = (1.0 - smoothstep(width, " &
    "width * 3.5 + fw, d)) * keep; vec3 vein = dark ? vec3(0.74, 0.71, 0.68) + hue * 0.12 : " &
    "hue * 0.5; m = mix(m, pale, flame * 0.75 * (0.4 + 0.6 * red)); m = mix(m, vein, " &
    "clamp(band * 0.8 + halo * 0.3, 0.0, 0.8)); m *= mix(1.0, clamp(dot(grain, vec3(0.299, " &
    "0.587, 0.114)) / max(y, 0.02), 0.75, 1.25), 0.2); rough += 0.06 * flame - 0.05 * band; " &
    "return m; } vec3 material(vec2 st, vec3 p, vec3 n, inout float rough, inout float sheen) " &
    "{ bool boards = u_gloss.w > 3.5 && u_grain.x > 1.5; bool single = u_gloss.w < 0.5 || " &
    "(u_gloss.w > 2.5 && u_grain.x * u_grain.y < 1.5); vec3 c = boards ? parquet(p, n, rough, " &
    "sheen) : (single ? texture(u_tex, st).rgb : hex_tiled(st)); if (u_gloss.w > 0.5 && " &
    "u_gloss.w < 1.5) c = marble(c, st, p, rough); if (u_gloss.w > 0.5) { float broad = 0.65 * " &
    "noise3(p / 420.0) + 0.35 * noise3(p / 1100.0); c *= (0.88 + 0.24 * broad) * " &
    "mix(vec3(1.0), vec3(1.03, 1.0, 0.95), noise3(p / 230.0 + 3.1)); rough += (broad - 0.5) * " &
    "0.2; float near = u_gloss.w > 1.5 && u_gloss.w < 2.5 ? clamp(1.0 - length(p - u_eye) / " &
    "260.0, 0.0, 1.0) : 0.0; if (near > 0.0) { float mean = max(dot(textureLod(u_tex, st, " &
    "12.0).rgb, vec3(0.299, 0.587, 0.114)), 0.02); float close = dot(texture(u_tex, st * 6.13 " &
    "+ vec2(0.37, 0.61)).rgb, vec3(0.299, 0.587, 0.114)) / mean; c *= mix(1.0, clamp(close, " &
    "0.6, 1.4), 0.3 * near); } } return c; } ";

  Level_Fragment : constant String :=
    "uniform sampler2D u_tex; uniform sampler2D u_light; uniform int u_kind; uniform float " &
    "u_time; uniform vec4 u_gloss; uniform vec4 u_grain; uniform vec3 u_moon_baked; uniform " &
    "float u_sky_gain; uniform float u_night; in vec2 v_uv; in vec2 v_lm; in vec3 v_pos; in " &
    "vec3 v_normal; out vec4 o_colour; " & Colour_Science & Light_Shader_Source & Surface_Source &
    Stone_Source & "void main() { if (u_kind == 2) { vec3 d = normalize(v_pos - u_eye); vec2 s " &
    "= vec2(atan(d.y, d.x) / 6.2831853 * 3.0 + u_time * 0.004, 1.0 - clamp(d.z, 0.0, 1.0)); " &
    "o_colour = finish(decode_light(texture(u_tex, s).rgb) * u_sky_gain, 0.0); return; } vec2 " &
    "uv = v_uv; if (u_kind == 1) uv += 0.05 * sin(uv.yx * 6.2831853 + u_time * vec2(0.9, " &
    "0.7)); float rough = u_gloss.x; float sheen = 1.0; vec3 n = normalize(v_normal); n = " &
    "dot(n, u_eye - v_pos) < 0.0 ? -n : n; vec3 base = u_kind == 0 ? material(uv, v_pos, n, " &
    "rough, sheen) : texture(u_tex, uv).rgb; rough = clamp(rough, 0.04, 1.0); vec3 light = " &
    "u_kind == 1 ? vec3(1.0) : texture(u_light, v_lm).rgb * 2.0; vec3 p = v_pos + n * 1.5; " &
    "float lit = (u_moon_dir.w > 0.5 && u_kind == 0) ? max(dot(n, u_moon_dir.xyz), 0.0) : 0.0; " &
    "float open_sky = lit > 0.0 ? moon_static(p) : 0.0; float clear = open_sky > 0.0 ? " &
    "moon_moving(p) : 1.0; light = max(light - u_moon_baked * (lit * open_sky * (1.0 - " &
    "clear)), light * 0.3); if (u_kind == 0) light *= min(pow(max(dot(light, vec3(0.299, " &
    "0.587, 0.114)), 1.0e-4), u_night - 1.0), 1.25); vec3 albedo = decode_light(base); vec3 c " &
    "= albedo * decode_light(light); float polish = 0.0; if (u_kind == 0) { float h = " &
    "dot(base, vec3(0.299, 0.587, 0.114)) * u_gloss.z; vec3 dpx = dFdx(v_pos); vec3 dpy = " &
    "dFdy(v_pos); vec3 r1 = cross(dpy, n); vec3 r2 = cross(n, dpx); float det = dot(dpx, r1); " &
    "vec3 grad = (det < 0.0 ? -1.0 : 1.0) * (dFdx(h) * r1 + dFdy(h) * r2); vec3 nt = " &
    "normalize(n + surface_tilt); vec3 nb = abs(det) > 1.0e-6 ? normalize(abs(det) * nt - " &
    "grad) : nt; vec3 v = normalize(u_eye - v_pos); float nv = clamp(dot(nb, v), 1.0e-4, 1.0); " &
    "float a2 = rough * rough * rough * rough; float k = (rough + 1.0) * (rough + 1.0) / 8.0; " &
    "vec3 f0 = mix(vec3(0.04), albedo, u_gloss.y); c += dynamic_light(v_pos, nb, n, v, albedo " &
    "* (1.0 - u_gloss.y), f0, a2, k, nv); if (lit > 0.0) c += shade(nb, v, u_moon_dir.xyz, " &
    "u_moon_colour * (open_sky * clear), vec3(0.0), f0, a2, k, nv); polish = u_grain.z * sheen " &
    "* clamp(1.0 - (rough - u_gloss.x) * 3.0, 0.0, 1.0); } o_colour = finish(fogged(c, v_pos), " &
    "polish); } ";

  Skin_Source : constant String :=
    "uniform sampler2D u_instances; uniform int u_base; uniform int u_stride; vec4 item(int i) " &
    "{ int k = u_base + gl_InstanceID * u_stride + i; return texelFetch(u_instances, ivec2(k & " &
    "1023, k >> 10), 0); } vec3 turn(vec4 q, vec3 v) { return v + 2.0 * cross(q.xyz, " &
    "cross(q.xyz, v) + q.w * v); } vec3 place(vec4 w, float j) { if (w.w <= 0.0) return " &
    "vec3(0.0); int k = 12 + int(j + 0.5) * 3; return w.w * (item(k + 1).xyz + turn(item(k), " &
    "w.xyz)); } vec3 skinned() { return place(a_w0, a_joint.x) + place(a_w1, a_joint.y) + " &
    "place(a_w2, a_joint.z) + place(a_w3, a_joint.w); } vec3 world_of(vec3 p) { vec4 h = " &
    "vec4(p, 1.0); return vec3(dot(item(0), h), dot(item(1), h), dot(item(2), h)); } ";

  Skin_Inputs : constant String :=
    "layout(location=0) in vec4 a_w0; layout(location=1) in vec4 a_w1; layout(location=2) in " &
    "vec4 a_w2; layout(location=3) in vec4 a_w3; layout(location=4) in vec4 a_joint; uniform " &
    "mat4 u_mvp; ";

  Model_Vertex : constant String :=
    Skin_Inputs & "layout(location=5) in vec3 a_normal; layout(location=6) in vec4 a_tangent; " &
    "layout(location=7) in vec2 a_uv; layout(location=8) in vec3 a_light; out vec2 v_uv; out " &
    "vec3 v_normal; out vec4 v_tangent; out vec3 v_light; out vec3 v_pos; flat out vec4 " &
    "v_tint; flat out vec4 v_ambient; flat out vec4 v_team; flat out vec4 v_key0; flat out " &
    "vec4 v_key1; flat out vec4 v_key2; flat out vec3 v_hue0; flat out vec3 v_hue1; flat out " &
    "vec3 v_hue2; " & Skin_Source & "vec3 spun(vec4 w, float j, vec3 v) { return w.w <= 0.0 ? " &
    "vec3(0.0) : w.w * turn(item(12 + int(j + 0.5) * 3 + 2), v); } vec3 spin(vec3 v) { return " &
    "spun(a_w0, a_joint.x, v) + spun(a_w1, a_joint.y, v) + spun(a_w2, a_joint.z, v) + " &
    "spun(a_w3, a_joint.w, v); } vec3 world_dir(vec3 v) { return vec3(dot(item(0).xyz, v), " &
    "dot(item(1).xyz, v), dot(item(2).xyz, v)); } void main() { v_pos = world_of(skinned()); " &
    "v_normal = world_dir(spin(a_normal)); v_tangent = vec4(world_dir(spin(a_tangent.xyz)), " &
    "a_tangent.w); v_uv = a_uv; v_light = a_light; v_tint = item(3); v_ambient = item(4); " &
    "v_team = item(5); v_key0 = item(6); v_key1 = item(7); v_key2 = item(8); v_hue0 = " &
    "item(9).rgb; v_hue1 = item(10).rgb; v_hue2 = item(11).rgb; gl_Position = u_mvp * " &
    "vec4(v_pos, 1.0); } ";

  Caster_Vertex : constant String :=
    Skin_Inputs & Skin_Source & "void main() { gl_Position = u_mvp * vec4(world_of(skinned()), " &
    "1.0); } ";

  Level_Caster_Vertex : constant String :=
    "layout(location=0) in vec3 a_pos; uniform mat4 u_mvp; void main() { gl_Position = u_mvp * " &
    "vec4(a_pos, 1.0); } ";

  Caster_Fragment : constant String :=
    "void main() { } ";

  Model_Fragment : constant String :=
    "uniform sampler2D u_tex; uniform sampler2D u_normal; uniform sampler2D u_packed; uniform " &
    "sampler2D u_team; uniform float u_night; in vec2 v_uv; in vec3 v_normal; in vec4 " &
    "v_tangent; in vec3 v_light; in vec3 v_pos; flat in vec4 v_tint; flat in vec4 v_ambient; " &
    "flat in vec4 v_team; flat in vec4 v_key0; flat in vec4 v_key1; flat in vec4 v_key2; flat " &
    "in vec3 v_hue0; flat in vec3 v_hue1; flat in vec3 v_hue2; out vec4 o_colour; " &
    Colour_Science & Light_Shader_Source & Surface_Source
      & "vec2 split_sum(float r, float nv) { vec4 " &
    "q = r * vec4(-1.0, -0.0275, -0.572, 0.022) + vec4(1.0, 0.0425, 1.04, -0.04); float a = " &
    "min(q.x * q.x, exp2(-9.28 * nv)) * q.x + q.y; return vec2(-1.04, 1.04) * a + q.zw; } vec3 " &
    "toward(vec4 key) { return key.w > 0.5 ? normalize(key.xyz - v_pos) : key.xyz; } void " &
    "main() { vec4 base = texture(u_tex, v_uv) * vec4(v_tint.rgb * v_tint.rgb, v_tint.a); " &
    "float grey = dot(base.rgb, vec3(0.2126, 0.7152, 0.0722)); base.rgb = mix(base.rgb, " &
    "v_team.rgb * grey * 2.5, texture(u_team, v_uv).r * step(0.001, dot(v_team.rgb, " &
    "vec3(1.0)))); vec3 orm = texture(u_packed, v_uv).rgb; float ao = orm.r; float rough = " &
    "clamp(orm.g, 0.05, 1.0); float metal = orm.b; vec2 nxy = texture(u_normal, v_uv).rg * 2.0 " &
    "- 1.0; vec3 nt = vec3(nxy, sqrt(max(1.0 - dot(nxy, nxy), 0.0))); vec3 face = " &
    "normalize(cross(dFdx(v_pos), dFdy(v_pos))); face = dot(face, u_eye - v_pos) < 0.0 ? -face " &
    ": face; vec3 n0 = dot(v_normal, v_normal) > 1.0e-12 ? normalize(v_normal) : face; n0 = " &
    "dot(n0, face) < 0.0 ? -n0 : n0; vec3 t0 = v_tangent.xyz - n0 * dot(n0, v_tangent.xyz); t0 " &
    "= dot(t0, t0) > 1.0e-8 ? normalize(t0) : vec3(0.0); vec3 b0 = cross(n0, t0) * " &
    "v_tangent.w; vec3 n = normalize(t0 * nt.x + b0 * nt.y + n0 * max(nt.z, 0.05)); vec3 v = " &
    "normalize(u_eye - v_pos); float nv = clamp(dot(n, v), 1.0e-4, 1.0); bool baked = v_team.a " &
    "> 0.5; vec3 colour = baked ? decode_light(base.rgb) : base.rgb; vec3 f0 = mix(vec3(0.04), " &
    "colour, metal); vec3 albedo = colour * (1.0 - metal); float a2 = rough * rough * rough * " &
    "rough; float k = (rough + 1.0) * (rough + 1.0) / 8.0; float shaded = mix(1.0, ao, 0.5); " &
    "vec3 c = vec3(0.0); if (baked) { vec3 b = v_light * 2.0; if (u_night > 0.5) b *= " &
    "min(pow(max(dot(b, vec3(0.299, 0.587, 0.114)), 1.0e-4), u_night - 1.0), 1.25); c = colour " &
    "* decode_light(b) * ao; } else { c += shade(n, v, toward(v_key0), v_hue0, albedo, f0, a2, " &
    "k, nv) * shaded; c += shade(n, v, toward(v_key1), v_hue1, albedo, f0, a2, k, nv) * " &
    "shaded; c += shade(n, v, toward(v_key2), v_hue2, albedo, f0, a2, k, nv) * shaded; vec3 " &
    "sky = v_ambient.rgb * (0.8 + 0.2 * n.z); vec2 e = split_sum(rough, nv); c += (albedo * " &
    "sky + (f0 * e.x + e.y) * sky * 0.6) * ao; c += pow(1.0 - nv, 4.0) * v_ambient.a * " &
    "(v_ambient.rgb * 0.5 + vec3(0.012)) * ao; c *= min(pow(max(dot(v_ambient.rgb, vec3(0.299, " &
    "0.587, 0.114)) / 0.6, 1.0e-4), u_night - 1.0), 1.25); if (u_moon_dir.w > 0.5 && dot(n0, " &
    "u_moon_dir.xyz) > -0.2) { vec3 q = v_pos + n0 * 1.2 + u_moon_dir.xyz * 0.8; float m = " &
    "moon_static(q); if (m > 0.0) { m *= moon_moving(q); c += shade(n, v, u_moon_dir.xyz, " &
    "u_moon_colour * m, albedo, f0, a2, k, nv) * shaded; } } } c += dynamic_light(v_pos, n, " &
    "n0, v, albedo, f0, a2, k, nv) * shaded; o_colour = finish(fogged(c, v_pos), 0.0); } ";

  Shadow_Vertex : constant String :=
    "layout(location=0) in vec3 a_pos; layout(location=1) in vec3 a_blob; uniform mat4 u_mvp; " &
    "out vec3 v_blob; void main() { v_blob = a_blob; gl_Position = u_mvp * vec4(a_pos, 1.0); } ";

  Shadow_Fragment : constant String :=
    "in vec3 v_blob; out vec4 o_colour; void main() { float r = clamp(1.0 - length(v_blob.xy), " &
    "0.0, 1.0); o_colour = vec4(0.0, 0.0, 0.0, v_blob.z * r * r * (3.0 - 2.0 * r)); } ";

  Glow_Vertex : constant String :=
    "layout(location=0) in vec2 a_corner; uniform mat4 u_mvp; uniform vec4 u_centre; uniform " &
    "vec3 u_across; uniform vec3 u_upward; out vec2 v_uv; void main() { v_uv = a_corner; vec3 " &
    "p = u_centre.xyz + 0.5 * u_centre.w * (a_corner.x * u_across + a_corner.y * u_upward); " &
    "gl_Position = u_mvp * vec4(p, 1.0); } ";

  Glow_Fragment : constant String :=
    "uniform vec4 u_glow; uniform float u_seed; uniform int u_direct; in vec2 v_uv; out vec4 " &
    "o_colour; " & Depth_Source & "vec3 linear(vec3 c) { return u_direct == 1 ? c : pow(max(c, " &
    "vec3(0.0)), vec3(2.2)); } void main() { float r = length(v_uv); float a = atan(v_uv.y, " &
    "v_uv.x) + u_seed; if (u_glow.a > 1.5) { float n = 0.5 + 0.5 * sin(2.1 * v_uv.x + u_seed) " &
    "* cos(1.7 * v_uv.y - 1.3 * u_seed); float soft = 1.0; if (u_clip.w > 0.5) { float behind " &
    "= distance_of(texelFetch(u_depth, ivec2(gl_FragCoord.xy), 0).r) - " &
    "distance_of(gl_FragCoord.z); soft = clamp(behind / 28.0, 0.0, 1.0); } o_colour = " &
    "vec4(linear(u_glow.rgb * (0.9 + 0.2 * n - 0.08 * v_uv.y)), soft * (u_glow.a - 2.0) * (1.0 " &
    "- smoothstep(0.15 + 0.2 * n, 1.0, r))); return; } float rays = pow(abs(cos(a * 2.5)), " &
    "12.0) * max(1.0 - r, 0.0) + pow(abs(cos(a * 3.5 + 1.3)), 24.0) * max(1.0 - 1.3 * r, 0.0); " &
    "float k = (exp(-r * r * 9.0) + 0.8 * rays) * (1.0 - smoothstep(0.7, 1.0, r)); o_colour = " &
    "vec4(linear(u_glow.rgb) * k * (u_direct == 1 ? 1.0 : 3.0), 1.0); } ";

  Screen_Vertex : constant String :=
    "out vec2 v_uv; void main() { vec2 p = vec2(float((gl_VertexID << 1) & 2), " &
    "float(gl_VertexID & 2)); v_uv = p; gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0); } ";

  Occlusion_Fragment : constant String :=
    "uniform vec4 u_lens; in vec2 v_uv; out vec4 o_colour; " & Depth_Source & "vec3 " &
    "seen_at(vec2 uv) { float z = distance_of(texture(u_depth, uv).r); return vec3((uv * 2.0 - " &
    "1.0) * u_lens.xy * z, z); } void main() { float d = texture(u_depth, v_uv).r; if (d >= " &
    "0.99999 || d < u_clip.z) { o_colour = vec4(1.0); return; } vec3 p = seen_at(v_uv); vec3 n " &
    "= -normalize(cross(dFdx(p), dFdy(p))); float a0 = jitter() * 6.2831853; float sum = 0.0; " &
    "vec2 reach = 0.5 * u_lens.z / (p.z * u_lens.xy); for (int i = 0; i < 8; i++) { float t = " &
    "(float(i) + 0.5) / 8.0; float angle = a0 + t * 18.849556; vec3 q = seen_at(v_uv + " &
    "vec2(cos(angle), sin(angle)) * t * reach); vec3 w = q - p; float ww = dot(w, w); sum += " &
    "max(dot(w, n) * inversesqrt(ww + 1.0e-4) - 0.12, 0.0) * max(1.0 - ww / (u_lens.z * " &
    "u_lens.z), 0.0); } o_colour = vec4(clamp(1.0 - u_lens.w * sum / 8.0, 0.0, 1.0), 0.0, 0.0, " &
    "1.0); } ";

  Apply_Occlusion_Fragment : constant String :=
    "uniform sampler2D u_ao; uniform vec2 u_texel; in vec2 v_uv; out vec4 o_colour; " &
    Depth_Source & "void main() { float d0 = distance_of(texture(u_depth, v_uv).r); float sum " &
    "= 0.0; float w = 0.0; for (int j = -1; j <= 1; j++) { for (int i = -1; i <= 1; i++) { " &
    "vec2 uv = v_uv + vec2(float(i), float(j)) * u_texel; float weight = 1.0 / (1.0 + " &
    "abs(distance_of(texture(u_depth, uv).r) - d0) * 0.25); sum += texture(u_ao, uv).r * " &
    "weight; w += weight; } } o_colour = vec4(vec3(sum / w), 1.0); } ";

  Down_Fragment : constant String :=
    "uniform sampler2D u_source; uniform vec2 u_texel; uniform vec4 u_knee; in vec2 v_uv; out " &
    "vec4 o_colour; vec3 tap(vec2 o) { vec3 c = texture(u_source, v_uv + o * u_texel).rgb; " &
    "return u_knee.z > 0.5 ? c / (1.0 + max(c.r, max(c.g, c.b))) : c; } void main() { vec3 c = " &
    "0.25 * (tap(vec2(-1.0, -1.0)) + tap(vec2(1.0, -1.0)) + tap(vec2(-1.0, 1.0)) + " &
    "tap(vec2(1.0, 1.0))); if (u_knee.z > 0.5) { c = c / max(1.0 - max(c.r, max(c.g, c.b)), " &
    "0.02); float l = max(c.r, max(c.g, c.b)); float soft = clamp(l - u_knee.x + u_knee.y, " &
    "0.0, 2.0 * u_knee.y); soft = soft * soft / (4.0 * u_knee.y + 1.0e-4); c *= max(soft, l - " &
    "u_knee.x) / max(l, 1.0e-4); } o_colour = vec4(c, 1.0); } ";

  Up_Fragment : constant String :=
    "uniform sampler2D u_source; uniform vec2 u_texel; uniform float u_weight; in vec2 v_uv; " &
    "out vec4 o_colour; vec3 tap(float x, float y) { return texture(u_source, v_uv + vec2(x, " &
    "y) * u_texel).rgb; } void main() { vec3 s = tap(-1.0, -1.0) + 2.0 * tap(0.0, -1.0) + " &
    "tap(1.0, -1.0) + 2.0 * tap(-1.0, 0.0) + 4.0 * tap(0.0, 0.0) + 2.0 * tap(1.0, 0.0) + " &
    "tap(-1.0, 1.0) + 2.0 * tap(0.0, 1.0) + tap(1.0, 1.0); o_colour = vec4(s * (u_weight / " &
    "16.0), 1.0); } ";

  Composite_Fragment : constant String :=
    "uniform sampler2D u_scene; uniform sampler2D u_bloom; uniform vec4 u_focus; uniform vec2 " &
    "u_texel; uniform vec4 u_tweak; uniform vec3 u_light_tint; uniform vec3 u_dark_tint; " &
    "uniform vec4 u_finish; in vec2 v_uv; out vec4 o_colour; " & Depth_Source & Film_Source &
    "float held_distance(float d) { float z = d / u_clip.z * 2.0 - 1.0; return 2.0 * u_focus.x " &
    "* u_focus.y / (u_focus.y + u_focus.x - z * (u_focus.y - u_focus.x)); } void main() { vec3 " &
    "c = texture(u_scene, v_uv).rgb; float d = texture(u_depth, v_uv).r; if (d < u_clip.z) { " &
    "float coc = clamp((u_focus.z - held_distance(d)) / (0.6 * u_focus.z), 0.0, 1.0) * " &
    "u_focus.w; if (coc > 0.5) { vec3 sum = c; float w = 1.0; for (int i = 0; i < 12; i++) { " &
    "float t = (float(i) + 0.5) / 12.0; float a = float(i) * 2.39996323; vec2 o = vec2(cos(a), " &
    "sin(a)) * sqrt(t) * coc * u_texel; if (texture(u_depth, v_uv + o).r < u_clip.z) { sum += " &
    "texture(u_scene, v_uv + o).rgb; w += 1.0; } } c = sum / w; } } c += texture(u_bloom, " &
    "v_uv).rgb * u_finish.x; vec3 g = encode(film(c * u_tweak.w)); float l = dot(g, " &
    "vec3(0.2126, 0.7152, 0.0722)); g = mix(g, vec3(l), u_tweak.z); g = (g - 0.5) * u_tweak.x " &
    "+ 0.5 + u_tweak.y; g *= mix(u_dark_tint, u_light_tint, clamp(l * 1.4, 0.0, 1.0)); vec2 e " &
    "= v_uv - 0.5; g *= 1.0 - u_finish.y * dot(e, e) * 2.0; g += (fract(52.9829189 * " &
    "fract(dot(gl_FragCoord.xy + vec2(u_finish.w * 61.0, u_finish.w * 37.0), vec2(0.06711056, " &
    "0.00583715)))) - 0.5) * u_finish.z; g = clamp(g, 0.0, 1.0); o_colour = vec4(g, dot(g, " &
    "vec3(0.299, 0.587, 0.114))); } ";

  Final_Fragment : constant String :=
    "uniform sampler2D u_graded; uniform sampler2D u_depth; uniform vec2 u_texel; uniform vec2 " &
    "u_smooth; in vec2 v_uv; out vec4 o_colour; vec4 at(float x, float y) { return " &
    "texture(u_graded, v_uv + vec2(x, y) * u_texel); } void main() { vec4 m = at(0.0, 0.0); " &
    "vec4 n = at(0.0, 1.0); vec4 s = at(0.0, -1.0); vec4 w = at(-1.0, 0.0); vec4 e = at(1.0, " &
    "0.0); float low = min(m.a, min(min(n.a, s.a), min(w.a, e.a))); float high = max(m.a, " &
    "max(max(n.a, s.a), max(w.a, e.a))); vec3 c = m.rgb; if (u_smooth.x > 0.5 && high - low > " &
    "max(0.0312, high * 0.125)) { float nw = at(-1.0, 1.0).a; float ne = at(1.0, 1.0).a; float " &
    "sw = at(-1.0, -1.0).a; float se = at(1.0, -1.0).a; vec2 dir = vec2(-((nw + ne) - (sw + " &
    "se)), (ne + se) - (nw + sw)); float reduce = max((nw + ne + sw + se) * 0.03125, 1.0 / " &
    "128.0); dir = clamp(dir / (min(abs(dir.x), abs(dir.y)) + reduce), vec2(-8.0), vec2(8.0)) " &
    "* u_texel; vec3 a = 0.5 * (texture(u_graded, v_uv - dir / 6.0).rgb + texture(u_graded, " &
    "v_uv + dir / 6.0).rgb); vec3 b = 0.5 * a + 0.25 * (texture(u_graded, v_uv - dir * " &
    "0.5).rgb + texture(u_graded, v_uv + dir * 0.5).rgb); float lb = dot(b, vec3(0.299, 0.587, " &
    "0.114)); c = (lb < low || lb > high) ? a : b; } else { vec3 lo = min(m.rgb, " &
    "min(min(n.rgb, s.rgb), min(w.rgb, e.rgb))); vec3 hi = max(m.rgb, max(max(n.rgb, s.rgb), " &
    "max(w.rgb, e.rgb))); c = clamp(c + u_smooth.y * (4.0 * c - n.rgb - s.rgb - w.rgb - " &
    "e.rgb), lo, hi); } o_colour = vec4(c, 1.0); gl_FragDepth = texture(u_depth, v_uv).r; } ";

  Reflect_Fragment : constant String :=
    "uniform sampler2D u_scene; uniform vec4 u_lens; in vec2 v_uv; out vec4 o_colour; " &
    Depth_Source & "vec3 seen_at(vec2 uv) { float z = distance_of(texture(u_depth, uv).r); " &
    "return vec3((uv * 2.0 - 1.0) * u_lens.xy * z, z); } vec2 screen_of(vec3 q) { return 0.5 + " &
    "0.5 * q.xy / (q.z * u_lens.xy); } void main() { float polish = texture(u_scene, v_uv).a; " &
    "float d = texture(u_depth, v_uv).r; if (polish < 0.02 || d >= 0.99999 || d < u_clip.z) { " &
    "o_colour = vec4(0.0); return; } vec3 p = seen_at(v_uv); vec3 n = " &
    "-normalize(cross(dFdx(p), dFdy(p))); vec3 e = normalize(p); vec3 r = reflect(e, n); float " &
    "f0 = 0.04 + 0.96 * polish * polish * polish * polish; float fresnel = f0 + (1.0 - f0) * " &
    "pow(1.0 - clamp(dot(-e, n), 0.0, 1.0), 5.0); float stride = max(3.0, 0.02 * p.z); vec3 q " &
    "= p + r * stride * (0.5 + jitter()); vec3 found = vec3(0.0); float seen = 0.0; for (int i " &
    "= 0; i < 24; i++) { if (q.z <= 2.5) break; vec2 uv = screen_of(q); if (uv.x <= 0.0 || " &
    "uv.y <= 0.0 || uv.x >= 1.0 || uv.y >= 1.0) break; float scene = " &
    "distance_of(texture(u_depth, uv).r); if (q.z > scene && q.z - scene < stride * 2.0 + 6.0) " &
    "{ vec3 a = q - r * stride; vec3 b = q; for (int k = 0; k < 4; k++) { vec3 m = 0.5 * (a + " &
    "b); if (m.z > distance_of(texture(u_depth, screen_of(m)).r)) b = m; else a = m; } vec2 " &
    "hit = screen_of(b); vec2 edge = min(hit, 1.0 - hit); seen = clamp(min(edge.x, edge.y) * " &
    "12.0, 0.0, 1.0) * (1.0 - float(i) / 24.0); vec2 spread = (hit - v_uv) * (1.0 - polish) * " &
    "0.2; vec2 side = vec2(-spread.y, spread.x) * 0.35; found = 0.36 * texture(u_scene, " &
    "hit).rgb + 0.2 * (texture(u_scene, clamp(hit + spread, 0.0, 1.0)).rgb + texture(u_scene, " &
    "clamp(hit - spread, 0.0, 1.0)).rgb) + 0.12 * (texture(u_scene, clamp(hit + side, 0.0, " &
    "1.0)).rgb + texture(u_scene, clamp(hit - side, 0.0, 1.0)).rgb); break; } q += r * stride; " &
    "stride *= 1.15; } o_colour = vec4(found * (seen * polish * fresnel), 0.0); } ";

  Slug_Vertex : constant String :=
    "layout(location=0) in vec3 a_pos; layout(location=1) in vec2 a_dir; layout(location=2) in " &
    "vec2 a_em; layout(location=3) in vec4 a_glyph; layout(location=4) in vec4 a_box; " &
    "layout(location=5) in vec4 a_colour; layout(location=6) in vec3 a_across; " &
    "layout(location=7) in vec3 a_up; uniform mat4 u_mvp; uniform vec2 u_viewport; out vec2 " &
    "v_em; flat out vec4 v_glyph; flat out vec4 v_box; out vec4 v_colour; vec2 screen(vec3 p) " &
    "{ vec4 c = u_mvp * vec4(p, 1.0); return c.xy / c.w * u_viewport * 0.5; } void main() { " &
    "vec2 s0 = screen(a_pos); float kx = max(length(screen(a_pos + a_across) - s0), 1.0e-4); " &
    "float ky = max(length(screen(a_pos + a_up) - s0), 1.0e-4); vec2 d = vec2(0.5 * a_dir.x / " &
    "kx, 0.5 * a_dir.y / ky); vec3 p = a_pos + d.x * a_across + d.y * a_up; v_em = a_em + d * " &
    "a_box.zw; v_glyph = a_glyph; v_box = a_box; v_colour = a_colour; gl_Position = u_mvp * " &
    "vec4(p, 1.0); } ";

  Slug_Fragment : constant String :=
    "uniform sampler2D u_curves; uniform sampler2D u_bands; in vec2 v_em; flat in vec4 " &
    "v_glyph; flat in vec4 v_box; in vec4 v_colour; out vec4 o_colour; vec4 fetch(sampler2D t, " &
    "int i) { return texelFetch(t, ivec2(i & 4095, i >> 12), 0); } void main() { vec2 rc = " &
    "v_em; vec2 ppe = 1.0 / max(fwidth(rc), vec2(1.0e-6)); int start = int(v_glyph.x); int n = " &
    "int(v_glyph.y); vec2 lo = v_glyph.zw; vec2 hi = v_box.xy; vec2 size = max(hi - lo, " &
    "vec2(1.0e-6)); int hb = clamp(int((rc.y - lo.y) / size.y * float(n)), 0, n - 1); int vb = " &
    "clamp(int((rc.x - lo.x) / size.x * float(n)), 0, n - 1); vec4 hh = fetch(u_bands, start + " &
    "hb); vec4 vh = fetch(u_bands, start + n + vb); float xcov = 0.0, xwgt = 0.0, ycov = 0.0, " &
    "ywgt = 0.0; for (int k = 0; k < int(hh.x); k++) { int ci = int(fetch(u_bands, int(hh.y) + " &
    "k).x); vec4 a = fetch(u_curves, ci); vec4 b = fetch(u_curves, ci + 1); vec2 p1 = a.xy - " &
    "rc; vec2 p2 = a.zw - rc; vec2 p3 = b.xy - rc; if (max(max(p1.x, p2.x), p3.x) * ppe.x < " &
    "-0.5) break; uint code = (0x2E74u >> (((p1.y > 0.0) ? 2u : 0u) + ((p2.y > 0.0) ? 4u : 0u) " &
    "+ ((p3.y > 0.0) ? 8u : 0u))) & 3u; if (code != 0u) { vec2 qa = p1 - p2 * 2.0 + p3; vec2 " &
    "qb = p1 - p2; float d = sqrt(max(qb.y * qb.y - qa.y * p1.y, 0.0)); float t1 = (qb.y - d) " &
    "/ qa.y; float t2 = (qb.y + d) / qa.y; if (abs(qa.y) < 1.0e-5) { t1 = p1.y * 0.5 / qb.y; " &
    "t2 = t1; } float x1 = ((qa.x * t1 - qb.x * 2.0) * t1 + p1.x) * ppe.x; float x2 = ((qa.x * " &
    "t2 - qb.x * 2.0) * t2 + p1.x) * ppe.x; if ((code & 1u) != 0u) { xcov += clamp(x1 + 0.5, " &
    "0.0, 1.0); xwgt = max(xwgt, clamp(1.0 - abs(x1) * 2.0, 0.0, 1.0)); } if (code > 1u) { " &
    "xcov -= clamp(x2 + 0.5, 0.0, 1.0); xwgt = max(xwgt, clamp(1.0 - abs(x2) * 2.0, 0.0, " &
    "1.0)); } } } for (int k = 0; k < int(vh.x); k++) { int ci = int(fetch(u_bands, int(vh.y) " &
    "+ k).x); vec4 a = fetch(u_curves, ci); vec4 b = fetch(u_curves, ci + 1); vec2 p1 = a.yx - " &
    "rc.yx; vec2 p2 = a.wz - rc.yx; vec2 p3 = b.yx - rc.yx; if (max(max(p1.x, p2.x), p3.x) * " &
    "ppe.y < -0.5) break; uint code = (0x2E74u >> (((p1.y > 0.0) ? 2u : 0u) + ((p2.y > 0.0) ? " &
    "4u : 0u) + ((p3.y > 0.0) ? 8u : 0u))) & 3u; if (code != 0u) { vec2 qa = p1 - p2 * 2.0 + " &
    "p3; vec2 qb = p1 - p2; float d = sqrt(max(qb.y * qb.y - qa.y * p1.y, 0.0)); float t1 = " &
    "(qb.y - d) / qa.y; float t2 = (qb.y + d) / qa.y; if (abs(qa.y) < 1.0e-5) { t1 = p1.y * " &
    "0.5 / qb.y; t2 = t1; } float y1 = ((qa.x * t1 - qb.x * 2.0) * t1 + p1.x) * ppe.y; float " &
    "y2 = ((qa.x * t2 - qb.x * 2.0) * t2 + p1.x) * ppe.y; if ((code & 1u) != 0u) { ycov -= " &
    "clamp(y1 + 0.5, 0.0, 1.0); ywgt = max(ywgt, clamp(1.0 - abs(y1) * 2.0, 0.0, 1.0)); } if " &
    "(code > 1u) { ycov += clamp(y2 + 0.5, 0.0, 1.0); ywgt = max(ywgt, clamp(1.0 - abs(y2) * " &
    "2.0, 0.0, 1.0)); } } } float coverage = max(abs(xcov * xwgt + ycov * ywgt) / max(xwgt + " &
    "ywgt, 1.0 / 65536.0), min(abs(xcov), abs(ycov))); o_colour = vec4(v_colour.rgb, " &
    "v_colour.a * clamp(coverage, 0.0, 1.0)); } ";

  Mote_Vertex : constant String :=
    "layout(location=0) in vec3 a_centre; layout(location=1) in vec3 a_along; " &
    "layout(location=2) in vec3 a_side; layout(location=3) in vec4 a_colour; " &
    "layout(location=4) in vec2 a_shape; uniform mat4 u_mvp; out vec2 v_uv; out vec4 v_colour; " &
    "flat out vec2 v_shape; const vec2 corners[6] = vec2[6](vec2(-1.0, -1.0), vec2(1.0, -1.0), " &
    "vec2(1.0, 1.0), vec2(-1.0, -1.0), vec2(1.0, 1.0), vec2(-1.0, 1.0)); void main() { vec2 c " &
    "= corners[gl_VertexID]; v_uv = c; v_colour = a_colour; v_shape = a_shape; gl_Position = " &
    "u_mvp * vec4(a_centre + c.y * a_along + c.x * a_side, 1.0); } ";

  Mote_Fragment : constant String :=
    "uniform int u_direct; in vec2 v_uv; in vec4 v_colour; flat in vec2 v_shape; out vec4 " &
    "o_colour; " & Depth_Source & Film_Source & "float bumps(vec2 p, float s) { return 0.5 + " &
    "0.25 * sin(p.x * 3.1 + s * 7.0) * cos(p.y * 2.7 - s * 5.0) + 0.25 * sin((p.x + p.y) * 5.3 " &
    "+ s * 11.0); } vec3 shown(vec3 c) { return u_direct == 0 ? c : encode(film(c)); } void " &
    "main() { int shape = int(v_shape.x + 0.5); float s = v_shape.y; vec2 p = v_uv; float r = " &
    "length(p); vec3 c = v_colour.rgb; float cover = 0.0; float glow = 0.0; float reach = 2.0; " &
    "if (shape == 0) { float n = bumps(p * 1.3, s); float m = bumps(p * 3.1 + 3.0, s * 1.7); " &
    "cover = exp(-r * r * 3.2) * (1.0 - smoothstep(0.55, 1.0, r)) * (0.55 + 0.5 * n + 0.3 * (m " &
    "- 0.5)); c *= 0.85 + 0.3 * n - 0.15 * p.y; reach = 14.0; } else if (shape == 1) { float " &
    "core = exp(-p.x * p.x * 7.0) * (1.0 - smoothstep(0.55, 1.0, abs(p.y))) * (0.55 + 0.45 * " &
    "(p.y * 0.5 + 0.5)); glow = core; c = mix(c, vec3(1.0, 0.95, 0.85) * max(c.r, max(c.g, " &
    "c.b)), exp(-p.x * p.x * 30.0) * 0.6); } else if (shape == 2) { float a = atan(p.y, p.x); " &
    "float edge = 0.62 + 0.22 * sin(a * 3.0 + s * 6.0) * cos(a * 2.0 - s * 4.0) + 0.1 * sin(a " &
    "* 7.0 + s * 9.0); cover = 1.0 - smoothstep(edge - 1.5 * fwidth(r), edge, r); float facet " &
    "= fract(sin(floor((a + 3.1416) * 0.95) * 12.9898 + s * 78.233) * 43758.5453); c *= 0.7 + " &
    "0.55 * facet + 0.15 * (p.x - p.y); } else if (shape == 3) { cover = 1.0 - " &
    "smoothstep(0.62, 0.95, r + 0.08 * sin(atan(p.y, p.x) * 5.0 + s * 8.0)); c *= 0.75 + 0.35 " &
    "* (1.0 - r); c += 0.6 * c * exp(-dot(p - vec2(-0.25, 0.3), p - vec2(-0.25, 0.3)) * 25.0); " &
    "} else { vec2 q = abs(p); float tri = max(q.x * 0.866 + p.y * 0.5, -p.y) + 0.12 * sin(s * " &
    "9.0 + p.x * 4.0); cover = (1.0 - smoothstep(0.62, 0.7, tri)) * (0.35 + 0.65 * " &
    "smoothstep(0.35, 0.68, tri)); glow = 0.25 * smoothstep(0.5, 0.68, tri) * (1.0 - " &
    "smoothstep(0.68, 0.72, tri)); } float soft = 1.0; if (u_clip.w > 0.5) { float behind = " &
    "distance_of(texelFetch(u_depth, ivec2(gl_FragCoord.xy), 0).r) - " &
    "distance_of(gl_FragCoord.z); soft = clamp(behind / reach, 0.0, 1.0); } float alpha = " &
    "clamp(v_colour.a * cover * soft, 0.0, 1.0); o_colour = vec4(shown(c) * alpha + shown(c * " &
    "glow * v_colour.a * soft), alpha); } ";

  Scar_Vertex : constant String :=
    "layout(location=0) in vec3 a_pos; layout(location=1) in vec2 a_uv; layout(location=2) in " &
    "vec3 a_tint; layout(location=3) in vec4 a_kind; layout(location=4) in vec4 a_time; " &
    "uniform mat4 u_mvp; out vec2 v_uv; out vec3 v_pos; flat out vec3 v_tint; flat out vec4 " &
    "v_kind; flat out vec4 v_time; void main() { v_uv = a_uv; v_pos = a_pos; v_tint = a_tint; " &
    "v_kind = a_kind; v_time = a_time; gl_Position = u_mvp * vec4(a_pos, 1.0); } ";

  Scar_Fragment : constant String :=
    "uniform int u_direct; uniform int u_pass; uniform vec4 u_ring; uniform vec4 " &
    "u_torch_place; uniform vec4 u_torch_dir; uniform vec3 u_torch_colour; in vec2 v_uv; in " &
    "vec3 v_pos; flat in vec3 v_tint; flat in vec4 v_kind; flat in vec4 v_time; out vec4 " &
    "o_colour; float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * " &
    "43758.5453); } float noise(vec2 p) { vec2 i = floor(p); vec2 f = fract(p); f = f * f * " &
    "(3.0 - 2.0 * f); return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + " &
    "vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y); } float drops(vec2 p, float s, " &
    "float spread) { vec2 g = p * 4.5 + s * 13.0; vec2 i = floor(g); float best = 0.0; for " &
    "(int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) { vec2 c = i + vec2(float(x), " &
    "float(y)); float h = hash(c + s); vec2 o = vec2(hash(c * 1.7 + 3.1), hash(c * 2.3 + " &
    "7.7)); vec2 at = (c + o - s * 13.0) / 4.5; float far = length(at * vec2(0.8, 1.4)); float " &
    "keep = step(h, spread * (1.0 - smoothstep(0.4, 1.0, far)) * (0.6 + 0.4 * at.x)); float " &
    "size = 0.04 + 0.09 * hash(c + 5.5); vec2 d = (p - at) * vec2(1.0 / (1.0 + 1.5 * max(at.x, " &
    "0.0)), 1.0); best = max(best, keep * (1.0 - smoothstep(size * 0.7, size, length(d)))); } " &
    "return best; } float cracks(float a, float r, float s, int count, float width) { float " &
    "best = 0.0; for (int i = 0; i < 7; i++) { if (i >= count) break; float t = float(i) * " &
    "6.2832 / float(count) + hash(vec2(float(i), s)) * 0.8; float off = abs(sin(a - t + 0.07 * " &
    "sin(r * 13.0 + float(i)))) * r; best = max(best, (1.0 - smoothstep(0.0, width, off)) * " &
    "(1.0 - smoothstep(0.25 + 0.75 * hash(vec2(s, float(i))), 1.0, r))); } return best; } void " &
    "main() { float age = u_ring.x - v_time.x; if (age < 0.0) discard; int kind = int(v_kind.x " &
    "+ 0.5); float s = v_kind.y; int variant = int(v_kind.z + 0.5); if (u_pass == 1 && (kind < " &
    "10 || kind > 13)) discard; float fade = clamp((v_kind.w - (u_ring.y - u_ring.z)) / " &
    "u_ring.w, 0.0, 1.0); float spread = 1.0; if (kind == 10 || kind == 11 || kind == 13) " &
    "spread = clamp(age / 0.16, 0.35, 1.0); if (kind == 12) { float t = clamp(age / " &
    "max(v_time.y, 0.01), 0.0, 1.0); spread = 0.12 + 0.88 * (1.0 - (1.0 - t) * (1.0 - t) * " &
    "(1.0 - t)); } vec2 p = v_uv / spread; if (max(abs(p.x), abs(p.y)) > 1.0) discard; bool " &
    "leaving = v_time.z > 0.5; vec4 form = variant == 1 ? vec4(1.15, 0.85, 0.42, 0.3) : " &
    "variant == 2 ? vec4(0.82, 1.15, -0.35, 0.38) : variant == 3 ? vec4(1.3, 1.0, 0.1, -0.45) " &
    ": vec4(1.0, 1.0, 0.0, 0.0); if (variant == 2) p = vec2(p.x * 0.8, p.y * 1.15); if " &
    "(leaving) p *= 0.72; float r = length(p); float a = atan(p.y, p.x); float n = noise(p * " &
    "4.0 + s * 17.0); float m = noise(p * 11.0 + s * 5.0); float rim = noise(vec2(a * 2.5, s * " &
    "9.0)); float rough = leaving ? 2.2 : 1.0; vec3 k = vec3(1.0); float wet = 0.0; float " &
    "gloss = 0.0; float meniscus = 0.0; float hole = 1.0 - smoothstep((0.13 + 0.06 * rough * " &
    "rim) * form.y, (0.2 + 0.06 * rough * rim) * form.y, r); float lobe = 1.0 - " &
    "smoothstep(0.16, 0.3 + 0.1 * rim, length(p - form.zw)); float lit = 1.0 + 0.25 * " &
    "dot(normalize(p + 1.0e-4), vec2(0.0, 1.0)) * smoothstep(0.15, 0.5, r); if (kind == 1) { " &
    "float crater = max(1.0 - smoothstep((0.38 + 0.22 * rough * rim) * form.x, (0.55 + 0.25 * " &
    "rough * rim) * form.x, r + 0.08 * (m - 0.5)), 0.8 * lobe * step(0.1, abs(form.z))); float " &
    "powder = 1.0 - smoothstep(0.5, 1.0, r + 0.25 * (n - 0.5)); k = mix(vec3(1.0), vec3(0.72), " &
    "powder * 0.7); k = mix(k, vec3(1.3) * lit, crater * (0.6 + 0.4 * m)); k = mix(k, " &
    "vec3(0.1), hole); } else if (kind == 2) { float flake = 1.0 - smoothstep((0.42 + 0.3 * " &
    "rim) * form.x, (0.46 + 0.3 * rim) * form.x, length(p - 0.25 * form.zw) + 0.06 * (m - " &
    "0.5)); float ridges = 0.5 + 0.5 * sin(r * 38.0 + 3.0 * n); float lines = cracks(a, r, s, " &
    "3 + variant, 0.01) * 0.7; k = mix(vec3(1.0), vec3(1.5 + 0.15 * ridges) * lit, flake); k = " &
    "mix(k, vec3(0.55), lines * (1.0 - flake)); k = mix(k, vec3(0.2), hole * 0.85); } else if " &
    "(kind == 3) { float glaze = 1.0 - smoothstep((0.3 + 0.12 * rim) * form.x, (0.34 + 0.12 * " &
    "rim) * form.x, r); float lines = cracks(a, r * 0.55, s, 4 + variant, 0.008); k = " &
    "mix(vec3(1.0), vec3(1.65, 1.6, 1.5) * lit, glaze * (0.7 + 0.3 * m)); k = mix(k, " &
    "vec3(0.35), lines * (1.0 - glaze)); k = mix(k, vec3(0.12), hole); } else if (kind == 4) { " &
    "float crater = 1.0 - smoothstep((0.45 + 0.25 * rough * rim) * form.x, (0.7 + 0.25 * rough " &
    "* rim) * form.x, r + 0.1 * (m - 0.5)); float ring = smoothstep(0.55, 0.75, r) * (1.0 - " &
    "smoothstep(0.75, 1.0, r + 0.2 * (n - 0.5))); k = mix(vec3(1.0), vec3(0.85), ring * 0.6); " &
    "k = mix(k, vec3(1.45) * lit, max(crater, 0.7 * lobe * step(0.1, abs(form.z))) * (0.5 + " &
    "0.5 * m)); k = mix(k, vec3(0.16), hole * 0.9); } else if (kind == 5) { float fibre = " &
    "noise(vec2(p.x * 3.0, p.y * 26.0) + s * 7.0); float shape = length(p * vec2(0.55, 1.6) * " &
    "form.x); float torn = (1.0 - smoothstep(0.45, 0.85, shape + 0.3 * (n - 0.5))) * " &
    "smoothstep(0.35, 0.75, fibre); if (leaving) torn = max(torn, (1.0 - smoothstep(0.5, 0.95, " &
    "r)) * smoothstep(0.55, 0.8, noise(vec2(a * 6.0, r * 3.0) + s))); k = mix(vec3(1.0), " &
    "vec3(1.55, 1.42, 1.25), torn); k = mix(k, vec3(0.75), (1.0 - smoothstep(0.2, 0.4, r)) * " &
    "0.6); k = mix(k, vec3(0.07), hole); } else if (kind == 6) { float dent = 1.0 - " &
    "smoothstep(0.25 * form.x, 0.4 * form.x, r); float lip = smoothstep(0.12, 0.2, r) * (1.0 - " &
    "smoothstep(0.26, 0.36 + 0.06 * rim, r)); float scorch = 1.0 - smoothstep(0.3, 1.0, r + " &
    "0.2 * (n - 0.5)); float petals = leaving ? smoothstep(0.6, 0.9, abs(sin(a * 2.5 + s * " &
    "6.0))) * (1.0 - smoothstep(0.2, 0.42, r)) : 0.0; k = mix(vec3(1.0), vec3(0.62, 0.6, " &
    "0.58), scorch * 0.8); if (variant >= 2 && !leaving) { k = mix(k, vec3(0.55) + vec3(0.5) * " &
    "smoothstep(0.0, 0.3, dot(p, vec2(-0.5, 0.8))), dent); k = mix(k, vec3(1.9) * lit, lip * " &
    "0.8); } else { k = mix(k, vec3(1.9) * lit, max(lip, petals)); k = mix(k, vec3(0.03), " &
    "hole); } } else if (kind == 7) { float spokes = cracks(a, r, s, 5 + variant, 0.012); " &
    "float rings = (1.0 - smoothstep(0.0, 0.015, abs(r - 0.22 * form.x - 0.04 * rim))) + 0.6 * " &
    "(1.0 - smoothstep(0.0, 0.012, abs(r - 0.48 * form.x - 0.08 * rim))); float frost = 1.0 - " &
    "smoothstep(0.08, 0.22, r); k = vec3(1.0 + 1.6 * max(spokes, rings * step(r, 0.7)) + 1.2 * " &
    "frost); k = mix(k, vec3(0.25), 1.0 - smoothstep(0.05, 0.08, r)); } else if (kind == 8) { " &
    "float tear = 1.0 - smoothstep(0.16 * form.x, 0.24 * form.x, max(abs(p.x) * 0.85, abs(p.y " &
    "+ 0.2 * p.x * float(variant - 1))) + 0.06 * (rim - 0.5)); float fray = smoothstep(0.6, " &
    "0.9, noise(vec2(a * 9.0, r * 2.0) + s)) * (1.0 - smoothstep(0.18, 0.42, r)); float singe " &
    "= 1.0 - smoothstep(0.2, 0.75, r + 0.2 * (n - 0.5)); k = mix(vec3(1.0), vec3(0.8), singe * " &
    "0.5); k = mix(k, vec3(1.35), fray * 0.6); k = mix(k, vec3(0.08), max(tear, hole * 0.8)); " &
    "} else if (kind == 9) { float blot = 1.0 - smoothstep(0.3 + 0.4 * n, 1.0, r); k = " &
    "mix(vec3(1.0), vec3(0.62, 0.58, 0.55), blot * (0.6 + 0.4 * m)); k = mix(k, vec3(0.3), " &
    "hole * 0.7); } else if (kind == 10 || kind == 11 || kind == 13) { vec2 q = p * vec2(1.0, " &
    "1.25); float body = 1.0 - smoothstep(0.32 + 0.3 * n, 0.4 + 0.3 * n, length(q + vec2(0.15, " &
    "0.0)) + 0.12 * (m - 0.5)); if (kind != 10) body = 1.0 - smoothstep(0.42 + 0.12 * rim, 0.5 " &
    "+ 0.12 * rim, r); float spray = drops(p, s, kind == 11 ? 0.35 : kind == 13 ? 0.18 : 0.8); " &
    "float runs = kind == 10 ? (1.0 - smoothstep(0.0, 0.05 + 0.03 * m, abs(p.y - 0.25 * " &
    "sin(p.x * 3.0 + s * 4.0)) * (1.2 - p.x))) * step(0.0, p.x) * (1.0 - smoothstep(0.4, 0.95, " &
    "p.x)) * step(0.55, noise(vec2(s * 31.0, 1.0))) : 0.0; float cover = max(body, max(spray, " &
    "runs * 0.9)); float edge = cover * (1.0 - smoothstep(0.0, 0.25, body * (1.0 - " &
    "smoothstep(0.25 + 0.3 * n, 0.4 + 0.3 * n, length(q + vec2(0.15, 0.0)))))); vec3 blood = " &
    "v_tint * (0.8 + 0.4 * m); k = mix(vec3(1.0), blood * (1.0 - 0.35 * edge), cover); wet = " &
    "cover * 0.8; gloss = cover * (kind == 10 ? 0.8 : 0.5); meniscus = edge; } else if (kind " &
    "== 12) { vec2 q = p * vec2(1.0, 1.3); float lobes = min(length(q + vec2(0.2, 0.05)), " &
    "min(length(q - vec2(0.3, 0.1)) * 1.25, length(q - vec2(-0.05, 0.3)) * 1.4)); float body = " &
    "1.0 - smoothstep(0.5 + 0.12 * n, 0.53 + 0.12 * n, lobes + 0.05 * (m - 0.5)); float rim2 = " &
    "body * smoothstep(0.38 + 0.12 * n, 0.53 + 0.12 * n, lobes); vec3 blood = v_tint * (0.7 + " &
    "0.25 * m) * (1.0 - 0.3 * rim2); k = mix(vec3(1.0), blood, body); wet = body * 0.85; gloss " &
    "= body; meniscus = rim2; } else if (kind == 14) { float soot = 1.0 - smoothstep(0.15, " &
    "1.0, r + 0.35 * (n - 0.5)); float streaks = pow(abs(sin(a * 7.0 + 3.0 * n + s * 5.0)), " &
    "5.0) * (1.0 - smoothstep(0.5, 1.0, r)) * smoothstep(0.1, 0.35, r); k = vec3(1.0 - 0.85 * " &
    "clamp(soot * (0.75 + 0.4 * m) + 0.4 * streaks, 0.0, 1.0)); } else if (kind == 15) { float " &
    "width = 0.09 * (1.0 - p.x * p.x) * (0.7 + 0.6 * n); float groove = 1.0 - smoothstep(width " &
    "* 0.4, width, abs(p.y - 0.08 * sin(p.x * 2.0 + s * 5.0))); float scuff = (1.0 - " &
    "smoothstep(width, width * 3.0, abs(p.y))) * (1.0 - smoothstep(0.7, 1.0, abs(p.x))); k = " &
    "mix(vec3(1.0), vec3(1.35) * lit, scuff * 0.6); k = mix(k, vec3(0.45), groove); } k = " &
    "mix(vec3(1.0), k, fade); wet *= fade; if (u_pass == 1) { if (gloss * fade < 0.01) " &
    "discard; vec3 n = normalize(cross(dFdx(v_pos), dFdy(v_pos))); vec3 v = " &
    "normalize(u_torch_place.xyz - v_pos); if (dot(n, v) < 0.0) n = -n; float nv = " &
    "clamp(dot(n, v), 0.0, 1.0); float fres = 0.02 + 0.98 * pow(1.0 - nv, 5.0); float ripple = " &
    "0.75 + 0.5 * noise(p * 9.0 + s * 3.0); vec3 sheen = v_time.w * (vec3(0.045, 0.005, 0.004) " &
    "* (0.8 + 0.4 * noise(p * 3.0 + s)) + vec3(1.0, 0.86, 0.84) * (0.008 + 0.12 * fres) * " &
    "ripple); if (u_torch_place.w > 0.0) { vec3 d = u_torch_place.xyz - v_pos; float r = " &
    "max(length(d), 1.0e-3); vec3 l = d / r; float spot = pow(smoothstep(u_torch_dir.w, 1.0, " &
    "dot(-l, u_torch_dir.xyz)), 1.5) + 0.13 * smoothstep(0.6, u_torch_dir.w + 0.03, dot(-l, " &
    "u_torch_dir.xyz)); float w = clamp(1.0 - r / u_torch_place.w, 0.0, 1.0); float m = r / " &
    "39.37; vec3 h = normalize(l + v + 0.25 * vec3(noise(p * 5.0 + s), noise(p * 5.0 - s), " &
    "0.0) - 0.125); float lobe = 0.6 * pow(max(dot(n, h), 0.0), 90.0) + 0.05 * pow(max(dot(n, " &
    "h), 0.0), 6.0); sheen += u_torch_colour / 24.0 * spot * w * w / (1.0 + m * m) * (lobe + " &
    "0.08 * fres) * ripple; } sheen *= gloss * fade * (1.0 + 1.5 * meniscus); o_colour = " &
    "vec4(u_direct == 1 ? pow(sheen, vec3(1.0 / 2.2)) : sheen, 0.0); return; } if (u_direct == " &
    "1) k = pow(k, vec3(1.0 / 2.2)); o_colour = vec4(0.5 * k, wet); } ";

  Sampler_Units : constant array (Sampler) of Natural :=
    (U_Depth       => 1,
     U_Wear        => 11,
     U_Tex         => 0,
     U_Light       => 1,
     U_Moon_Static => 6,
     U_Moon_Moving => 7,
     U_Torch_Map   => 8,
     U_Flash_Map   => 12,
     U_Normal      => 2,
     U_Packed      => 3,
     U_Team        => 4,
     U_Instances   => 5,
     U_Ao          => 0,
     U_Source      => 0,
     U_Scene       => 0,
     U_Bloom       => 2,
     U_Graded      => 0);

  Level_Stride : constant := 10;
  Model_Stride : constant := 32;
  Slug_Stride  : constant := 25;
  Mote_Stride  : constant := 15;
  Scar_Stride  : constant := 16;

  Formats : constant array (Vertex_Format) of Format_Row :=
    (Level_Format  => (Level_Stride, (3, 2, 2, 3, others => 0)),
     Model_Format  => (Model_Stride, (4, 4, 4, 4, 4, 3, 4, 2, 3)),
     Shadow_Format => (6,            (3, 3, others => 0)),
     Glow_Format   => (2,            (2, others => 0)),
     Slug_Format   => (Slug_Stride,  (3, 2, 2, 4, 4, 4, 3, 3, 0)),
     Mote_Format   => (Mote_Stride,  (3, 3, 3, 4, 2, others => 0)),
     Scar_Format   => (Scar_Stride,  (3, 2, 3, 4, 4, others => 0)));

  Glosses : constant array (Gloss_Kind) of Gloss_Row :=
    (Glass         => (0.08, 0.0, 0.0, 0, 0.30),
     Mirror        => (0.05, 0.6, 0.0, 0, 0.85),
     Water         => (0.08, 0.0, 0.0, 0, 0.00),
     Marble        => (0.20, 0.0, 0.4, 1, 0.55),
     Floor_Tile    => (0.24, 0.0, 0.6, 3, 0.40),
     Floor_Parquet => (0.40, 0.0, 0.5, 4, 0.35),
     Floor_Wood    => (0.42, 0.0, 1.0, 3, 0.22),
     Floor_Metal   => (0.38, 0.8, 1.0, 0, 0.15),
     Floor_Grate   => (0.45, 0.8, 1.2, 0, 0.00),
