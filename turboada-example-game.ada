  type Surface is record
      Kind   : Grit    := Stone;
      Where  : Vector  := Origin;
      Normal : Vector  := Origin;
      Colour : Vector  := (0.5, 0.5, 0.5);
      Share  : Real    := 1.0;
      Hit    : Boolean := True;
    end record;

  function  Surface_At     (Where, Normal : Vector) return Surface;
  function  Struck_Surface (From, Point : Vector)   return Surface;
  procedure Round_On_Level (From, Point : Vector; Arm : Weapon; Struck_Body : Boolean; Born : Real);
  procedure Move_Motes     (Now : Real);
  procedure Move_Chunks    (Now : Real);

  type Found_Spot is record Found : Boolean := False; Place : Vector := Origin; end record;

  function  Zone_Point      (Current : World; Victim : Natural; Zone : Hit_Zone) return Found_Spot;
  function  Source_Of       (Current : World; Who : Natural; Fallback : Vector)  return Vector;
  function  Holder_Of       (Current : World; Point : Vector; B : Body_Slot := Body_Slot'First) return Held_Prop;
  function  Prop_Normal     (Held : Held_Prop; Point : Vector) return Vector;
  function  Tracer_End      (Current : World; Shot : Event; Otherwise : Vector; K : Natural := 0) return Vector;
