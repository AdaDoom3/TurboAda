  subtype VkPipelineLayout is System.Address;
  subtype VkSampler is System.Address;
  subtype VkDescriptorSet is System.Address;
  subtype VkDescriptorSetLayout is System.Address;
  subtype VkDescriptorPool is System.Address;
  subtype VkFence is System.Address;
  subtype VkSemaphore is System.Address;
  subtype VkEvent is System.Address;
  subtype VkQueryPool is System.Address;
  subtype VkFramebuffer is System.Address;
  subtype VkRenderPass is System.Address;
  subtype VkPipelineCache is System.Address;
  subtype VkDescriptorUpdateTemplate is System.Address;
  subtype VkSamplerYcbcrConversion is System.Address;
  subtype VkPrivateDataSlot is System.Address;
  subtype VkSurfaceKHR is System.Address;
  subtype VkSwapchainKHR is System.Address;
  subtype VkDebugUtilsMessengerEXT is System.Address;
  VK_NULL_HANDLE : constant System.Address := System.Null_Address;
  VK_MAX_PHYSICAL_DEVICE_NAME_SIZE : constant := 256;
  VK_UUID_SIZE                     : constant := 16;
  VK_LUID_SIZE                     : constant := 8;
  VK_MAX_EXTENSION_NAME_SIZE       : constant := 256;
  VK_MAX_DESCRIPTION_SIZE          : constant := 256;
  VK_MAX_MEMORY_TYPES              : constant := 32;
  VK_MAX_MEMORY_HEAPS              : constant := 16;
  VK_LOD_CLAMP_NONE                : constant := 1000.0;
  VK_REMAINING_MIP_LEVELS          : constant := 16#FFFF_FFFF#;
  VK_REMAINING_ARRAY_LAYERS        : constant := 16#FFFF_FFFF#;
  VK_WHOLE_SIZE                    : constant Unsigned_64 := Unsigned_64'Last;
  VK_ATTACHMENT_UNUSED             : constant := 16#FFFF_FFFF#;
  VK_TRUE                          : constant := 1;
  VK_FALSE                         : constant := 0;
  VK_QUEUE_FAMILY_IGNORED          : constant := 16#FFFF_FFFF#;
  VK_QUEUE_FAMILY_EXTERNAL         : constant := 16#FFFF_FFFE#;
  VK_SUBPASS_EXTERNAL              : constant := 16#FFFF_FFFF#;
  VK_MAX_DEVICE_GROUP_SIZE         : constant := 32;
  VK_MAX_DRIVER_NAME_SIZE          : constant := 256;
  VK_MAX_DRIVER_INFO_SIZE          : constant := 256;
  function VK_MAKE_API_VERSION (variant, major, minor, patch : Unsigned_32) return Unsigned_32 is (variant * 2 ** 29 or major * 2 ** 22 or minor * 2 ** 12 or patch);
  function VK_API_VERSION_VARIANT (version : Unsigned_32) return Unsigned_32 is (version / 2 ** 29);
  function VK_API_VERSION_MAJOR (version : Unsigned_32) return Unsigned_32 is (version / 2 ** 22 and 16#7F#);
  function VK_API_VERSION_MINOR (version : Unsigned_32) return Unsigned_32 is (version / 2 ** 12 and 16#3FF#);
  function VK_API_VERSION_PATCH (version : Unsigned_32) return Unsigned_32 is (version and 16#FFF#);
  function VK_MAKE_VERSION (major, minor, patch : Unsigned_32) return Unsigned_32 is (major * 2 ** 22 or minor * 2 ** 12 or patch);
  function VK_VERSION_MAJOR (version : Unsigned_32) return Unsigned_32 is (version / 2 ** 22);
  function VK_VERSION_MINOR (version : Unsigned_32) return Unsigned_32 is (version / 2 ** 12 and 16#3FF#);
  function VK_VERSION_PATCH (version : Unsigned_32) return Unsigned_32 is (version and 16#FFF#);
  VK_API_VERSION_1_0         : constant Unsigned_32 := 16#0040_0000#;
  VK_API_VERSION_1_1         : constant Unsigned_32 := 16#0040_1000#;
  VK_API_VERSION_1_2         : constant Unsigned_32 := 16#0040_2000#;
  VK_API_VERSION_1_3         : constant Unsigned_32 := 16#0040_3000#;
  VK_HEADER_VERSION          : constant := 365;
  VK_HEADER_VERSION_COMPLETE : constant Unsigned_32 := 16#0040_416D#;
