with Interfaces, Interfaces.C, Interfaces.C.Strings, System, Unchecked_Conversion;
package Vulkan is
  pragma Dynamic_Library ("libvulkan.so.1", "libvulkan.so", "vulkan-1.dll",
                          "libvulkan.1.dylib", "libvulkan.dylib", "libMoltenVK.dylib");
  use Interfaces, Interfaces.C, Interfaces.C.Strings;
  subtype VkSampleMask is Unsigned_32;
