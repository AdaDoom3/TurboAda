  function gzwrite (file : gzFile; buf : voidpc; len : unsigned) return int;
  pragma Import (C, gzwrite, "gzwrite");
  function gzfwrite (buf : voidpc; size : z_size_t; nitems : z_size_t; file : gzFile) return z_size_t;
