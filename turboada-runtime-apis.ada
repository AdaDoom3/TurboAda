  D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING : constant := 16#1688#;
  function D3D12_MAKE_COARSE_SHADING_RATE (x, y : UINT) return UINT is (x * 2**D3D12_SHADING_RATE_X_AXIS_SHIFT or y);
  function D3D12_GET_COARSE_SHADING_RATE_X_AXIS (x : UINT) return UINT is
    ((x / 2**D3D12_SHADING_RATE_X_AXIS_SHIFT) and D3D12_SHADING_RATE_VALID_MASK);
  function D3D12_GET_COARSE_SHADING_RATE_Y_AXIS (y : UINT) return UINT is (y and D3D12_SHADING_RATE_VALID_MASK);
  function D3D12_ENCODE_SHADER_4_COMPONENT_MAPPING (Src0, Src1, Src2, Src3 : UINT) return UINT is
    ((Src0 and 7) or (Src1 and 7) * 2**3 or (Src2 and 7) * 2**6 or (Src3 and 7) * 2**9 or 2**12);
  function D3D12_DECODE_SHADER_4_COMPONENT_MAPPING (ComponentToExtract, Mapping : UINT) return UINT is
    ((Mapping / 2**(3 * Natural (ComponentToExtract mod 4))) and 7);
  function D3D12_ENCODE_BASIC_FILTER (min, mag, mip, reduction : INT) return D3D12_FILTER is
    ((min mod 4) * 2**4 + (mag mod 4) * 2**2 + (mip mod 4) + (reduction mod 4) * 2**7);
  function D3D12_ENCODE_ANISOTROPIC_FILTER (reduction : INT) return D3D12_FILTER is
    (16#40# + D3D12_ENCODE_BASIC_FILTER (1, 1, 1, reduction));
  function D3D12_ENCODE_MIN_MAG_ANISOTROPIC_MIP_POINT_FILTER (reduction : INT) return D3D12_FILTER is
    (16#40# + D3D12_ENCODE_BASIC_FILTER (1, 1, 0, reduction));
  function D3D12_DECODE_MIN_FILTER (D3D12Filter : D3D12_FILTER) return D3D12_FILTER_TYPE is ((D3D12Filter / 2**4) mod 4);
  function D3D12_DECODE_MAG_FILTER (D3D12Filter : D3D12_FILTER) return D3D12_FILTER_TYPE is ((D3D12Filter / 2**2) mod 4);
  function D3D12_DECODE_MIP_FILTER (D3D12Filter : D3D12_FILTER) return D3D12_FILTER_TYPE is (D3D12Filter mod 4);
  function D3D12_DECODE_FILTER_REDUCTION (D3D12Filter : D3D12_FILTER) return D3D12_FILTER_REDUCTION_TYPE is ((D3D12Filter / 2**7) mod 4);
  function D3D12_DECODE_IS_COMPARISON_FILTER (D3D12Filter : D3D12_FILTER) return Boolean is
    (D3D12_DECODE_FILTER_REDUCTION (D3D12Filter) = D3D12_FILTER_REDUCTION_TYPE_COMPARISON);
  function D3D12_DECODE_IS_ANISOTROPIC_FILTER (D3D12Filter : D3D12_FILTER) return Boolean is
    ((D3D12Filter / 16#40#) mod 2 = 1 and D3D12_DECODE_MIN_FILTER (D3D12Filter) = D3D12_FILTER_TYPE_LINEAR
     and D3D12_DECODE_MAG_FILTER (D3D12Filter) = D3D12_FILTER_TYPE_LINEAR);
