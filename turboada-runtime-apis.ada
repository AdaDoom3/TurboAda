    (D3D11_DECODE_FILTER_REDUCTION (filter) = D3D11_FILTER_REDUCTION_TYPE_COMPARISON);
  function D3D11_DECODE_IS_ANISOTROPIC_FILTER (filter : D3D11_FILTER) return Boolean is
    ((filter / 16#40#) mod 2 = 1 and D3D11_DECODE_MIN_FILTER (filter) = D3D11_FILTER_TYPE_LINEAR
     and D3D11_DECODE_MAG_FILTER (filter) = D3D11_FILTER_TYPE_LINEAR and D3D11_DECODE_MIP_FILTER (filter) = D3D11_FILTER_TYPE_LINEAR);
