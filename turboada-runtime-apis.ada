                        level     : int) return int;
  pragma Import (C, compress2_z, "compress2_z");
  function compressBound (sourceLen : uLong) return uLong;
  pragma Import (C, compressBound, "compressBound");
  function compressBound_z (sourceLen : z_size_t) return z_size_t;
