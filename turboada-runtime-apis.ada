    (opus_projection_decoder_ctl (st, opus_ctl_arguments'(request, System.Null_Address, System.Null_Address)));
  function opus_projection_decoder_ctl (st : OpusProjectionDecoder; request : int; x : opus_int32) return int is
    (opus_projection_decoder_ctl (st, opus_ctl_arguments'(request, Slot (x), Slot (x))));
  function opus_projection_decoder_ctl (st : OpusProjectionDecoder; request : int; x : access opus_int32) return int is
    (opus_projection_decoder_ctl (st, opus_ctl_arguments'(request, Int_Pointer_Slot (x), Int_Pointer_Slot (x))));
  function opus_projection_decoder_ctl (st : OpusProjectionDecoder; arguments : opus_ctl_arguments) return int is
    (opus_projection_decoder_ctl_Variadic (st, arguments.request, arguments.x, arguments.y, arguments.x, arguments.y,
     arguments.x, arguments.y, arguments.x, arguments.y));
end Opus;

