package body Metal.Objective_C is
  use type Interfaces.C.Strings.chars_ptr;
  Architecture : Natural := 0;
  function objc_getClass (Name : String) return Class is
    C_Name : Interfaces.C.Strings.chars_ptr := Interfaces.C.Strings.New_String (Name);
    Result : constant Class := objc_getClass (C_Name);
  begin
    Interfaces.C.Strings.Free (C_Name);
    return Result;
  end objc_getClass;
