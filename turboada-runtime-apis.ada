with Interfaces, Interfaces.C, Interfaces.C.Strings, System;
use Interfaces.C, Interfaces.C.Strings;
pragma Elaborate_All (Interfaces.C.Strings);
package Zlib is
  pragma Dynamic_Library ("libz.so.1", "libz.so", "zlib1.dll", "libz.1.dylib", "libz.dylib");
  ZLIB_VERSION          : constant chars_ptr := New_String ("1.3.2");
  ZLIB_VERNUM           : constant := 16#1320#;
  ZLIB_VER_MAJOR        : constant := 1;
  ZLIB_VER_MINOR        : constant := 3;
  ZLIB_VER_REVISION     : constant := 2;
  ZLIB_VER_SUBREVISION  : constant := 0;
  MAX_MEM_LEVEL         : constant := 9;
  MAX_WBITS             : constant := 15;
  SEEK_SET              : constant := 0;
  SEEK_CUR              : constant := 1;
  SEEK_END              : constant := 2;
  Z_NO_FLUSH            : constant := 0;
  Z_PARTIAL_FLUSH       : constant := 1;
  Z_SYNC_FLUSH          : constant := 2;
  Z_FULL_FLUSH          : constant := 3;
  Z_FINISH              : constant := 4;
  Z_BLOCK               : constant := 5;
  Z_TREES               : constant := 6;
  Z_OK                  : constant := 0;
  Z_STREAM_END          : constant := 1;
  Z_NEED_DICT           : constant := 2;
  Z_ERRNO               : constant := -1;
  Z_STREAM_ERROR        : constant := -2;
  Z_DATA_ERROR          : constant := -3;
  Z_MEM_ERROR           : constant := -4;
  Z_BUF_ERROR           : constant := -5;
  Z_VERSION_ERROR       : constant := -6;
  Z_NO_COMPRESSION      : constant := 0;
  Z_BEST_SPEED          : constant := 1;
  Z_BEST_COMPRESSION    : constant := 9;
  Z_DEFAULT_COMPRESSION : constant := -1;
  Z_FILTERED            : constant := 1;
  Z_HUFFMAN_ONLY        : constant := 2;
  Z_RLE                 : constant := 3;
  Z_FIXED               : constant := 4;
  Z_DEFAULT_STRATEGY    : constant := 0;
  Z_BINARY              : constant := 0;
  Z_TEXT                : constant := 1;
  Z_ASCII               : constant := Z_TEXT;
  Z_UNKNOWN             : constant := 2;
  Z_DEFLATED            : constant := 8;
  Z_NULL                : constant System.Address := System.Null_Address;
  subtype Byte      is unsigned_char;
  subtype uInt      is unsigned;
  subtype uLong     is unsigned_long;
  subtype Bytef     is Byte;
  subtype charf     is char;
  subtype intf      is int;
  subtype uIntf     is uInt;
  subtype uLongf    is uLong;
  subtype voidpc    is System.Address;
  subtype voidpf    is System.Address;
  subtype voidp     is System.Address;
  subtype z_crc_t   is unsigned;
  subtype z_size_t  is size_t;
  subtype z_off_t   is long;
  subtype z_off64_t is Interfaces.Integer_64;
  type alloc_func is access function (opaque : voidpf; items : uInt; size : uInt) return voidpf;
  pragma Convention (C, alloc_func);
  type free_func is access procedure (opaque : voidpf; address : voidpf);
  pragma Convention (C, free_func);
  type in_func is access function (in_desc : System.Address; buf : System.Address) return unsigned;
  pragma Convention (C, in_func);
  type out_func is access function (out_desc : System.Address; buf : System.Address; len : unsigned) return int;
  pragma Convention (C, out_func);
  type z_stream is record
    next_in   : System.Address := Z_NULL;
    avail_in  : uInt           := 0;
    total_in  : uLong          := 0;
    next_out  : System.Address := Z_NULL;
    avail_out : uInt           := 0;
    total_out : uLong          := 0;
    msg       : chars_ptr      := Null_Ptr;
    state     : System.Address := Z_NULL;
    zalloc    : alloc_func     := null;
    zfree     : free_func      := null;
    opaque    : voidpf         := Z_NULL;
    data_type : int            := 0;
    adler     : uLong          := 0;
    reserved  : uLong          := 0;
  end record;
  pragma Convention (C, z_stream);
  type z_streamp is access all z_stream;
  pragma Convention (C, z_streamp);
  type gz_header is record
    text      : int            := 0;
    time      : uLong          := 0;
    xflags    : int            := 0;
    os        : int            := 0;
    extra     : System.Address := Z_NULL;
    extra_len : uInt           := 0;
    extra_max : uInt           := 0;
    name      : System.Address := Z_NULL;
    name_max  : uInt           := 0;
    comment   : System.Address := Z_NULL;
    comm_max  : uInt           := 0;
    hcrc      : int            := 0;
    done      : int            := 0;
  end record;
  pragma Convention (C, gz_header);
  type gz_headerp is access all gz_header;
  pragma Convention (C, gz_headerp);
  type gzFile_s is record
    have : unsigned       := 0;
    next : System.Address := Z_NULL;
    pos  : z_off64_t      := 0;
  end record;
  pragma Convention (C, gzFile_s);
  subtype gzFile is System.Address;
  z_stream_size : constant int :=
    int ((z_stream'Size + System.Address'Size - 1) / System.Address'Size * System.Address'Size / System.Storage_Unit);
  function zlibVersion return chars_ptr;
  pragma Import (C, zlibVersion, "zlibVersion");
  function deflate (strm : access z_stream; flush : int) return int;
  pragma Import (C, deflate, "deflate");
  function deflateEnd (strm : access z_stream) return int;
  pragma Import (C, deflateEnd, "deflateEnd");
