with Interfaces, Interfaces.C, Interfaces.C.Strings, System;
use Interfaces, Interfaces.C;
package Sockets is
  pragma Dynamic_Library ("libc.so.6", "/usr/lib/libSystem.B.dylib", "ws2_32.dll");

  subtype SOCKET_T    is Integer_64;
  subtype socklen_t   is int;
  subtype sa_family_t is Unsigned_16;
  subtype in_port_t   is Unsigned_16;
  subtype in_addr_t   is Unsigned_32;
  subtype WORD        is Unsigned_16;
  subtype u_long      is Unsigned_32;

  type Platform_Kind is (Platform_Linux, Platform_Apple, Platform_Windows);

  INVALID_SOCKET   : constant := -1;
  SOCKET_ERROR     : constant := -1;
  AF_UNSPEC        : constant := 0;
  AF_INET          : constant := 2;
  PF_INET          : constant := 2;
  SOCK_STREAM      : constant := 1;
  SOCK_DGRAM       : constant := 2;
  IPPROTO_IP       : constant := 0;
  IPPROTO_TCP      : constant := 6;
  IPPROTO_UDP      : constant := 17;
  INADDR_ANY       : constant := 16#0000_0000#;
  INADDR_LOOPBACK  : constant := 16#7F00_0001#;
  INADDR_BROADCAST : constant := 16#FFFF_FFFF#;
  INADDR_NONE      : constant := 16#FFFF_FFFF#;
  F_GETFL          : constant := 3;
  F_SETFL          : constant := 4;
  FIONBIO          : constant := 16#8004_667E#;
  WSADESCRIPTION_LEN : constant := 256;
  WSASYS_STATUS_LEN  : constant := 128;

  type in_addr is record
      s_addr : in_addr_t := 0;
    end record;
  pragma Convention (C, in_addr);

  type Array_sin_zero is array (0 .. 7) of Unsigned_8;
  pragma Convention (C, Array_sin_zero);

  type sockaddr_in is record
      sin_family : sa_family_t    := 0;
      sin_port   : in_port_t      := 0;
      sin_addr   : in_addr        := (s_addr => 0);
      sin_zero   : Array_sin_zero := (others => 0);
    end record;
  pragma Convention (C, sockaddr_in);
  type Ptr_sockaddr_in is access all sockaddr_in;
  pragma Convention (C, Ptr_sockaddr_in);

  type Array_WSADATA is array (0 .. 511) of Unsigned_8;
  type WSADATA is record
      Storage : Array_WSADATA := (others => 0);
    end record;
  pragma Convention (C, WSADATA);

  function Platform     return Platform_Kind;
  function SOL_SOCKET   return int;
  function SO_REUSEADDR return int;
  function SO_BROADCAST return int;
  function SO_SNDBUF    return int;
  function SO_RCVBUF    return int;
  function MSG_DONTWAIT return int;
  function O_NONBLOCK   return int;

  function htons (hostshort : Unsigned_16) return Unsigned_16 is ((hostshort mod 256) * 256 + hostshort / 256);
  function ntohs (netshort  : Unsigned_16) return Unsigned_16 is (htons (netshort));
  function htonl (hostlong  : Unsigned_32) return Unsigned_32 is
    ((hostlong mod 256) * 2**24 + (hostlong / 256 mod 256) * 2**16 + (hostlong / 2**16 mod 256) * 256 + hostlong / 2**24);
  function ntohl (netlong   : Unsigned_32) return Unsigned_32 is (htonl (netlong));

  function WSAStartup  (wVersionRequested : WORD; lpWSAData : access WSADATA) return int;
  function WSACleanup  return int;
  function socket      (af : int; type_Param : int; protocol : int) return SOCKET_T;
  function bind        (s : SOCKET_T; name : access constant sockaddr_in; namelen : socklen_t) return int;
  function sendto      (s     : SOCKET_T;
                        buf   : System.Address;
                        len   : int;
                        flags : int;
                        to    : access constant sockaddr_in;
                        tolen : socklen_t) return int;
  function recvfrom    (s       : SOCKET_T;
                        buf     : System.Address;
                        len     : int;
                        flags   : int;
                        from    : access sockaddr_in;
                        fromlen : access socklen_t) return int;
  function setsockopt  (s : SOCKET_T; level : int; optname : int; optval : System.Address; optlen : socklen_t) return int;
  function getsockname (s : SOCKET_T; name : access sockaddr_in; namelen : access socklen_t) return int;
  function ioctlsocket (s : SOCKET_T; cmd : int; argp : access u_long) return int;
  function fcntl       (fd : SOCKET_T; cmd : int; arg : int) return int;
  function closesocket (s : SOCKET_T) return int;
  function close       (fd : SOCKET_T) return int renames closesocket;

  function Startup          return Boolean;
  function Set_Non_Blocking (s : SOCKET_T; Enabled : Boolean := True) return Boolean;
  function Set_Option       (s : SOCKET_T; level : int; optname : int; Value : int) return Boolean;
  function Open_UDP         (Port : in_port_t := 0; Host : in_addr_t := INADDR_ANY) return SOCKET_T;
  function Make_Address     (Host : in_addr_t; Port : in_port_t) return sockaddr_in;
  function Address_Host     (Address : sockaddr_in) return in_addr_t;
  function Address_Port     (Address : sockaddr_in) return in_port_t;
  function Local_Port       (s : SOCKET_T) return in_port_t;
  function Parse_IPv4       (Text : String) return in_addr_t;
  function Resolve          (Name : String) return in_addr_t;
  function Image            (Address : sockaddr_in) return String;
  function Send_To          (s : SOCKET_T; Data : System.Address; Length : Natural; To : sockaddr_in) return Boolean;
  function Receive_From     (s : SOCKET_T; Data : System.Address; Capacity : Natural; From : out sockaddr_in) return Integer;

private
  function Raw_WSAStartup  (wVersionRequested : Integer_64; lpWSAData : System.Address) return Integer_64;
  pragma Import (C, Raw_WSAStartup, "WSAStartup");
  function Raw_WSACleanup  return Integer_64;
  pragma Import (C, Raw_WSACleanup, "WSACleanup");
  function Raw_socket      (af, type_Param, protocol : Integer_64) return Integer_64;
  pragma Import (C, Raw_socket, "socket");
  function Raw_bind        (s : Integer_64; name : System.Address; namelen : Integer_64) return Integer_64;
  pragma Import (C, Raw_bind, "bind");
  function Raw_sendto      (s, buf, len, flags, to, tolen : Integer_64) return Integer_64;
  pragma Import (C, Raw_sendto, "sendto");
  function Raw_recvfrom    (s, buf, len, flags, from, fromlen : Integer_64) return Integer_64;
  pragma Import (C, Raw_recvfrom, "recvfrom");
  function Raw_setsockopt  (s, level, optname : Integer_64; optval : System.Address; optlen : Integer_64) return Integer_64;
  pragma Import (C, Raw_setsockopt, "setsockopt");
  function Raw_getsockname (s : Integer_64; name, namelen : System.Address) return Integer_64;
  pragma Import (C, Raw_getsockname, "getsockname");
  function Raw_ioctlsocket (s, cmd : Integer_64; argp : System.Address) return Integer_64;
  pragma Import (C, Raw_ioctlsocket, "ioctlsocket");
  function Raw_fcntl       (fd, cmd, arg : Integer_64) return Integer_64;
  pragma Import (C, Raw_fcntl, "fcntl");
  function Raw_closesocket (s : Integer_64) return Integer_64;
  pragma Import (C, Raw_closesocket, "closesocket");
  function Raw_close       (fd : Integer_64) return Integer_64;
  pragma Import (C, Raw_close, "close");
  function Raw_gethostbyname (name : Interfaces.C.Strings.chars_ptr) return System.Address;
  pragma Import (C, Raw_gethostbyname, "gethostbyname");
  function Raw_gnu_get_libc_version return System.Address;
  pragma Import (C, Raw_gnu_get_libc_version, "gnu_get_libc_version");
end Sockets;

with Unchecked_Conversion;
package body Sockets is
  type Option_Row is record
      Level, Reuse, Broadcast, Send_Buffer, Receive_Buffer, Dont_Wait, Non_Blocking : int;
    end record;
  Options : constant array (Platform_Kind) of Option_Row :=
    (Platform_Linux   => (1,        2, 6,      7,        8,        16#40#, 8#4000#),
     Platform_Apple   => (16#FFFF#, 4, 16#20#, 16#1001#, 16#1002#, 16#80#, 4),
     Platform_Windows => (16#FFFF#, 4, 16#20#, 16#1001#, 16#1002#, 0,      0));

  type Array_Waiting_Free is array (1 .. 64) of SOCKET_T;
  Detected     : Platform_Kind      := Platform_Linux;
  Known        : Boolean            := False;
  Started      : Boolean            := False;
  Waiting_Free : Array_Waiting_Free := (others => INVALID_SOCKET);
  Winsock_Data : aliased WSADATA;
  Last_Status  : int                := 0;

  function Narrow  (Value : Integer_64) return int is
    (int (if Value mod 2**32 >= 2**31 then Value mod 2**32 - 2**32 else Value mod 2**32));
  function Widen   (Item : System.Address) return Integer_64 is
    (declare
       function Convert is new Unchecked_Conversion (System.Address, Integer_64);
     begin Convert (Item));

  function Probe_Windows return Boolean is
    begin
      return Narrow (Raw_WSAStartup (16#0202#, Winsock_Data'Address)) = 0;
    exception
      when Program_Error => return False;
    end;

  function Probe_Glibc return Boolean is
    begin
      return Raw_gnu_get_libc_version /= System.Null_Address;
    exception
      when Program_Error => return False;
    end;

  function Platform return Platform_Kind is
    begin
      if not Known then
        Started  := Probe_Windows;
        Detected := (if Started then Platform_Windows elsif Probe_Glibc then Platform_Linux else Platform_Apple);
        Known    := True;
      end if;
      return Detected;
    end;

  function SOL_SOCKET   return int is (Options (Platform).Level);
  function SO_REUSEADDR return int is (Options (Platform).Reuse);
  function SO_BROADCAST return int is (Options (Platform).Broadcast);
  function SO_SNDBUF    return int is (Options (Platform).Send_Buffer);
  function SO_RCVBUF    return int is (Options (Platform).Receive_Buffer);
  function MSG_DONTWAIT return int is (Options (Platform).Dont_Wait);
  function O_NONBLOCK   return int is (Options (Platform).Non_Blocking);

  function Startup return Boolean is (Platform /= Platform_Windows or Started);

  function Switched    (s : SOCKET_T) return Boolean is (for some Item of Waiting_Free => Item = s);
  function Extra_Flags (s : SOCKET_T) return int     is (if Platform = Platform_Apple and then Switched (s) then MSG_DONTWAIT else 0);

  function WSAStartup (wVersionRequested : WORD; lpWSAData : access WSADATA) return int is
    (Narrow (Raw_WSAStartup (Integer_64 (wVersionRequested), lpWSAData.all'Address)));
  function WSACleanup return int is (if Platform = Platform_Windows then Narrow (Raw_WSACleanup) else 0);

  function socket (af : int; type_Param : int; protocol : int) return SOCKET_T is
    (if Startup then Integer_64 (Narrow (Raw_socket (Integer_64 (af), Integer_64 (type_Param), Integer_64 (protocol))))
     else INVALID_SOCKET);

  function bind (s : SOCKET_T; name : access constant sockaddr_in; namelen : socklen_t) return int is
    (Narrow (Raw_bind (s, name.all'Address, Integer_64 (namelen))));

  function sendto (s     : SOCKET_T;
                   buf   : System.Address;
                   len   : int;
                   flags : int;
                   to    : access constant sockaddr_in;
                   tolen : socklen_t) return int is
    (Narrow (Raw_sendto (s, Widen (buf), Integer_64 (len), Integer_64 (flags + Extra_Flags (s)), Widen (to.all'Address),
                         Integer_64 (tolen))));

  function recvfrom (s       : SOCKET_T;
                     buf     : System.Address;
                     len     : int;
                     flags   : int;
                     from    : access sockaddr_in;
                     fromlen : access socklen_t) return int is
    (Narrow (Raw_recvfrom (s, Widen (buf), Integer_64 (len), Integer_64 (flags + Extra_Flags (s)), Widen (from.all'Address),
                           Widen (fromlen.all'Address))));

  function setsockopt (s : SOCKET_T; level : int; optname : int; optval : System.Address; optlen : socklen_t) return int is
    (Narrow (Raw_setsockopt (s, Integer_64 (level), Integer_64 (optname), optval, Integer_64 (optlen))));

  function getsockname (s : SOCKET_T; name : access sockaddr_in; namelen : access socklen_t) return int is
    (Narrow (Raw_getsockname (s, name.all'Address, namelen.all'Address)));

  function ioctlsocket (s : SOCKET_T; cmd : int; argp : access u_long) return int is
    (Narrow (Raw_ioctlsocket (s, Integer_64 (cmd) mod 2**32, argp.all'Address)));

  function fcntl (fd : SOCKET_T; cmd : int; arg : int) return int is
    (Narrow (Raw_fcntl (fd, Integer_64 (cmd), Integer_64 (arg))));

  function closesocket (s : SOCKET_T) return int is
    begin
      for Item of Waiting_Free loop
        if Item = s then Item := INVALID_SOCKET; end if;
      end loop;
      return Narrow (if Platform = Platform_Windows then Raw_closesocket (s) else Raw_close (s));
    end;

  function Set_Non_Blocking (s : SOCKET_T; Enabled : Boolean := True) return Boolean is
    Argument : aliased u_long := (if Enabled then 1 else 0);
    begin
      case Platform is
        when Platform_Windows => return ioctlsocket (s, int (Integer_64 (FIONBIO) - 2**32), Argument'Access) = 0;
        when Platform_Linux   =>
          declare
            Flags   : constant int         := fcntl (s, F_GETFL, 0);
            Current : constant Unsigned_32 := Unsigned_32 (Integer_64 (Flags) mod 2**32);
            Wanted  : constant Unsigned_32 := (if Enabled then Current or Unsigned_32 (O_NONBLOCK)
                                               else Current and not Unsigned_32 (O_NONBLOCK));
          begin
            return Flags >= 0 and then fcntl (s, F_SETFL, Narrow (Integer_64 (Wanted))) = 0;
          end;
        when Platform_Apple   =>
          for Item of Waiting_Free loop
            if Item = s then Item := INVALID_SOCKET; end if;
          end loop;
          if Enabled then
            for Item of Waiting_Free loop
              if Item = INVALID_SOCKET then Item := s; return True; end if;
            end loop;
            return False;
          end if;
          return True;
      end case;
    end;

  function Set_Option (s : SOCKET_T; level : int; optname : int; Value : int) return Boolean is
    Item : aliased int := Value;
    begin
      return setsockopt (s, level, optname, Item'Address, int'Size / 8) = 0;
    end;

  function Make_Address (Host : in_addr_t; Port : in_port_t) return sockaddr_in is
    (sin_family => (if Platform = Platform_Apple then 16 + AF_INET * 256 else AF_INET),
     sin_port   => htons (Port),
     sin_addr   => (s_addr => htonl (Host)),
     sin_zero   => (others => 0));

  function Address_Host (Address : sockaddr_in) return in_addr_t is (ntohl (Address.sin_addr.s_addr));
  function Address_Port (Address : sockaddr_in) return in_port_t is (ntohs (Address.sin_port));

  function Open_UDP (Port : in_port_t := 0; Host : in_addr_t := INADDR_ANY) return SOCKET_T is
    Result : constant SOCKET_T := socket (AF_INET, SOCK_DGRAM, IPPROTO_UDP);
    Where  : aliased constant sockaddr_in := Make_Address (Host, Port);
    begin
      if Result = INVALID_SOCKET then return INVALID_SOCKET; end if;
      if not Set_Option (Result, SOL_SOCKET, SO_REUSEADDR, 1) or not Set_Non_Blocking (Result)
        or bind (Result, Where'Access, sockaddr_in'Size / 8) /= 0
      then
        Last_Status := closesocket (Result);
        return INVALID_SOCKET;
      end if;
      return Result;
    end;

  function Local_Port (s : SOCKET_T) return in_port_t is
    Where  : aliased sockaddr_in;
    Length : aliased socklen_t := sockaddr_in'Size / 8;
    begin
      return (if getsockname (s, Where'Access, Length'Access) = 0 then Address_Port (Where) else 0);
    end;

  function Parse_IPv4 (Text : String) return in_addr_t is
    Result  : in_addr_t := 0;
    Part    : in_addr_t := 0;
    Dots    : Natural   := 0;
    Figures : Natural   := 0;
    begin
      for Item of Text loop
        case Item is
          when '0' .. '9' =>
            Part   := Part * 10 + Character'Pos (Item) - Character'Pos ('0');
            Figures := Figures + 1;
            if Part > 255 or Figures > 3 then return INADDR_NONE; end if;
          when '.' =>
            if Figures = 0 then return INADDR_NONE; end if;
            Result := Result * 256 + Part; Part := 0; Figures := 0; Dots := Dots + 1;
          when others => return INADDR_NONE;
        end case;
      end loop;
      return (if Dots = 3 and Figures > 0 then Result * 256 + Part else INADDR_NONE);
    end;

  function Resolve (Name : String) return in_addr_t is
    type Ptr_Address is access all System.Address;
    type Ptr_Bytes   is access all Array_sin_zero;
    function To_Pointer is new Unchecked_Conversion (System.Address, Ptr_Address);
    function To_Bytes   is new Unchecked_Conversion (System.Address, Ptr_Bytes);
    function Offset (Base : System.Address; By : Integer_64) return System.Address is
      (declare
         function To_Address is new Unchecked_Conversion (Integer_64, System.Address);
       begin To_Address (Widen (Base) + By));
    Dotted : constant in_addr_t := Parse_IPv4 (Name);
    begin
      if Dotted /= INADDR_NONE or not Startup then return Dotted; end if;
      declare
        Entry_Pointer : constant System.Address := Raw_gethostbyname (Interfaces.C.Strings.New_String (Name));
      begin
        if Entry_Pointer = System.Null_Address then return INADDR_NONE; end if;
        declare
          List  : constant System.Address := To_Pointer (Offset (Entry_Pointer, 24)).all;
          First : constant System.Address := (if List = System.Null_Address then List else To_Pointer (List).all);
        begin
          if First = System.Null_Address then return INADDR_NONE; end if;
          declare
            Bytes : constant Array_sin_zero := To_Bytes (First).all;
          begin
            return in_addr_t (Bytes (0)) * 2**24 + in_addr_t (Bytes (1)) * 2**16 + in_addr_t (Bytes (2)) * 2**8
                   + in_addr_t (Bytes (3));
          end;
        end;
      end;
    exception
      when Program_Error => return INADDR_NONE;
    end;

  function Decimal (Value : in_addr_t) return String is
    (declare
       Text : constant String := in_addr_t'Image (Value);
     begin Text (Text'First + 1 .. Text'Last));

  function Image (Address : sockaddr_in) return String is
    (declare
       Host : constant in_addr_t := Address_Host (Address);
     begin
       Decimal (Host / 2**24) & '.' & Decimal (Host / 2**16 mod 256) & '.' & Decimal (Host / 2**8 mod 256) & '.'
       & Decimal (Host mod 256) & ':' & Decimal (in_addr_t (Address_Port (Address))));

  function Send_To (s : SOCKET_T; Data : System.Address; Length : Natural; To : sockaddr_in) return Boolean is
    Where : aliased constant sockaddr_in := To;
    begin
      return sendto (s, Data, int (Length), 0, Where'Access, sockaddr_in'Size / 8) = int (Length);
    end;

  function Receive_From (s : SOCKET_T; Data : System.Address; Capacity : Natural; From : out sockaddr_in) return Integer is
    Where  : aliased sockaddr_in;
    Length : aliased socklen_t := sockaddr_in'Size / 8;
    Count  : constant int      := recvfrom (s, Data, int (Capacity), 0, Where'Access, Length'Access);
    begin
      From := Where;
      return Integer (Count);
    end;
end Sockets;
