  function SDL_AtomicIncRef (a : access SDL_AtomicInt) return Interfaces.C.int is (SDL_AddAtomicInt (a, 1));
  function SDL_AtomicDecRef (a : access SDL_AtomicInt) return Boolean is (SDL_AddAtomicInt (a, -1) = 1);
  procedure SDL_MemoryBarrierRelease renames SDL_MemoryBarrierReleaseFunction;
  procedure SDL_MemoryBarrierAcquire renames SDL_MemoryBarrierAcquireFunction;
  function SDL_DEFINE_AUDIO_FORMAT (signed, bigendian, flt, size : Interfaces.C.int) return SDL_AudioFormat is
    (signed * 2 ** 15 + bigendian * 2 ** 12 + flt * 2 ** 8 + size mod 2 ** 8);
  function SDL_AUDIO_BITSIZE (x : SDL_AudioFormat) return Interfaces.C.int is (x mod 2 ** 8);
  function SDL_AUDIO_BYTESIZE (x : SDL_AudioFormat) return Interfaces.C.int is (SDL_AUDIO_BITSIZE (x) / 8);
  function SDL_AUDIO_ISFLOAT (x : SDL_AudioFormat) return Boolean is ((x / 2 ** 8) mod 2 = 1);
  function SDL_AUDIO_ISBIGENDIAN (x : SDL_AudioFormat) return Boolean is ((x / 2 ** 12) mod 2 = 1);
  function SDL_AUDIO_ISLITTLEENDIAN (x : SDL_AudioFormat) return Boolean is (not SDL_AUDIO_ISBIGENDIAN (x));
  function SDL_AUDIO_ISSIGNED (x : SDL_AudioFormat) return Boolean is ((x / 2 ** 15) mod 2 = 1);
  function SDL_AUDIO_ISINT (x : SDL_AudioFormat) return Boolean is (not SDL_AUDIO_ISFLOAT (x));
  function SDL_AUDIO_ISUNSIGNED (x : SDL_AudioFormat) return Boolean is (not SDL_AUDIO_ISSIGNED (x));
  function SDL_AUDIO_FRAMESIZE (x : SDL_AudioSpec) return Interfaces.C.int is (SDL_AUDIO_BYTESIZE (x.format) * x.channels);
  function SDL_Swap16 (x : Uint16) return Uint16 is ((x / 2 ** 8) or (x * 2 ** 8));
  function SDL_Swap32 (x : Uint32) return Uint32 is
    ((x / 2 ** 24) or ((x / 2 ** 8) and 16#FF00#) or ((x * 2 ** 8) and 16#FF_0000#) or (x * 2 ** 24));
  function SDL_Swap64 (x : Uint64) return Uint64 is
    ((Uint64 (SDL_Swap32 (Uint32 (x and 16#FFFF_FFFF#))) * 2 ** 32) or Uint64 (SDL_Swap32 (Uint32 (x / 2 ** 32))));
  function SDL_SwapFloat (x : Interfaces.C.C_float) return Interfaces.C.C_float;
  function SDL_Swap16LE (x : Uint16) return Uint16 is (x);
  function SDL_Swap32LE (x : Uint32) return Uint32 is (x);
  function SDL_Swap64LE (x : Uint64) return Uint64 is (x);
  function SDL_SwapFloatLE (x : Interfaces.C.C_float) return Interfaces.C.C_float is (x);
  function SDL_Swap16BE (x : Uint16) return Uint16 is (SDL_Swap16 (x));
  function SDL_Swap32BE (x : Uint32) return Uint32 is (SDL_Swap32 (x));
  function SDL_Swap64BE (x : Uint64) return Uint64 is (SDL_Swap64 (x));
  function SDL_SwapFloatBE (x : Interfaces.C.C_float) return Interfaces.C.C_float is (SDL_SwapFloat (x));
  function SDL_SCANCODE_TO_KEYCODE (X : SDL_Scancode) return SDL_Keycode is (SDL_Keycode (X) or SDLK_SCANCODE_MASK);
  function SDL_BUTTON_MASK (X : Uint8) return SDL_MouseButtonFlags is (2 ** (Natural (X) - 1));
  function SDL_FOURCC (A, B, C, D : Character) return Uint32 is
    (Uint32 (Character'Pos (A)) or (Uint32 (Character'Pos (B)) * 2 ** 8) or (Uint32 (Character'Pos (C)) * 2 ** 16)
     or (Uint32 (Character'Pos (D)) * 2 ** 24));
  function SDL_DEFINE_PIXELFOURCC (A, B, C, D : Character) return SDL_PixelFormat is
    (SDL_PixelFormat (SDL_FOURCC (A, B, C, D)));
  function SDL_DEFINE_PIXELFORMAT (type_Param, order, layout, bits, bytes : Interfaces.C.int) return SDL_PixelFormat is
    (2 ** 28 + type_Param * 2 ** 24 + order * 2 ** 20 + layout * 2 ** 16 + bits * 2 ** 8 + bytes);
  function SDL_PIXELFLAG (format : SDL_PixelFormat) return Interfaces.C.int is ((format / 2 ** 28) mod 2 ** 4);
  function SDL_PIXELTYPE (format : SDL_PixelFormat) return SDL_PixelType_T is ((format / 2 ** 24) mod 2 ** 4);
  function SDL_PIXELORDER (format : SDL_PixelFormat) return Interfaces.C.int is ((format / 2 ** 20) mod 2 ** 4);
  function SDL_PIXELLAYOUT (format : SDL_PixelFormat) return SDL_PackedLayout is ((format / 2 ** 16) mod 2 ** 4);
  function SDL_ISPIXELFORMAT_FOURCC (format : SDL_PixelFormat) return Boolean is
    (format /= 0 and then SDL_PIXELFLAG (format) /= 1);
  function SDL_BITSPERPIXEL (format : SDL_PixelFormat) return Interfaces.C.int is
    (if SDL_ISPIXELFORMAT_FOURCC (format) then 0 else (format / 2 ** 8) mod 2 ** 8);
  function SDL_BYTESPERPIXEL (format : SDL_PixelFormat) return Interfaces.C.int is
    (if SDL_ISPIXELFORMAT_FOURCC (format) then
       (if format = SDL_PIXELFORMAT_YUY2 or else format = SDL_PIXELFORMAT_UYVY or else format = SDL_PIXELFORMAT_YVYU
           or else format = SDL_PIXELFORMAT_P010 then 2 else 1)
     else format mod 2 ** 8);
  function SDL_ISPIXELFORMAT_INDEXED (format : SDL_PixelFormat) return Boolean is
    (not SDL_ISPIXELFORMAT_FOURCC (format)
     and then (SDL_PIXELTYPE (format) = SDL_PIXELTYPE_INDEX1 or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_INDEX2
               or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_INDEX4 or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_INDEX8));
  function SDL_ISPIXELFORMAT_PACKED (format : SDL_PixelFormat) return Boolean is
    (not SDL_ISPIXELFORMAT_FOURCC (format)
     and then (SDL_PIXELTYPE (format) = SDL_PIXELTYPE_PACKED8 or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_PACKED16
               or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_PACKED32));
  function SDL_ISPIXELFORMAT_ARRAY (format : SDL_PixelFormat) return Boolean is
    (not SDL_ISPIXELFORMAT_FOURCC (format)
     and then (SDL_PIXELTYPE (format) = SDL_PIXELTYPE_ARRAYU8 or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_ARRAYU16
               or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_ARRAYU32 or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_ARRAYF16
               or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_ARRAYF32));
  function SDL_ISPIXELFORMAT_10BIT (format : SDL_PixelFormat) return Boolean is
    (not SDL_ISPIXELFORMAT_FOURCC (format)
     and then SDL_PIXELTYPE (format) = SDL_PIXELTYPE_PACKED32
     and then SDL_PIXELLAYOUT (format) = SDL_PACKEDLAYOUT_2101010);
  function SDL_ISPIXELFORMAT_FLOAT (format : SDL_PixelFormat) return Boolean is
    (not SDL_ISPIXELFORMAT_FOURCC (format)
     and then (SDL_PIXELTYPE (format) = SDL_PIXELTYPE_ARRAYF16 or else SDL_PIXELTYPE (format) = SDL_PIXELTYPE_ARRAYF32));
  function SDL_ISPIXELFORMAT_ALPHA (format : SDL_PixelFormat) return Boolean is
    ((SDL_ISPIXELFORMAT_PACKED (format)
      and then (SDL_PIXELORDER (format) = SDL_PACKEDORDER_ARGB or else SDL_PIXELORDER (format) = SDL_PACKEDORDER_RGBA
                or else SDL_PIXELORDER (format) = SDL_PACKEDORDER_ABGR or else SDL_PIXELORDER (format) = SDL_PACKEDORDER_BGRA))
     or else (SDL_ISPIXELFORMAT_ARRAY (format)
              and then (SDL_PIXELORDER (format) = SDL_ARRAYORDER_ARGB or else SDL_PIXELORDER (format) = SDL_ARRAYORDER_RGBA
                        or else SDL_PIXELORDER (format) = SDL_ARRAYORDER_ABGR or else SDL_PIXELORDER (format) = SDL_ARRAYORDER_BGRA)));
  function SDL_DEFINE_COLORSPACE (type_Param, range_Param, primaries, transfer, matrix, chroma : Interfaces.C.int) return SDL_Colorspace is
    (type_Param * 2 ** 28 + range_Param * 2 ** 24 + chroma * 2 ** 20 + primaries * 2 ** 10 + transfer * 2 ** 5 + matrix);
  function SDL_COLORSPACETYPE (cspace : SDL_Colorspace) return SDL_ColorType is ((cspace / 2 ** 28) mod 2 ** 4);
  function SDL_COLORSPACERANGE (cspace : SDL_Colorspace) return SDL_ColorRange is ((cspace / 2 ** 24) mod 2 ** 4);
  function SDL_COLORSPACECHROMA (cspace : SDL_Colorspace) return SDL_ChromaLocation is ((cspace / 2 ** 20) mod 2 ** 4);
  function SDL_COLORSPACEPRIMARIES (cspace : SDL_Colorspace) return SDL_ColorPrimaries is ((cspace / 2 ** 10) mod 2 ** 5);
  function SDL_COLORSPACETRANSFER (cspace : SDL_Colorspace) return SDL_TransferCharacteristics is ((cspace / 2 ** 5) mod 2 ** 5);
  function SDL_COLORSPACEMATRIX (cspace : SDL_Colorspace) return SDL_MatrixCoefficients is (cspace mod 2 ** 5);
  function SDL_ISCOLORSPACE_MATRIX_BT601 (cspace : SDL_Colorspace) return Boolean is
    (SDL_COLORSPACEMATRIX (cspace) = SDL_MATRIX_COEFFICIENTS_BT601 or else SDL_COLORSPACEMATRIX (cspace) = SDL_MATRIX_COEFFICIENTS_BT470BG);
  function SDL_ISCOLORSPACE_MATRIX_BT709 (cspace : SDL_Colorspace) return Boolean is
    (SDL_COLORSPACEMATRIX (cspace) = SDL_MATRIX_COEFFICIENTS_BT709);
  function SDL_ISCOLORSPACE_MATRIX_BT2020_NCL (cspace : SDL_Colorspace) return Boolean is
    (SDL_COLORSPACEMATRIX (cspace) = SDL_MATRIX_COEFFICIENTS_BT2020_NCL);
  function SDL_ISCOLORSPACE_LIMITED_RANGE (cspace : SDL_Colorspace) return Boolean is
    (SDL_COLORSPACERANGE (cspace) /= SDL_COLOR_RANGE_FULL);
  function SDL_ISCOLORSPACE_FULL_RANGE (cspace : SDL_Colorspace) return Boolean is
    (SDL_COLORSPACERANGE (cspace) = SDL_COLOR_RANGE_FULL);
  function SDL_MUSTLOCK (S : access constant SDL_Surface) return Boolean is
    ((S.flags and SDL_SURFACE_LOCK_NEEDED) = SDL_SURFACE_LOCK_NEEDED);
  function SDL_CreateThread (fn : SDL_ThreadFunction; name : Interfaces.C.Strings.chars_ptr; data : System.Address) return SDL_Thread is
    (SDL_CreateThreadRuntime (fn, name, data, null, null));
  function SDL_CreateThreadWithProperties (props : SDL_PropertiesID) return SDL_Thread is
    (SDL_CreateThreadWithPropertiesRuntime (props, null, null));
  function SDL_SECONDS_TO_NS (S : Uint64) return Uint64 is (S * SDL_NS_PER_SECOND);
  function SDL_NS_TO_SECONDS (NS : Uint64) return Uint64 is (NS / SDL_NS_PER_SECOND);
  function SDL_MS_TO_NS (MS : Uint64) return Uint64 is (MS * SDL_NS_PER_MS);
  function SDL_NS_TO_MS (NS : Uint64) return Uint64 is (NS / SDL_NS_PER_MS);
  function SDL_US_TO_NS (US : Uint64) return Uint64 is (US * SDL_NS_PER_US);
  function SDL_NS_TO_US (NS : Uint64) return Uint64 is (NS / SDL_NS_PER_US);
  function SDL_VERSIONNUM (major, minor, patch : Interfaces.C.int) return Interfaces.C.int is (major * 1000000 + minor * 1000 + patch);
  function SDL_VERSIONNUM_MAJOR (version : Interfaces.C.int) return Interfaces.C.int is (version / 1000000);
  function SDL_VERSIONNUM_MINOR (version : Interfaces.C.int) return Interfaces.C.int is ((version / 1000) mod 1000);
  function SDL_VERSIONNUM_MICRO (version : Interfaces.C.int) return Interfaces.C.int is (version mod 1000);
  function SDL_VERSION_ATLEAST (X, Y, Z : Interfaces.C.int) return Boolean is (SDL_VERSION >= SDL_VERSIONNUM (X, Y, Z));
  function SDL_WINDOWPOS_UNDEFINED_DISPLAY (X : Interfaces.C.int) return Interfaces.C.int is (SDL_WINDOWPOS_UNDEFINED_MASK + X);
  function SDL_WINDOWPOS_ISUNDEFINED (X : Interfaces.C.int) return Boolean is (X / 2 ** 16 = SDL_WINDOWPOS_UNDEFINED_MASK / 2 ** 16);
  function SDL_WINDOWPOS_CENTERED_DISPLAY (X : Interfaces.C.int) return Interfaces.C.int is (SDL_WINDOWPOS_CENTERED_MASK + X);
  function SDL_WINDOWPOS_ISCENTERED (X : Interfaces.C.int) return Boolean is (X / 2 ** 16 = SDL_WINDOWPOS_CENTERED_MASK / 2 ** 16);
  procedure SDL_RectToFRect (rect : access constant SDL_Rect; frect : access SDL_FRect);
  function SDL_PointInRect (p : access constant SDL_Point; r : access constant SDL_Rect) return Interfaces.C.C_bool is
    (Interfaces.C.C_bool (p /= null and then r /= null and then p.x >= r.x and then p.x < r.x + r.w
                          and then p.y >= r.y and then p.y < r.y + r.h));
  function SDL_RectEmpty (r : access constant SDL_Rect) return Interfaces.C.C_bool is
    (Interfaces.C.C_bool (r = null or else r.w <= 0 or else r.h <= 0));
  function SDL_RectsEqual (a, b : access constant SDL_Rect) return Interfaces.C.C_bool is
    (Interfaces.C.C_bool (a /= null and then b /= null and then a.x = b.x and then a.y = b.y
                          and then a.w = b.w and then a.h = b.h));
  function SDL_PointInRectFloat (p : access constant SDL_FPoint; r : access constant SDL_FRect) return Interfaces.C.C_bool is
    (Interfaces.C.C_bool (p /= null and then r /= null and then p.x >= r.x and then p.x <= r.x + r.w
                          and then p.y >= r.y and then p.y <= r.y + r.h));
  function SDL_RectEmptyFloat (r : access constant SDL_FRect) return Interfaces.C.C_bool is
    (Interfaces.C.C_bool (r = null or else r.w < 0.0 or else r.h < 0.0));
  function SDL_RectsEqualEpsilon (a, b : access constant SDL_FRect; epsilon : Interfaces.C.C_float) return Interfaces.C.C_bool is
    (Interfaces.C.C_bool (a /= null and then b /= null
                          and then (a.all'Address = b.all'Address
                                    or else (abs (a.x - b.x) <= epsilon and then abs (a.y - b.y) <= epsilon
                                             and then abs (a.w - b.w) <= epsilon and then abs (a.h - b.h) <= epsilon))));
  function SDL_RectsEqualFloat (a, b : access constant SDL_FRect) return Interfaces.C.C_bool is
    (SDL_RectsEqualEpsilon (a, b, SDL_FLT_EPSILON));
  function SDL_MostSignificantBitIndex32 (x : Uint32) return Interfaces.C.int;
  function SDL_HasExactlyOneBitSet32 (x : Uint32) return Interfaces.C.C_bool is
    (Interfaces.C.C_bool (x /= 0 and then (x and (x - 1)) = 0));
  function SDL_size_mul_check_overflow (a, b : Interfaces.C.size_t; ret : access Interfaces.C.size_t) return Interfaces.C.C_bool;
  function SDL_size_add_check_overflow (a, b : Interfaces.C.size_t; ret : access Interfaces.C.size_t) return Interfaces.C.C_bool;
end SDL;

package body SDL is
  function SDL_SwapFloat (x : Interfaces.C.C_float) return Interfaces.C.C_float is
    function To_Bits is new Unchecked_Conversion (Interfaces.C.C_float, Uint32);
    function To_Float is new Unchecked_Conversion (Uint32, Interfaces.C.C_float);
  begin
    return To_Float (SDL_Swap32 (To_Bits (x)));
  end SDL_SwapFloat;
  procedure SDL_RectToFRect (rect : access constant SDL_Rect; frect : access SDL_FRect) is
  begin
    frect.x := Interfaces.C.C_float (rect.x);
    frect.y := Interfaces.C.C_float (rect.y);
    frect.w := Interfaces.C.C_float (rect.w);
    frect.h := Interfaces.C.C_float (rect.h);
  end SDL_RectToFRect;
  function SDL_MostSignificantBitIndex32 (x : Uint32) return Interfaces.C.int is
    Value : Uint32 := x;
    Index : Interfaces.C.int := -1;
  begin
    while Value /= 0 loop
      Value := Value / 2;
      Index := Index + 1;
    end loop;
    return Index;
  end SDL_MostSignificantBitIndex32;
  function SDL_size_mul_check_overflow (a, b : Interfaces.C.size_t; ret : access Interfaces.C.size_t) return Interfaces.C.C_bool is
  begin
    if a /= 0 and then b > Interfaces.C.size_t'Last / a then
      return Interfaces.C.False;
    end if;
    ret.all := a * b;
    return Interfaces.C.True;
  end SDL_size_mul_check_overflow;
  function SDL_size_add_check_overflow (a, b : Interfaces.C.size_t; ret : access Interfaces.C.size_t) return Interfaces.C.C_bool is
  begin
    if b > Interfaces.C.size_t'Last - a then
      return Interfaces.C.False;
    end if;
    ret.all := a + b;
    return Interfaces.C.True;
  end SDL_size_add_check_overflow;
end SDL;

with Interfaces, Interfaces.C, Interfaces.C.Strings, System;
with Unchecked_Conversion;
package DirectX is
  use type Interfaces.C.int, Interfaces.C.unsigned;
  subtype BYTE is Interfaces.Unsigned_8;
  subtype UINT8 is Interfaces.Unsigned_8;
  subtype INT8 is Interfaces.Integer_8;
  subtype CHAR is Interfaces.C.char;
  subtype USHORT is Interfaces.Unsigned_16;
  subtype WORD is Interfaces.Unsigned_16;
  subtype UINT16 is Interfaces.Unsigned_16;
  subtype SHORT is Interfaces.Integer_16;
  subtype INT16 is Interfaces.Integer_16;
  subtype WCHAR is Interfaces.Unsigned_16;
  subtype UINT is Interfaces.C.unsigned;
  subtype UINT32 is Interfaces.C.unsigned;
  subtype DWORD is Interfaces.C.unsigned;
  subtype ULONG is Interfaces.C.unsigned;
  subtype INT is Interfaces.C.int;
  subtype INT32 is Interfaces.C.int;
  subtype LONG is Interfaces.C.int;
  subtype BOOL is Interfaces.C.int;
  subtype HRESULT is Interfaces.C.int;
  subtype UINT64 is Interfaces.Unsigned_64;
  subtype ULONGLONG is Interfaces.Unsigned_64;
  subtype INT64 is Interfaces.Integer_64;
  subtype LONGLONG is Interfaces.Integer_64;
  subtype LARGE_INTEGER is Interfaces.Integer_64;
  subtype SIZE_T is Interfaces.C.size_t;
  subtype UINT_PTR is Interfaces.C.size_t;
  subtype ULONG_PTR is Interfaces.C.size_t;
  subtype LONG_PTR is Interfaces.Integer_64;
  subtype FLOAT is Interfaces.C.C_float;
  subtype DOUBLE is Interfaces.C.double;
  subtype HANDLE is System.Address;
  subtype HWND is System.Address;
  subtype HMONITOR is System.Address;
  subtype HDC is System.Address;
  subtype HMODULE is System.Address;
  subtype HINSTANCE is System.Address;
  subtype LPVOID is System.Address;
  subtype LPCVOID is System.Address;
  subtype LPCWSTR is System.Address;
  subtype LPWSTR is System.Address;
  subtype LPCSTR is Interfaces.C.Strings.chars_ptr;
  subtype LPSTR is Interfaces.C.Strings.chars_ptr;
  type Ptr_BYTE is access all BYTE with Convention => C;
  type Ptr_UINT is access all UINT with Convention => C;
  type Ptr_INT is access all INT with Convention => C;
  type BYTE_Array is array (Natural range <>) of aliased BYTE with Convention => C;
  type FLOAT_Array is array (Natural range <>) of aliased FLOAT with Convention => C;
  type UINT_Array is array (Natural range <>) of aliased UINT with Convention => C;
  type UINT16_Array is array (Natural range <>) of aliased UINT16 with Convention => C;
  type UINT64_Array is array (Natural range <>) of aliased UINT64 with Convention => C;
  type WCHAR_Array is array (Natural range <>) of aliased WCHAR with Convention => C;
  type GUID is record
    Data1 : ULONG := 0;
    Data2 : USHORT := 0;
    Data3 : USHORT := 0;
    Data4 : BYTE_Array (0 .. 7) := (others => 0);
  end record;
  pragma Convention (C_Pass_By_Copy, GUID);
  subtype IID is GUID;
  subtype CLSID is GUID;
  subtype UUID is GUID;
  type Ptr_GUID is access all GUID with Convention => C;
  type REFIID is access constant GUID with Convention => C;
  subtype REFGUID is REFIID;
  subtype REFCLSID is REFIID;
  type LUID is record
    LowPart : DWORD := 0;
    HighPart : LONG := 0;
  end record;
  pragma Convention (C_Pass_By_Copy, LUID);
  type Ptr_LUID is access all LUID with Convention => C;
  type RECT is record
    left : LONG := 0;
    top : LONG := 0;
    right : LONG := 0;
    bottom : LONG := 0;
