with Interfaces, Interfaces.C, Interfaces.C.Strings, System, Unchecked_Conversion;
use Interfaces.C, Interfaces.C.Strings;
package Opus is
  pragma Dynamic_Library ("libopus.so.0", "libopus.so", "opus.dll", "libopus-0.dll", "libopus.0.dylib", "libopus.dylib");
  subtype opus_int              is int;
  subtype opus_uint             is unsigned;
  subtype opus_int8             is Interfaces.Integer_8;
  subtype opus_uint8            is Interfaces.Unsigned_8;
  subtype opus_int16            is Interfaces.Integer_16;
  subtype opus_uint16           is Interfaces.Unsigned_16;
  subtype opus_int32            is Interfaces.Integer_32;
  subtype opus_uint32           is Interfaces.Unsigned_32;
  subtype opus_int64            is Interfaces.Integer_64;
  subtype opus_uint64           is Interfaces.Unsigned_64;
  subtype OpusEncoder           is System.Address;
  subtype OpusDecoder           is System.Address;
  subtype OpusDREDDecoder       is System.Address;
  subtype OpusDRED              is System.Address;
  subtype OpusRepacketizer      is System.Address;
  subtype OpusMSEncoder         is System.Address;
  subtype OpusMSDecoder         is System.Address;
  subtype OpusProjectionEncoder is System.Address;
  subtype OpusProjectionDecoder is System.Address;
  OPUS_OK               : constant := 0;
  OPUS_BAD_ARG          : constant := -1;
  OPUS_BUFFER_TOO_SMALL : constant := -2;
  OPUS_INTERNAL_ERROR   : constant := -3;
  OPUS_INVALID_PACKET   : constant := -4;
  OPUS_UNIMPLEMENTED    : constant := -5;
  OPUS_INVALID_STATE    : constant := -6;
  OPUS_ALLOC_FAIL       : constant := -7;
  OPUS_SET_APPLICATION_REQUEST                     : constant := 4000;
  OPUS_GET_APPLICATION_REQUEST                     : constant := 4001;
