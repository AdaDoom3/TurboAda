  VK_ATTACHMENT_LOAD_OP_DONT_CARE : constant := 2;
  subtype VkAttachmentStoreOp is int;
  VK_ATTACHMENT_STORE_OP_STORE     : constant := 0;
  VK_ATTACHMENT_STORE_OP_DONT_CARE : constant := 1;
  VK_ATTACHMENT_STORE_OP_NONE      : constant := 1000301000;
  VK_ATTACHMENT_STORE_OP_NONE_KHR  : constant := VK_ATTACHMENT_STORE_OP_NONE;
  subtype VkBlendFactor is int;
  VK_BLEND_FACTOR_ZERO                     : constant := 0;
  VK_BLEND_FACTOR_ONE                      : constant := 1;
  VK_BLEND_FACTOR_SRC_COLOR                : constant := 2;
  VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR      : constant := 3;
  VK_BLEND_FACTOR_DST_COLOR                : constant := 4;
  VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR      : constant := 5;
  VK_BLEND_FACTOR_SRC_ALPHA                : constant := 6;
  VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA      : constant := 7;
  VK_BLEND_FACTOR_DST_ALPHA                : constant := 8;
  VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA      : constant := 9;
  VK_BLEND_FACTOR_CONSTANT_COLOR           : constant := 10;
  VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR : constant := 11;
  VK_BLEND_FACTOR_CONSTANT_ALPHA           : constant := 12;
  VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA : constant := 13;
  VK_BLEND_FACTOR_SRC_ALPHA_SATURATE       : constant := 14;
  VK_BLEND_FACTOR_SRC1_COLOR               : constant := 15;
  VK_BLEND_FACTOR_ONE_MINUS_SRC1_COLOR     : constant := 16;
  VK_BLEND_FACTOR_SRC1_ALPHA               : constant := 17;
  VK_BLEND_FACTOR_ONE_MINUS_SRC1_ALPHA     : constant := 18;
  subtype VkBlendOp is int;
  VK_BLEND_OP_ADD              : constant := 0;
  VK_BLEND_OP_SUBTRACT         : constant := 1;
  VK_BLEND_OP_REVERSE_SUBTRACT : constant := 2;
  VK_BLEND_OP_MIN              : constant := 3;
  VK_BLEND_OP_MAX              : constant := 4;
  subtype VkBorderColor is int;
  VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK : constant := 0;
  VK_BORDER_COLOR_INT_TRANSPARENT_BLACK   : constant := 1;
  VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK      : constant := 2;
  VK_BORDER_COLOR_INT_OPAQUE_BLACK        : constant := 3;
  VK_BORDER_COLOR_FLOAT_OPAQUE_WHITE      : constant := 4;
  VK_BORDER_COLOR_INT_OPAQUE_WHITE        : constant := 5;
  subtype VkFramebufferCreateFlagBits is VkFlags;
  VK_FRAMEBUFFER_CREATE_IMAGELESS_BIT : constant := 16#0000_0001#;
  subtype VkQueryPoolCreateFlagBits is VkFlags;
