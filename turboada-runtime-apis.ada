  function Is_ARM64 return Boolean is
    Encoding : Interfaces.C.Strings.chars_ptr;
  begin
    if Architecture = 0 then
      Architecture := 1;
      Encoding := method_getTypeEncoding (class_getInstanceMethod (objc_getClass ("NSObject"), sel_registerName ("isProxy")));
      if Encoding /= Interfaces.C.Strings.Null_Ptr then
        declare
          Text : constant String := Interfaces.C.Strings.Value (Encoding);
        begin
          if Text'Length > 0 and then Text (Text'First) = 'B' then
            Architecture := 2;
          end if;
        end;
      end if;
    end if;
    return Architecture = 2;
  end Is_ARM64;
