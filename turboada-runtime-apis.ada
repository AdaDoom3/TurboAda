  pragma Import (C, inflate, "inflate");
  function inflateEnd (strm : access z_stream) return int;
  pragma Import (C, inflateEnd, "inflateEnd");
  function deflateSetDictionary (strm : access z_stream; dictionary : System.Address; dictLength : uInt) return int;
  pragma Import (C, deflateSetDictionary, "deflateSetDictionary");
  function deflateGetDictionary (strm : access z_stream; dictionary : System.Address; dictLength : access uInt) return int;
  pragma Import (C, deflateGetDictionary, "deflateGetDictionary");
  function deflateCopy (dest : access z_stream; source : access z_stream) return int;
  pragma Import (C, deflateCopy, "deflateCopy");
  function deflateReset (strm : access z_stream) return int;
  pragma Import (C, deflateReset, "deflateReset");
  function deflateParams (strm : access z_stream; level : int; strategy : int) return int;
  pragma Import (C, deflateParams, "deflateParams");
  function deflateTune (strm : access z_stream; good_length : int; max_lazy : int; nice_length : int; max_chain : int) return int;
  pragma Import (C, deflateTune, "deflateTune");
  function deflateBound (strm : access z_stream; sourceLen : uLong) return uLong;
  pragma Import (C, deflateBound, "deflateBound");
  function deflateBound_z (strm : access z_stream; sourceLen : z_size_t) return z_size_t;
  pragma Import (C, deflateBound_z, "deflateBound_z");
  function deflatePending (strm : access z_stream; pending : access unsigned; bits : access int) return int;
  pragma Import (C, deflatePending, "deflatePending");
  function deflateUsed (strm : access z_stream; bits : access int) return int;
  pragma Import (C, deflateUsed, "deflateUsed");
  function deflatePrime (strm : access z_stream; bits : int; value : int) return int;
  pragma Import (C, deflatePrime, "deflatePrime");
  function deflateSetHeader (strm : access z_stream; head : access gz_header) return int;
  pragma Import (C, deflateSetHeader, "deflateSetHeader");
  function inflateSetDictionary (strm : access z_stream; dictionary : System.Address; dictLength : uInt) return int;
  pragma Import (C, inflateSetDictionary, "inflateSetDictionary");
  function inflateGetDictionary (strm : access z_stream; dictionary : System.Address; dictLength : access uInt) return int;
  pragma Import (C, inflateGetDictionary, "inflateGetDictionary");
  function inflateSync (strm : access z_stream) return int;
  pragma Import (C, inflateSync, "inflateSync");
  function inflateCopy (dest : access z_stream; source : access z_stream) return int;
  pragma Import (C, inflateCopy, "inflateCopy");
  function inflateReset (strm : access z_stream) return int;
  pragma Import (C, inflateReset, "inflateReset");
  function inflateReset2 (strm : access z_stream; windowBits : int) return int;
  pragma Import (C, inflateReset2, "inflateReset2");
  function inflatePrime (strm : access z_stream; bits : int; value : int) return int;
  pragma Import (C, inflatePrime, "inflatePrime");
  function inflateMark (strm : access z_stream) return long;
  pragma Import (C, inflateMark, "inflateMark");
  function inflateGetHeader (strm : access z_stream; head : access gz_header) return int;
  pragma Import (C, inflateGetHeader, "inflateGetHeader");
  function inflateBack (strm      : access z_stream;
                        in_Param  : in_func;
                        in_desc   : System.Address;
                        out_Param : out_func;
                        out_desc  : System.Address) return int;
  pragma Import (C, inflateBack, "inflateBack");
  function inflateBackEnd (strm : access z_stream) return int;
  pragma Import (C, inflateBackEnd, "inflateBackEnd");
  function zlibCompileFlags return uLong;
  pragma Import (C, zlibCompileFlags, "zlibCompileFlags");
  function compress (dest : System.Address; destLen : access uLongf; source : System.Address; sourceLen : uLong) return int;
  pragma Import (C, compress, "compress");
  function compress_z (dest : System.Address; destLen : access z_size_t; source : System.Address; sourceLen : z_size_t) return int;
  pragma Import (C, compress_z, "compress_z");
  function compress2 (dest : System.Address; destLen : access uLongf; source : System.Address; sourceLen : uLong; level : int) return int;
  pragma Import (C, compress2, "compress2");
  function compress2_z (dest      : System.Address;
