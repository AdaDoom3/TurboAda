  subtype VkSamplerCreateFlagBits is VkFlags;
  subtype VkPipelineCacheHeaderVersion is int;
  VK_PIPELINE_CACHE_HEADER_VERSION_ONE : constant := 1;
  subtype VkPipelineCacheCreateFlagBits is VkFlags;
  VK_PIPELINE_CACHE_CREATE_EXTERNALLY_SYNCHRONIZED_BIT : constant := 16#0000_0001#;
  subtype VkPipelineShaderStageCreateFlagBits is VkFlags;
  VK_PIPELINE_SHADER_STAGE_CREATE_ALLOW_VARYING_SUBGROUP_SIZE_BIT : constant := 16#0000_0001#;
