  function D3D11_ENCODE_BASIC_FILTER (min, mag, mip, reduction_mode : INT) return D3D11_FILTER is
    ((min mod 4) * 2**4 + (mag mod 4) * 2**2 + (mip mod 4) + (reduction_mode mod 4) * 2**7);
  function D3D11_ENCODE_ANISOTROPIC_FILTER (reduction_mode : INT) return D3D11_FILTER is
    (16#40# + D3D11_ENCODE_BASIC_FILTER (1, 1, 1, reduction_mode));
  function D3D11_DECODE_MIN_FILTER (d3d11Filter : D3D11_FILTER) return D3D11_FILTER_TYPE is ((d3d11Filter / 2**4) mod 4);
  function D3D11_DECODE_MAG_FILTER (d3d11Filter : D3D11_FILTER) return D3D11_FILTER_TYPE is ((d3d11Filter / 2**2) mod 4);
  function D3D11_DECODE_MIP_FILTER (d3d11Filter : D3D11_FILTER) return D3D11_FILTER_TYPE is (d3d11Filter mod 4);
  function D3D11_DECODE_FILTER_REDUCTION (filter : D3D11_FILTER) return D3D11_FILTER_REDUCTION_TYPE is ((filter / 2**7) mod 4);
