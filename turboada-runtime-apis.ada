package body Opus is
  function To_Slot is new Unchecked_Conversion (opus_int64, System.Address);
  function Slot (x : opus_int32) return System.Address is (To_Slot (opus_int64 (x)));
  function Int_Pointer_Slot (x : access opus_int32) return System.Address is
    (if x = null then System.Null_Address else x.all'Address);
  function UInt_Pointer_Slot (x : access opus_uint32) return System.Address is
    (if x = null then System.Null_Address else x.all'Address);
  function Handle_Pointer_Slot (x : access System.Address) return System.Address is
    (if x = null then System.Null_Address else x.all'Address);
  function OPUS_SET_APPLICATION (x : opus_int32) return opus_ctl_arguments is
    (opus_ctl_arguments'(OPUS_SET_APPLICATION_REQUEST, Slot (x), Slot (x)));
  function OPUS_SET_BITRATE (x : opus_int32) return opus_ctl_arguments is
    (opus_ctl_arguments'(OPUS_SET_BITRATE_REQUEST, Slot (x), Slot (x)));
  function OPUS_SET_MAX_BANDWIDTH (x : opus_int32) return opus_ctl_arguments is
    (opus_ctl_arguments'(OPUS_SET_MAX_BANDWIDTH_REQUEST, Slot (x), Slot (x)));
