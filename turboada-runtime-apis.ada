  pragma Import (C, uncompress2, "uncompress2");
  function uncompress2_z (dest : System.Address; destLen : access z_size_t; source : System.Address; sourceLen : access z_size_t) return int;
  pragma Import (C, uncompress2_z, "uncompress2_z");
